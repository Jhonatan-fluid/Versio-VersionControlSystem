# ---------------------------------------------------------------------------
# Line endings
# ---------------------------------------------------------------------------
# Normalise to LF in the repository. The exporter writes LF and hashes LF, so a
# checkout that rewrote endings would make every file look modified.
* text=auto eol=lf

*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

*.cs    text diff=csharp
*.py    text
*.md    text
*.json  text
*.yaml  text
*.yml   text

# Exported CODESYS source. LF, UTF-8, always diffable - this is the whole point
# of the tool.
*.st    text
*.xml   text

# ---------------------------------------------------------------------------
# CODESYS binaries
# ---------------------------------------------------------------------------
# A .project is a binary compound document. Marking it -diff -merge stops git
# attempting a text diff or an automatic merge on something it cannot reason
# about; the readable diff lives in the exported tree beside it.
*.project        binary -diff -merge filter=lfs diff=lfs
*.library        binary -diff -merge filter=lfs diff=lfs
*.projectarchive binary -diff -merge filter=lfs diff=lfs
*.compiled-library binary -diff -merge filter=lfs diff=lfs

# ---------------------------------------------------------------------------
# Vendored dependencies (see docs/PLAN.md section 13.3)
# ---------------------------------------------------------------------------
third_party/**/*.nupkg   filter=lfs diff=lfs -merge -text
third_party/**/*.7z.exe  filter=lfs diff=lfs -merge -text
third_party/**/*.zip     filter=lfs diff=lfs -merge -text

# Added by Versio: the mirror is text, and must arrive byte-identical everywhere.
# Without eol=lf a core.autocrlf=true clone lands CRLF, which git calls clean and
# Versio's hash gate calls an edit to every file in it.
fixtures/projects/RefrigeratorControl/** text eol=lf

# ---------------------------------------------------------------------------
# TIA Portal binaries
# ---------------------------------------------------------------------------
# A TIA project is a directory: the .apXX is a ~150 KB pointer and the program
# lives in System/*.plf. Marking the payload -diff -merge stops git attempting
# a text merge on something it cannot reason about; the readable diff lives in
# the Versio mirror beside the pointer
# (fixtures/projects/CleaningStation_V20_V21/CleaningStation_V20_V21/).
#
# No merge=lfs anywhere in this file - the rule GitAttributesPlan states and tests.
# git-lfs installs no merge driver by that name, so merge=lfs overrides -merge and
# git falls back to a text merge of the LFS pointer. `git check-attr merge` answered
# "lfs" on the fixture's .ap21 and System/PEData.plf until 2026-09-14.
*.ap17           binary -diff -merge filter=lfs diff=lfs
*.ap18           binary -diff -merge filter=lfs diff=lfs
*.ap19           binary -diff -merge filter=lfs diff=lfs
*.ap20           binary -diff -merge filter=lfs diff=lfs
*.ap21           binary -diff -merge filter=lfs diff=lfs
*.al17           binary -diff -merge filter=lfs diff=lfs
*.al18           binary -diff -merge filter=lfs diff=lfs
*.al19           binary -diff -merge filter=lfs diff=lfs
*.al20           binary -diff -merge filter=lfs diff=lfs
*.al21           binary -diff -merge filter=lfs diff=lfs
*.plf            binary -diff -merge filter=lfs diff=lfs
*.idx            binary -diff -merge filter=lfs diff=lfs

# Other Siemens binary leftovers inside a working tree. Path-scoped so a random
# .zip elsewhere is not forced through LFS.
fixtures/projects/CleaningStation_V20_V21/** filter=lfs diff=lfs -merge -text
# The two text exceptions undo the line above with !diff !merge - back to git's
# default - and NOT -diff -merge. -diff means "binary for diffing": with it every
# mirror file printed "Binary files differ", so the reviewable export could not be
# reviewed through git at all until 2026-09-14.
fixtures/projects/CleaningStation_V20_V21/ProjectInfo.txt text eol=lf -filter !diff !merge
fixtures/projects/CleaningStation_V20_V21/CleaningStation_V20_V21/** -filter !diff !merge text eol=lf

# Portal's program store, folder by folder - the rules adoption now writes for every
# TIA project (TiaPortalProjectFormat.BinaryPayloadPatternsFor). The folder rule above
# already covers them here; they are written out so opening Versio on this repository
# finds them present and leaves the file alone, rather than appending a surprise diff.
fixtures/projects/CleaningStation_V20_V21/System/**          binary -diff -merge filter=lfs diff=lfs
fixtures/projects/CleaningStation_V20_V21/IM/**              binary -diff -merge filter=lfs diff=lfs
fixtures/projects/CleaningStation_V20_V21/XRef/**            binary -diff -merge filter=lfs diff=lfs
fixtures/projects/CleaningStation_V20_V21/AdditionalFiles/** binary -diff -merge filter=lfs diff=lfs
fixtures/projects/CleaningStation_V20_V21/UserFiles/**       binary -diff -merge filter=lfs diff=lfs

