# TIA Portal occupancy and churn beside the committed gate fixture.
# Logs/ tmp/ Vci/ are not copied into the fixture; these rules catch them if
# a test or the IDE recreates them. .info is OccupancyMarkerFor; System/~* is
# the PEData lock sibling measured while Openness holds the project.
fixtures/projects/CleaningStation_V20_V21/Logs/
fixtures/projects/CleaningStation_V20_V21/tmp/
fixtures/projects/CleaningStation_V20_V21/Vci/
fixtures/projects/CleaningStation_V20_V21/*.info
fixtures/projects/CleaningStation_V20_V21/System/~*

# TwinCAT occupancy and churn beside the committed gate fixture.
# _Boot/ _CompileInfo/ .vs/ are not copied into the fixture; these rules catch them
# if a test or XAE recreates them. Occupancy is stem.~u, rewritten via stem.~u~
# (measured 2026-08-21, live TcXaeShell) — same two-file hop as CODESYS, so .~u*.
fixtures/projects/TC3_PlcSample_reStrText/_Boot/
fixtures/projects/TC3_PlcSample_reStrText/_CompileInfo/
fixtures/projects/TC3_PlcSample_reStrText/.vs/
fixtures/projects/TC3_PlcSample_reStrText/*.~u*
fixtures/projects/TC3_PlcSample_reStrText/*.suo
fixtures/projects/TC3_PlcSample_reStrText/*.user

