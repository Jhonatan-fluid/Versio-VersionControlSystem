<Window x:Class="Versio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Versio" Height="820" Width="1360"
        Background="{DynamicResource Brush.Surface.Sunken}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ToolButton" TargetType="Button">
                <Setter Property="Padding" Value="{DynamicResource Pad.Control}" />
                <Setter Property="MinHeight" Value="{DynamicResource Size.Control.Height}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Base}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
                <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource Brush.Surface.Hover}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
                <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
                <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Semibold}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- ============================ TOP BAR ============================ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Brush.Surface.Base}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Versio" VerticalAlignment="Center" Margin="0,0,16,0"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Subtitle}"
                           FontWeight="{DynamicResource Font.Weight.Semibold}"
                           Foreground="{DynamicResource Brush.Accent.Default}" />

                <Border Background="{DynamicResource Brush.Surface.Sunken}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,4" MinWidth="260" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RepositoryName}"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource Font.Size.Body}"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <Button x:Name="OpenButton" Content="Open…" Style="{StaticResource ToolButton}"
                        Margin="8,0,0,0" MinWidth="80" Click="OnOpenRepository" />

                <Border Width="1" Background="{DynamicResource Brush.Border.Subtle}"
                        Margin="14,2" />

                <TextBlock Text="⑂" VerticalAlignment="Center" Margin="0,0,6,0"
                           FontSize="15"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                <TextBlock Text="{Binding BranchName}" VerticalAlignment="Center"
                           FontFamily="{DynamicResource Font.Mono}"
                           FontSize="{DynamicResource Font.Size.Body}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding AheadBehind}" VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontFamily="{DynamicResource Font.Mono}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Accent.Default}" />

                <Button Content="⟳" Style="{StaticResource ToolButton}"
                        Margin="14,0,0,0" MinWidth="36"
                        Command="{Binding RefreshCommand}" ToolTip="Refresh status" />

                <Button Content="◐" Style="{StaticResource ToolButton}"
                        Margin="8,0,0,0" MinWidth="36"
                        Click="OnToggleTheme" ToolTip="Toggle light / dark" />
            </StackPanel>
        </Border>

        <!-- =========================== STATUS BAR =========================== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Brush.Surface.Base}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Status.Neutral}" />
                <TextBlock Text="{Binding StatusSummary}" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                <TextBlock x:Name="PathText" Margin="18,0,0,0" VerticalAlignment="Center"
                           FontFamily="{DynamicResource Font.Mono}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Text.Disabled}"
                           Text="{Binding RepositoryPath}" />
            </StackPanel>
        </Border>

        <!-- ========================== LOG CONSOLE ========================== -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="10,5"
                        Background="{DynamicResource Brush.Surface.Base}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▾ LOG" Style="{StaticResource ToolButton}"
                                BorderThickness="0" Background="Transparent"
                                Command="{Binding Log.ToggleExpandedCommand}" />
                        <TextBox x:Name="LogFilterBox" Width="220" Margin="10,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource Brush.Surface.Sunken}"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                 FontFamily="{DynamicResource Font.UI}"
                                 FontSize="{DynamicResource Font.Size.Caption}"
                                 Text="{Binding Log.Filter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter by message or category" />
                        <Button Content="⏸" Style="{StaticResource ToolButton}" MinWidth="34"
                                Margin="8,0,0,0" Command="{Binding Log.TogglePauseCommand}"
                                ToolTip="Pause auto-scroll" />
                        <Button Content="🗑" Style="{StaticResource ToolButton}" MinWidth="34"
                                Margin="6,0,0,0" Command="{Binding Log.ClearCommand}"
                                ToolTip="Clear the view (the file keeps everything)" />
                    </StackPanel>
                </Border>

                <!-- Virtualized: a 5,000-entry log must still scroll at 60 fps. -->
                <ListBox x:Name="LogList" Height="190"
                         ItemsSource="{Binding Log.Rows}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Height" Value="{DynamicResource Size.Row.Log}" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time}" Width="86" Margin="8,0,0,0"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Disabled}" />
                                <TextBlock Text="{Binding Level}" Width="34"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Status.Neutral}" />
                                <TextBlock Text="{Binding Category}" Width="72"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Accent.Default}" />
                                <TextBlock Text="{Binding Message}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================== RAIL ============================== -->
        <Border DockPanel.Dock="Left"
                Width="{DynamicResource Size.Rail.Width}"
                Background="{DynamicResource Brush.Surface.Base}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="5,10,5,0" HorizontalAlignment="Center">
                <Button Content="📄" Style="{StaticResource RailButton}" ToolTip="Changed files" />
                <Button Content="🔀" Style="{StaticResource RailButton}" ToolTip="Git" />
                <Button Content="🔄" Style="{StaticResource RailButton}" ToolTip="Sync / CODESYS" />
                <Button Content="⚙" Style="{StaticResource RailButton}" ToolTip="Settings" />
            </StackPanel>
        </Border>

        <!-- ========================== SPLIT VIEW =========================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="{DynamicResource Brush.Surface.Base}">
                <Border DockPanel.Dock="Top" Padding="12,10,12,8">
                    <TextBlock Style="{StaticResource Caption}" Text="CHANGED FILES" />
                </Border>

                <ListBox ItemsSource="{Binding Changes}"
                         SelectedItem="{Binding SelectedChange}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="{DynamicResource Size.Row.Tree}" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Glyph}" Width="18"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           FontWeight="{DynamicResource Font.Weight.Semibold}"
                                           Foreground="{DynamicResource Brush.Status.Modified}" />
                                <TextBlock Text="{Binding Path}" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Disabled}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Brush.Border.Subtle}" />

            <DockPanel Grid.Column="2" Background="{DynamicResource Brush.Surface.Base}">
                <Border DockPanel.Dock="Top" Padding="12,10,12,8">
                    <TextBlock Style="{StaticResource Caption}" Text="DIFF" />
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding SelectedDiff, Mode=OneWay}"
                             IsReadOnly="True" BorderThickness="0"
                             Background="Transparent"
                             Padding="12,0,12,12"
                             FontFamily="{DynamicResource Font.Mono}"
                             FontSize="{DynamicResource Font.Size.Code}"
                             Foreground="{DynamicResource Brush.Text.Primary}" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
