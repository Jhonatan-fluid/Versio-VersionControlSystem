<Window x:Class="Versio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Versio.App.Views"
        xmlns:vm="clr-namespace:Versio.App.ViewModels"
        Title="Versio" Height="840" Width="1420" WindowState="Maximized"
        Background="{DynamicResource Brush.Surface.Sunken}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <!-- NO Theme.xaml merge here, deliberately. App.xaml merges it once into
         Application.Resources, and ThemeManager swaps the palette inside THAT dictionary.
         A second copy here gave this window its own private palette: lookups found it first
         and never reached the application's, so the theme buttons in Settings changed
         nothing on the main window while every dialog — which has no private copy — followed
         them correctly. One theme, one place, swapped once. -->
    <Window.Resources>
        <ResourceDictionary>

            <!-- Neither BoolToVisibility nor ResourceKey is declared here any more. Both
                 moved to the stylesheet
                 so every window gets the one instance: this private copy is why
                 SystemInfoWindow, which uses the same key, threw on open. -->


            <!-- One row template for every list of changed files. Three copies of it would
                 be three chances for the glyph and its colour to disagree.

                 TWO LINES, AND THE NAME LEADS. This drew {Binding Path} on one line with
                 TextTrimming="CharacterEllipsis", which trims the TAIL - so in a 380 px panel
                 an exported PLC tree showed "Device/Plc Logic/Applic..." on every row and hid
                 the only part that differed. The filename was never on screen.

                 Now the first line is what distinguishes one row from the next - the OBJECT's
                 name where Versio knows it (FB_Motor, not FB_Motor.st) with its type beside
                 it - and the directory drops to a secondary line where eliding it costs
                 nothing. The tooltip still carries the whole path, because that is what git
                 will commit and somebody will want to copy it. -->
            <DataTemplate x:Key="ChangeRowTemplate">
                <Grid ToolTip="{Binding Path}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                               VerticalAlignment="Top" Margin="0,1,0,0"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               FontWeight="{DynamicResource Font.Weight.Semibold}"
                               Foreground="{Binding BrushKey,
                                   Converter={StaticResource ResourceKey}}" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Primary}"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- The type, and the fact that an edit here goes nowhere. Both
                                 collapse for an ordinary file rather than rendering empty:
                                 a blank chip is a control that looks broken. -->
                            <Border Margin="6,0,0,0" Padding="4,0" CornerRadius="2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Surface.Raised}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    Visibility="{Binding IsObject,
                                        Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding TypeLabel}"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </Border>

                            <TextBlock Text="&#xE72E;" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource Font.Icon}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       ToolTip="Exported for review only. Editing this file does not change the project - the next export rewrites it."
                                       Visibility="{Binding IsExportOnly,
                                           Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Secondary}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!--
                Staging rows: a checkbox, then the shared body.

                DECLARED AFTER ChangeRowTemplate, AND THAT IS NOT COSMETIC. A StaticResource
                resolves in declaration order, so with this above the template it references,
                every realised row threw:

                    XamlParseException: Cannot find resource named 'ChangeRowTemplate'

                Nothing catches that until a row exists. The window builds, the panel lays out,
                the suite passes - and the application dies the moment somebody clicks the Git
                rail on a repository with a changed file. Moving this below fixes it; the
                alternative is DynamicResource, which costs a lookup per row for a resource
                that never changes.

                A separate template from ChangeRowTemplate because that one is also used by the
                history panel's commit-file list, where a checkbox is meaningless - a commit's
                files are not something you stage. The glyph and path live in one place still,
                so the two cannot drift apart on what a modified file looks like.

                The checkbox is NOT the list selection. Clicking the row opens its diff;
                ticking the box says what the next action applies to. Two jobs, two pieces of
                state - and a user who lost their diff every time they changed what they were
                about to stage would stop using one of the two.
            -->
            <DataTemplate x:Key="StageRowTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Style="{StaticResource MenuCheck}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}" />

                    <ContentPresenter Grid.Column="1" Content="{Binding}"
                                      ContentTemplate="{StaticResource ChangeRowTemplate}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!--
            Two columns, because the rail is app-level navigation and has to own the whole left
            edge.

            It used to live inside the body row, which meant it stopped at the bottom of the
            panels while the log console - a sibling row - ran the full width of the window
            underneath it. Two surfaces of the same colour meeting at a T-junction under the
            rail icons, which reads exactly like the log bar overlapping the sidebar, because
            visually that is what it is. The rail now spans the body and the log; the log
            starts where the content starts.
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />  <!-- rail    -->
            <ColumnDefinition Width="*" />     <!-- content -->
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- top bar   -->
            <RowDefinition Height="*" />      <!-- body      -->
            <RowDefinition Height="Auto" />   <!-- log       -->
            <RowDefinition Height="Auto" />   <!-- status    -->
        </Grid.RowDefinitions>

        <!-- ============================== TOP BAR ============================== -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Surface.Base}" Padding="10,8">
            <!--
                Two flexible columns, not one. Every column here used to be Auto except the
                one holding the branch buttons, so both dropdowns were pinned at 230 and 200 px
                and the whole bar crowded into the left 700 px of a 2560 px window while the
                slack piled up in the middle. The dropdowns take the slack now - bounded, so
                they grow into a wide window without becoming absurd - and the spacer before
                Settings is what keeps the right-hand cluster on the right.
            -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />   <!-- brand              -->
                    <ColumnDefinition Width="*" />      <!-- repository         -->
                    <ColumnDefinition Width="Auto" />   <!-- open, clone        -->
                    <ColumnDefinition Width="*" />      <!-- branch             -->
                    <ColumnDefinition Width="Auto" />   <!-- new branch, refresh-->
                    <ColumnDefinition Width="*" />      <!-- spacer             -->
                    <ColumnDefinition Width="Auto" />   <!-- settings           -->
                </Grid.ColumnDefinitions>

                <!-- The mark and the word together. The mark is the app's own icon geometry
                     (Theme/controls/Brand.xaml); the word is no longer accent-coloured,
                     because accent had been spent on nine different things at once and a
                     brand that is not clickable was the least useful of them. -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="4,0,16,0">
                    <ContentControl Template="{StaticResource BrandMark}"
                                    Width="20" Height="20" Focusable="False"
                                    IsTabStop="False" />
                    <TextBlock Text="Versio" VerticalAlignment="Center" Margin="8,0,0,0"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Subtitle}"
                               FontWeight="{DynamicResource Font.Weight.Semibold}"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>

                <!-- Repository dropdown.
                     The closed box shows the NAME only. The first pass also crammed the
                     full path in there, which made both dropdowns read as dense strings of
                     grey text. The path belongs in the open list, where there is room and
                     where it is actually needed - to tell two repos of the same name apart. -->
                <ComboBox Grid.Column="1" MinWidth="200" MaxWidth="420"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource FlatCombo}"
                          ItemContainerStyle="{StaticResource FlatComboItem}"
                          Tag="{DynamicResource Icon.Folder}"
                          ItemsSource="{Binding RecentRepositories}"
                          SelectedItem="{Binding SelectedRepository}"
                          IsEnabled="{Binding CanChangeContext}"
                          ToolTip="{Binding RepositoryPath}">
                    <!-- THE NAME IS NOT ENOUGH ON ITS OWN.

                         RepoEntry has carried a Location since it was written, with a comment
                         saying it is "shown beneath the name so two repos with the same folder
                         name are still distinguishable" - and nothing had ever bound it. The
                         same defect class as BranchEntry.Tracking: a comment describing a rule
                         that nothing enforced.

                         It went unnoticed because the list is usually short and the names
                         usually differ. Opening a handful of repositories that all happened to
                         live in a folder called "work" produced three identical rows with no
                         way to tell them apart, which is when it stopped being theoretical. -->
                    <!-- ON ONE LINE. The control is several hundred pixels wide and the two
                         values together are shorter than most branch names, so stacking them
                         doubled the height of the whole top bar to say what fits beside itself.

                         The first attempt did stack them, because RepoEntry.Location's comment
                         says "shown BENEATH the name" - written for a narrow list that never
                         shipped. Following the comment rather than looking at the control is
                         how a doc comment outlives the design it described. -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Body}"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />

                                <!-- Takes whatever is left, and trims only if it runs out.
                                     Quiet, because it is the tie-breaker rather than the
                                     label: two repositories called "work" differ here and
                                     nowhere else. -->
                                <TextBlock Grid.Column="1" Text="{Binding Location}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Disabled}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button Style="{StaticResource IconButton}"
                            Content="{DynamicResource Icon.Folder}"
                            Click="OnOpenRepository" ToolTip="Open a repository…" />

                    <!-- Clone. Beside Open because they answer the same question — "work on
                         which repository?" — and this is the answer when you do not have it
                         yet. Enabled without one open, unlike everything else in this bar. -->
                    <Button Style="{StaticResource IconButton}"
                            Content="{DynamicResource Icon.Download}"
                            Command="{Binding CloneCommand}"
                            ToolTip="Clone a repository…" />
                </StackPanel>

                <!-- Branch dropdown. Closed: name and divergence only. Upstream tracking is
                     only useful while comparing branches, so it lives in the open list.

                     IsEnabled follows CanChangeContext on both dropdowns: while an import is
                     writing into a project there is no safe answer to "switch now", so the
                     question is made unreachable rather than asked and refused. An export
                     leaves them live - there is a real choice worth offering during those
                     17-31 s, and the guard offers it. -->
                <ComboBox Grid.Column="3" MinWidth="180" MaxWidth="360" Margin="16,0,0,0"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource FlatCombo}"
                          ItemContainerStyle="{StaticResource FlatComboItem}"
                          Tag="{DynamicResource Icon.Link}"
                          ItemsSource="{Binding Branches}"
                          SelectedItem="{Binding SelectedBranch}"
                          IsEnabled="{Binding CanChangeContext}"
                          ToolTip="Switch branch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Body}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AheadBehind}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{Binding BrushKey,
                                               Converter={StaticResource ResourceKey}}" />

                                <!-- WHERE THE BRANCH ACTUALLY LIVES.

                                     "local" means nobody else can see the work on it;
                                     "remote" means it is not checked out here and choosing it
                                     will create the local branch. Blank for the ordinary case
                                     of a branch on both sides, because a label on every row is
                                     a label nobody reads.

                                     Remote-only branches were invisible until now - the list
                                     read refs/heads - so this column is also the first sign
                                     that they exist at all. -->
                                <TextBlock Text="{Binding Where}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Status.Modified}" />

                                <!-- Which upstream, or "no upstream". BranchEntry has computed
                                     this since it was written and nothing ever bound it, so a
                                     branch that existed only on this machine was
                                     indistinguishable in the list from one that was fully
                                     pushed. Same confusion the panel badge fixes, in the one
                                     place you choose which branch to work on. -->
                                <TextBlock Text="{Binding Tracking}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Disabled}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Create a branch. A button rather than an item at the bottom of the
                     dropdown: that list's selection means "switch to this", and a row that
                     meant something else would be one arrow-key away from a checkout. -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="4,0,0,0">
                    <Button Style="{StaticResource IconButton}"
                            Content="{DynamicResource Icon.Add}"
                            Command="{Binding CreateBranchCommand}"
                            ToolTip="Create a branch from HEAD and switch to it…" />

                    <Button Style="{StaticResource IconButton}"
                            Content="{DynamicResource Icon.Refresh}"
                            Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)" />
                </StackPanel>

                <!-- Settings: theme lives here now, not as a top-level button. -->
                <Button Grid.Column="6" x:Name="SettingsButton"
                        Style="{StaticResource IconButton}"
                        Content="{DynamicResource Icon.Settings}"
                        Click="OnOpenSettings" ToolTip="Settings" />
            </Grid>
        </Border>

        <!-- ========================= APP-WIDE PROGRESS =========================
             One bar for every kind of work: a git refresh, opening a repository, and a
             17-31 s CODESYS export all report through the same counted tracker. Indeterminate
             because none of them can honestly report a percentage - CODESYS gives no progress
             until it is finished, and a bar that invents one is worse than a bar that admits
             it does not know.

             Two pixels tall and inside the top bar's shadow, so an operation that takes 50 ms
             does not shove the whole window down and back on every keystroke. -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Panel.ZIndex="10"
              Visibility="{Binding Busy.IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="True" Height="2" BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource Brush.Accent.Default}" />
        </Grid>

        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom" HorizontalOffset="-190" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Card}" Padding="6" Width="230">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.24"
                                      Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}"
                               Margin="10,8,0,6" />
                    <RadioButton x:Name="ThemeSystem" Content="Follow system" GroupName="Theme"
                                 Margin="10,3" Foreground="{DynamicResource Brush.Text.Primary}"
                                 FontFamily="{DynamicResource Font.UI}"
                                 FontSize="{DynamicResource Font.Size.Body}"
                                 Checked="OnThemeChanged" Tag="System" />
                    <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme"
                                 Margin="10,3" Foreground="{DynamicResource Brush.Text.Primary}"
                                 FontFamily="{DynamicResource Font.UI}"
                                 FontSize="{DynamicResource Font.Size.Body}"
                                 Checked="OnThemeChanged" Tag="Light" />
                    <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme"
                                 Margin="10,3,10,8"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 FontFamily="{DynamicResource Font.UI}"
                                 FontSize="{DynamicResource Font.Size.Body}"
                                 Checked="OnThemeChanged" Tag="Dark" />

                    <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}"
                            Margin="6,4" />

                    <TextBlock Text="LOG" Style="{StaticResource SectionLabel}"
                               Margin="10,6,0,6" />
                    <CheckBox Content="Show log panel" Margin="10,3,10,8"
                              Foreground="{DynamicResource Brush.Text.Primary}"
                              FontFamily="{DynamicResource Font.UI}"
                              FontSize="{DynamicResource Font.Size.Body}"
                              IsChecked="{Binding Log.IsExpanded, Mode=TwoWay}" />

                    <!-- The log panel shows this session; the folder holds the last five
                         days. Troubleshooting a problem from yesterday needs the file, so
                         the way to reach it is a button rather than a path to memorise. -->
                    <Button Content="Open logs folder…" Margin="10,0,10,10"
                            HorizontalAlignment="Left"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding OpenLogsFolderCommand}"
                            ToolTip="Daily log files, kept for 5 days" />

                    <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}"
                            Margin="6,4" />

                    <!-- Which toolchains this machine has, which profiles they offer, what
                         version of everything is installed. Environment rather than state:
                         the same on every repository, and it changes when somebody installs
                         something, not while anybody is working. It used to sit at the top
                         of the project panel, where it took up the room the changed files
                         needed and looked like it was about the repository. -->
                    <TextBlock Text="HELP" Style="{StaticResource SectionLabel}"
                               Margin="10,6,0,6" />
                    <Button Content="System information…" Margin="10,0,10,10"
                            HorizontalAlignment="Left"
                            Style="{StaticResource GhostButton}"
                            Click="OnOpenSystemInfo"
                            ToolTip="Toolchains, versions and paths on this machine" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================================= RAIL =================================
             In the outer grid, spanning the body and the log, rather than inside the body row.
             It is app-level navigation: it should not stop halfway down the window and leave
             the log console running along underneath it. -->
        <Border x:Name="Rail" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
                Width="{DynamicResource Size.Rail.Width}"
                Background="{DynamicResource Brush.Surface.Base}">
            <StackPanel Margin="2,10,2,0">
                <RadioButton x:Name="RailProject" Style="{StaticResource RailButton}"
                             IsChecked="True" Tag="Project"
                             Content="{DynamicResource Icon.Document}"
                             Checked="OnRailChanged"
                             ToolTip="Project — the repository as CODESYS structures it, with every change marked" />
                <RadioButton x:Name="RailGit" Style="{StaticResource RailButton}"
                             Tag="Git"
                             Content="{DynamicResource Icon.Link}"
                             Checked="OnRailChanged"
                             ToolTip="Git — staging, commit, pull and push" />

                <!-- History is its own panel rather than a section of the git one. The
                     two answer different questions - what is about to happen, and what
                     already did - and sharing a column left history with 150 pixels of
                     it. It is also what makes the log affordable: a panel nobody has
                     opened reads nothing at all. -->
                <RadioButton x:Name="RailHistory" Style="{StaticResource RailButton}"
                             Tag="History"
                             Content="{DynamicResource Icon.History}"
                             Checked="OnRailChanged"
                             ToolTip="History — commits, the files in each, and their diffs" />
            </StackPanel>
        </Border>

        <!-- ================================ BODY ================================ -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Left panel. One card; the rail swaps its contents.
                 A Grid, not a DockPanel, and that is the whole fix for a panel that used
                 only half its own card: DockPanel.Dock DEFAULTS TO LEFT, and only the last
                 child fills. The three panels are listed git, history, project - so the
                 project panel filled the card and the other two were docked left at
                 whatever width their content happened to want, leaving 200-odd pixels of
                 dead card to the right of every row in them.
                 Both rows here are explicit, all three panels share row 1, and exactly one
                 of them is visible at a time. -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Base}"
                    Margin="8,8,0,8" CornerRadius="{DynamicResource Radius.Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- title -->
                        <RowDefinition Height="*" />      <!-- panel -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding PanelTitle}" />
                        <Border Grid.Column="1" Margin="8,0,0,0"
                                x:Name="ChangeCountBadge"
                                Background="{DynamicResource Brush.Accent.Muted}"
                                CornerRadius="9" Padding="8,1" MinWidth="22">
                            <TextBlock Text="{Binding Changes.Count}"
                                       HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Accent.Default}" />
                        </Border>
                    </Grid>

                    <!-- GIT: not built yet. An empty state that explains what will live
                         here beats a blank panel, which reads as a bug. -->
                    <!-- GIT: staging, the commit message, and the remote operations.
                         Every button here goes dead while any operation runs - see
                         ShellViewModel.Ready. Git serialises some of this itself with index
                         and ref locks, but not a push racing a commit, and not a commit
                         landing while the gate's export is still writing the mirror. -->
                    <Border Grid.Row="1" x:Name="GitPanel" Visibility="Collapsed" Padding="14,0,12,12">
                        <DockPanel>
                            <!-- GIT ITSELF IS MISSING.

                                 First, above everything, because nothing below it can work:
                                 every operation in this panel is git.exe resolved from PATH.
                                 A first-class state rather than a toast, because it does not
                                 go away and there is nothing else to look at.

                                 Bound to GitIsMissing, which is false until the launch probe
                                 has actually answered - GitPresence.Unknown is deliberately
                                 not Missing, or this banner would flash on every launch
                                 during the moment before the probe returns. -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource Brush.Surface.Sunken}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding GitIsMissing,
                                        Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="GIT NOT AVAILABLE"
                                               Style="{StaticResource SectionLabel}"
                                               Foreground="{DynamicResource Brush.Status.Deleted}" />
                                    <TextBlock Text="{Binding GitPresenceExplanation}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                </StackPanel>
                            </Border>

                            <!-- COMMIT IDENTITY.

                                 git commit refuses without user.name and user.email, and in
                                 Versio it refuses AFTER the export gate has spent 17-31 s
                                 running CODESYS - the gate goes first so the mirror is never
                                 committed stale. A long wait followed by git's nine-line
                                 lecture is the worst first run this app can produce, and
                                 two config reads at open remove it entirely.

                                 Persistent rather than a toast: it is a state to be fixed,
                                 not an event that happened. It disappears the moment git can
                                 name a committer. -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource Brush.Surface.Sunken}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding IdentityIsMissing,
                                        Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding IdentityExplanation}"
                                               TextWrapping="Wrap"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Status.Modified}" />

                                    <TextBox Style="{StaticResource FlatTextBox}"
                                             Margin="0,8,0,0" Tag="Your name"
                                             Height="{DynamicResource Size.Control.Compact}"
                                             Text="{Binding IdentityName,
                                                 UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource FlatTextBox}"
                                             Margin="0,6,0,0" Tag="you@example.com"
                                             Height="{DynamicResource Size.Control.Compact}"
                                             Text="{Binding IdentityEmail,
                                                 UpdateSourceTrigger=PropertyChanged}" />

                                    <!-- Advisory, never a gate: git accepts anything non-empty,
                                         and engineer@plc is a perfectly good intranet address.
                                         Refusing it would make Versio stricter than the git it
                                         is driving. -->
                                    <TextBlock Text="That does not look like an email address."
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Disabled}"
                                               Visibility="{Binding IdentityEmailLooksWrong,
                                                   Converter={StaticResource BoolToVisibility}}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Save" Style="{StaticResource AccentButton}"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                Command="{Binding SaveIdentityCommand}" />
                                        <!-- Local by default. A work machine carrying a personal
                                             global identity is a common and annoying way to
                                             attribute commits to the wrong person. -->
                                        <CheckBox Content="Every repository" Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource MenuCheck}"
                                                  ToolTip="Write to the global git config as well as this repository"
                                                  IsChecked="{Binding IdentityGlobal}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CONFLICTS, AND THE WAY OUT OF A DIVERGED BRANCH.

                                 First, above everything, because nothing else in the panel can
                                 proceed while the tree is mid-merge: git refuses the commit,
                                 and the sync engine refuses both directions
                                 (SyncVerdict.BlockedByConflict).

                                 The DETECTION is not here. IConflictProbe and the sync
                                 narrative already own it, and a second detection path would
                                 give the panel and the engine two ways to disagree about the
                                 same tree. This binds to what git reported.

                                 The conflicted files are their OWN section rather than being
                                 folded into staged or not-staged. An unmerged file is reported
                                 in both of git's columns and is really in neither state - it is
                                 stuck - so putting it in either list would misrepresent what
                                 git will do with it. -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource Brush.Surface.Sunken}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding IsMidMerge,
                                        Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ConflictHeadline}"
                                               TextWrapping="Wrap"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Status.Conflict}" />

                                    <ListBox ItemsSource="{Binding Conflicted}"
                                             SelectedItem="{Binding SelectedConflict}"
                                             Background="Transparent" BorderThickness="0"
                                             Margin="0,6,0,0" MaxHeight="120"
                                             ItemContainerStyle="{StaticResource RowItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ItemTemplate="{StaticResource ChangeRowTemplate}" />

                                    <!-- "Ours" and "theirs" swap meaning under a rebase - git
                                         replays your commits onto the upstream - so the labels
                                         say which BRANCH rather than which pronoun. Nobody
                                         should have to remember that rule to press a button. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Keep mine" Padding="8,2"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                Style="{StaticResource GhostButton}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Take this branch's version of the selected file"
                                                Command="{Binding ResolveCommand}"
                                                CommandParameter="True" />
                                        <Button Content="Keep theirs" Padding="8,2" Margin="6,0,0,0"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                Style="{StaticResource GhostButton}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Take the incoming version of the selected file"
                                                Command="{Binding ResolveCommand}"
                                                CommandParameter="False" />

                                        <!-- The way back. Offering an operation that can stop
                                             half-done without offering the undo is how somebody
                                             ends up in a state they cannot describe. -->
                                        <Button Content="Abandon" Padding="8,2" Margin="6,0,0,0"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                Style="{StaticResource GhostButton}"
                                                Foreground="{DynamicResource Brush.Status.Deleted}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Put the branch back where it was before this started"
                                                Command="{Binding AbortMergeCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- THE DIVERGED BRANCH'S ONLY EXIT.

                                 Until this existed the panel's own badge said "diverged, pull
                                 first" and a fast-forward-only pull refuses a diverged branch by
                                 design, so the advice pointed at a button that could not work and
                                 the way out was a terminal.

                                 Fast-forward-only stays the default and this is not a relaxation
                                 of it: that default exists because auto-merging native CODESYS XML
                                 produces a file nobody reviewed. What changes is that the user
                                 can ask for one BY NAME, having been told what it means.

                                 Rebase leads, because it is the usual answer for a feature
                                 branch and it keeps the exported history linear - which matters
                                 more here than in most repositories, since the diff being read
                                 is generated text. -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource Brush.Surface.Sunken}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding Standing.IsDiverged,
                                        Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Standing.Headline}"
                                               TextWrapping="Wrap"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Status.Modified}" />

                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="A fast-forward cannot resolve this. Replaying your commits on top keeps the history linear; merging records both sides." />

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Rebase onto the remote"
                                                Style="{StaticResource AccentButton}"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Replay your commits on top of the remote's"
                                                Command="{Binding ReconcileCommand}"
                                                CommandParameter="True" />
                                        <Button Content="Merge" Margin="6,0,0,0" Padding="8,2"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                Style="{StaticResource GhostButton}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Bring the remote's commits in and record both sides"
                                                Command="{Binding ReconcileCommand}"
                                                CommandParameter="False" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CREDENTIALS.

                                 Versio implements no login and must not start. Driving git.exe
                                 is what makes Git Credential Manager, SSH agents, 2FA and
                                 corporate proxies behave exactly as they do in the engineer's
                                 own terminal; storing a token here would mean owning a secret
                                 store, a rotation story and a breach story, and a
                                 username/password box cannot do 2FA or SSO. So the job is
                                 detect, explain, hand off - never store.

                                 The Sign in button is bound to CanSignIn rather than to the
                                 banner's own visibility, and that is the important part. A 403
                                 means the credential WORKED and the account lacks access, and
                                 an SSH remote has no credential helper at all. Both read like
                                 authentication failures; offering to sign in again on either
                                 is offering a button that cannot work, and on the 403 it is a
                                 loop that cannot terminate. -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource Brush.Surface.Sunken}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Padding="10,8" Margin="0,0,0,10"
                                    Visibility="{Binding NeedsAttentionForAuth,
                                        Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding AuthExplanation}"
                                               TextWrapping="Wrap"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Status.Modified}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Sign in" Style="{StaticResource AccentButton}"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Hand off to your git credential helper. Versio never sees the credential."
                                                Command="{Binding SignInCommand}"
                                                Visibility="{Binding CanSignIn,
                                                    Converter={StaticResource BoolToVisibility}}" />

                                        <!-- The button no git GUI offers, and the one that
                                             fixes the failure people actually hit: an expired
                                             token the helper keeps cheerfully returning, so
                                             every push fails identically and nothing inside the
                                             app changes it. -->
                                        <Button Content="Forget credential" Margin="6,0,0,0"
                                                Style="{StaticResource GhostButton}"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Erase the saved credential for this host, so the next fetch asks for a new one"
                                                Command="{Binding SignOutCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Branch and divergence. The remote state is why somebody opens
                                 this panel, so it leads. -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource Brush.Surface.Sunken}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Icon.Link}"
                                                   Style="{StaticResource IconText}"
                                                   FontSize="12" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        <TextBlock Text="{Binding BranchName}"
                                                   FontFamily="{DynamicResource Font.Mono}"
                                                   FontSize="{DynamicResource Font.Size.Body}"
                                                   FontWeight="{DynamicResource Font.Weight.Medium}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding AheadBehind}" Margin="10,0,0,0"
                                                   FontFamily="{DynamicResource Font.Mono}"
                                                   FontSize="{DynamicResource Font.Size.Caption}"
                                                   Foreground="{DynamicResource Brush.Accent.Default}" />
                                    </StackPanel>

                                    <!-- BRANCH HOUSEKEEPING, ON THE BRANCH LINE.

                                         Not in the fetch/pull/push row, and the geometry test
                                         is what settled it: a fourth button there overflowed
                                         the 380 px panel outright. It does not belong in that
                                         rhythm anyway - deleting branches is about which
                                         branches exist, not about the remote's state - and a
                                         destructive action sitting where Fetch sits gives it
                                         the same weight as a fetch.

                                         Right-aligned and quiet: reached deliberately, not
                                         stumbled into. -->
                                    <Button Content="Delete branches…" Padding="8,2"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource GhostButton}"
                                            Height="{DynamicResource Size.Control.Compact}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Remove branches from this machine, and optionally from the remote"
                                            Command="{Binding DeleteBranchesCommand}" />

                                    <!-- WHERE THIS BRANCH STANDS, IN WORDS.

                                         The arrows above are compact and ask the reader to
                                         remember which one means somebody else moved. This
                                         says it. Three states used to be indistinguishable
                                         here: in sync, no upstream and no remote all rendered
                                         as an empty string, so a branch nobody else could see
                                         looked exactly like a branch that was fully pushed.

                                         The colour is chosen by RemoteStanding, not here:
                                         amber only when doing nothing has a cost. -->
                                    <TextBlock Text="{Binding Standing.Headline}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{Binding Standing.BrushKey,
                                                   Converter={StaticResource ResourceKey}}" />

                                    <!-- Compact: three buttons inside a card that is itself
                                         inside a 380 px panel. At the full 32 px they set the
                                         height of the whole card and pushed the file lists
                                         down for nothing. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <!-- ToolTipService.ShowOnDisabled on every one of
                                             these. A dead button with no reason is what sends
                                             somebody to the command line, which is the thing
                                             this panel exists to avoid, and WPF hides tooltips
                                             on disabled controls unless told otherwise. The
                                             explanation would be invisible exactly when it is
                                             wanted. -->
                                        <Button Content="Fetch" Style="{StaticResource GhostButton}"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Ask the remote what has changed, without touching your files"
                                                Command="{Binding FetchCommand}" />
                                        <Button Content="{Binding PullLabel}" Margin="6,0,0,0"
                                                Style="{StaticResource GhostButton}"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="{Binding Standing.Headline}"
                                                Command="{Binding PullCommand}" />

                                        <!-- Push and Publish swap rather than sharing a button.
                                             A plain push on a branch with no upstream fails
                                             outright, so they are different operations, and one
                                             control meaning both would have a failure mode that
                                             only appears sometimes. -->
                                        <Button Content="{Binding PushLabel}" Margin="6,0,0,0"
                                                Style="{StaticResource GhostButton}"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="{Binding Standing.Headline}"
                                                Command="{Binding PushCommand}"
                                                Visibility="{Binding ShowPush,
                                                    Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Publish branch" Margin="6,0,0,0"
                                                Style="{StaticResource AccentButton}"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Push this branch to the remote and start tracking it"
                                                Command="{Binding PublishCommand}"
                                                Visibility="{Binding ShowPublish,
                                                    Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <!-- ITS OWN ROW, FULL WIDTH, AND NOT BESIDE FETCH.

                                         GP-H already measured what a fourth button on that row
                                         does: it overflows the 380 px panel outright. And it
                                         does not belong there anyway - fetch, pull and push are
                                         one rhythm somebody repeats all day, and raising a
                                         merge request is a deliberate act that happens once per
                                         branch. Different weight, different row.

                                         COLLAPSED, NOT DISABLED, when the forge is unknown. A
                                         self-hosted GitLab is unidentifiable from its URL and a
                                         local-only repository has no forge at all - and neither
                                         is a problem the user can fix from this panel, so a
                                         permanently dead control with a tooltip about repo.json
                                         would be clutter on every repository that will never
                                         have one.

                                         The caption is bound because it means three different
                                         things: create one, go to the one that exists, or open
                                         the list on a forge that cannot tell us which. It is
                                         also in the forge's own vocabulary - GitLab has merge
                                         requests, the other four have pull requests. -->
                                    <Button Content="{Binding MergeRequest.Label}"
                                            Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                            Style="{StaticResource GhostButton}"
                                            Height="{DynamicResource Size.Control.Compact}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="{Binding MergeRequestTooltip}"
                                            Command="{Binding OpenMergeRequestCommand}"
                                            Visibility="{Binding MergeRequest.IsVisible,
                                                Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <!-- Commit box. Ctrl+Enter commits, because reaching for the
                                 mouse after typing a message is the one interaction here
                                 that happens dozens of times a day. -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="COMMIT MESSAGE"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource SectionLabel}" />
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                               Text="{Binding CommitSubjectLength}"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Disabled}"
                                               ToolTip="Subject length. The convention is 50 characters, hard limit 72." />
                                </Grid>

                                <!-- What this commit is about to record, counted as OBJECTS.

                                     "5 changed" is what git can say. "3 POUs, 1 GVL and 1 DUT
                                     changed in RefrigeratorControl" is the sentence the
                                     engineer would have written, and it is available only
                                     because the export wrote the manifest beside the files.

                                     It counts what the button will commit, not the working
                                     tree - those differ the moment anything is staged, and a
                                     line that disagreed with the caption under it would be
                                     two controls describing one press.

                                     Hidden rather than empty when nothing here belongs to a
                                     PLC project: the rows are ordinary paths then, and the
                                     list already says how many. -->
                                <TextBlock Text="{Binding ChangeSummaryLine}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Visibility="{Binding HasChangeSummary,
                                               Converter={StaticResource BoolToVisibility}}" />

                                <TextBox x:Name="CommitMessageBox" Height="72"
                                         Style="{StaticResource FlatTextBox}"
                                         Tag="Summary of the change…"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         KeyDown="OnCommitMessageKeyDown"
                                         Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- ONE BUTTON, THREE BEHAVIOURS, AND A CAPTION THAT SAYS
                                     WHICH.

                                     "Commit & Push" is gone. It bundled two operations with
                                     different failure modes, and its failure story was the
                                     worst in the panel: the commit succeeds, the push fails,
                                     and one message has to describe both. Push is a deliberate
                                     act of its own now, up in the remote row where the
                                     ahead-count already lives.

                                     The caption is bound because it MEANS different things:
                                     "Stage & commit (3)" stages what is ticked, "Stage all &
                                     commit" takes the lot, and a plain "Commit" leaves the
                                     unstaged files exactly where they are. That last one is
                                     the safeguard - somebody who staged three files on purpose
                                     must not get a fourth swept in - and it is only visible
                                     before the press if the caption carries it.

                                     ToolTipService.ShowOnDisabled because WPF hides a tooltip
                                     on a disabled control by default, so the one moment the
                                     explanation is wanted is the one moment it would be
                                     missing. The tooltip says what the button will do while it
                                     is live, and why it cannot while it is not. -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="{Binding Commit.Label}"
                                            Style="{StaticResource AccentButton}"
                                            Command="{Binding CommitCommand}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="{Binding CommitExplanation}" />

                                    <!-- OFFERED, NEVER APPLIED, AND NEVER OVER TYPED WORDS.

                                         The button goes dead the moment the box has anything
                                         in it, so there is no press that can lose a
                                         half-written message. An "are you sure" over
                                         somebody's own sentence is a worse answer than not
                                         offering the action; clearing the box offers it
                                         again. -->
                                    <Button Content="Draft" Margin="8,0,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding DraftCommitMessageCommand}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Fill the box with a subject built from the changed objects. Available while the box is empty." />
                                </StackPanel>

                                <!-- The most surprising rule in the tool, stated where the
                                     decision is made rather than discovered afterwards - but
                                     only when it is about to happen.

                                     It used to be permanent, and a caption that says the same
                                     thing on every refresh is read once and never again; this
                                     codebase has already argued that out over a coverage line
                                     that congratulated itself every time. The half about
                                     pushing releasing the lock is on the Push button's own
                                     tooltip, which is where somebody asks it. -->
                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Status.Modified}"
                                           Text="A stale PLC export runs before this commit, and is staged with it.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Sync.StalenessSummary}"
                                                             Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Staged / unstaged.
                                 Two columns, not one cell with a right-aligned button in it.
                                 Sharing the cell is how "NOT STAGED" and "Discard" ended up
                                 touching in a 380 px panel: a right-aligned child grows
                                 leftwards across the label instead of pushing it, and neither
                                 one knows the other is there. The label takes what is left and
                                 trims; the buttons keep their width. -->
                            <!--
                                TWO PANES THAT BOTH SCROLL, AND A SPLITTER BETWEEN THEM.

                                The staged list used to be docked top with a hard
                                MaxHeight="150" while the unstaged list took everything left.
                                So a forty-file stage was trapped in four rows next to an empty
                                list holding four hundred pixels of nothing - the layout was
                                honest about neither.

                                Both rows are star-sized with a MinHeight, so neither can be
                                crushed to nothing, and the splitter lets somebody who is
                                mostly reviewing what is staged give it the room.
                            -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="60" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="60" />
                                </Grid.RowDefinitions>

                                <!-- STAGED header: master checkbox, label, count, action. -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Three-state, and the middle one is only ever produced,
                                         never accepted: "set this to partially ticked" has no
                                         meaning. -->
                                    <CheckBox Grid.Column="0" Margin="0,0,6,0"
                                              VerticalAlignment="Center" IsThreeState="True"
                                              Style="{StaticResource MenuCheck}"
                                              ToolTip="Tick or clear every staged file"
                                              IsChecked="{Binding StagedAllSelected, Mode=TwoWay}" />

                                    <TextBlock Grid.Column="1" Text="STAGED"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SectionLabel}" />

                                    <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Disabled}"
                                               Text="{Binding StagedSelectionCaption}" />

                                    <Button Grid.Column="3" Content="{Binding UnstageLabel}"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource GhostButton}" Padding="8,2"
                                            Height="{DynamicResource Size.Control.Compact}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Take these back out of the next commit"
                                            Command="{Binding UnstageCommand}" />
                                </Grid>

                                <ListBox Grid.Row="1" x:Name="StagedList"
                                         ItemsSource="{Binding Staged}"
                                         SelectedItem="{Binding SelectedStaged}"
                                         Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource RowItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ItemTemplate="{StaticResource StageRowTemplate}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling" />

                                <!-- The staged list can be tall now, so it virtualizes too.
                                     It could not before, behind its 150 px ceiling. -->
                                <GridSplitter Grid.Row="2" Height="5"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              ResizeBehavior="PreviousAndNext"
                                              ResizeDirection="Rows" />

                                <Grid Grid.Row="3" Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" Margin="0,0,6,0"
                                              VerticalAlignment="Center" IsThreeState="True"
                                              Style="{StaticResource MenuCheck}"
                                              ToolTip="Tick or clear every changed file"
                                              IsChecked="{Binding UnstagedAllSelected, Mode=TwoWay}" />

                                    <TextBlock Grid.Column="1" Text="NOT STAGED"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SectionLabel}" />

                                    <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Disabled}"
                                               Text="{Binding UnstagedSelectionCaption}" />

                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                Margin="8,0,0,0">
                                        <!-- Still the only button here that destroys work
                                             nothing else has a copy of, and it still confirms
                                             with the files named. What changed is that it can
                                             now act on a ticked set rather than only on the
                                             one row somebody happened to click. -->
                                        <Button Content="{Binding DiscardLabel}" Padding="8,2"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                Style="{StaticResource GhostButton}"
                                                Foreground="{DynamicResource Brush.Status.Deleted}"
                                                Command="{Binding DiscardCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Throw these changes away — this cannot be undone" />
                                        <Button Content="{Binding StageLabel}" Padding="8,2"
                                                Margin="6,0,0,0"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                Style="{StaticResource GhostButton}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Put these into the next commit"
                                                Command="{Binding StageCommand}" />
                                    </StackPanel>
                                </Grid>

                                <ListBox Grid.Row="4" x:Name="UnstagedList"
                                         ItemsSource="{Binding Unstaged}"
                                         SelectedItem="{Binding SelectedUnstaged}"
                                         Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource RowItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ItemTemplate="{StaticResource StageRowTemplate}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- HISTORY: what already happened, as against the git panel's what is
                         about to. A commit opens to the files it touched, and a file opens
                         its patch in the same pane the working tree uses - one pane, so a
                         change reads the same wherever it was reached from.

                         Nothing here is read before somebody asks for it. The log is not
                         walked until this panel is first shown, a page at a time after that;
                         a commit's files are fetched when it is expanded; and a patch when a
                         file is clicked. The panel this replaced re-read the whole log on
                         every refresh that touched git's metadata, open or not. -->
                    <Border Grid.Row="1" x:Name="HistoryPanel" Visibility="Collapsed" Padding="14,0,12,12">
                        <DockPanel>
                            <!-- One page back at a time. Hidden once the branch runs out,
                                 rather than greyed: there is nothing further to say about a
                                 history somebody has reached the beginning of. -->
                            <Button DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Padding="8,2"
                                    Style="{StaticResource GhostButton}"
                                    Content="Load older commits"
                                    Command="{Binding History.LoadMoreCommand}"
                                    Visibility="{Binding History.HasMore,
                                        Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding History.Summary}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Disabled}" />

                            <!-- A TreeView for the same reason the project panel uses one:
                                 expand and collapse, one selection across both levels, and
                                 virtualization that is measured rather than assumed. All
                                 three attributes below are required, and so is the
                                 VirtualizingStackPanel items panel - see the project tree,
                                 where the defaults cost 10,635 ms against 94.7 ms. -->
                            <TreeView ItemsSource="{Binding History.Commits}"
                                      Background="Transparent" BorderThickness="0"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      VirtualizingStackPanel.ScrollUnit="Pixel"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectedItemChanged="OnHistoryRowSelected">
                                <TreeView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </TreeView.ItemsPanel>

                                <!-- TreeRowItem is what RowItem is for the lists: a tinted
                                     fill and an accent bar instead of Windows' own highlight
                                     blue, and a chevron instead of the Aero triangle. The
                                     IsExpanded binding stays here rather than in the style,
                                     because it is per-row state and it is what drives the
                                     lazy children. -->
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem"
                                           BasedOn="{StaticResource TreeRowItem}">
                                        <Setter Property="IsExpanded"
                                                Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>

                                <TreeView.Resources>
                                    <!-- Two lines, because four facts do not fit across a
                                         380 px column. The subject leads - it is what
                                         somebody is scanning for - and the identifying
                                         details sit under it in the quieter face. -->
                                    <HierarchicalDataTemplate DataType="{x:Type vm:CommitRow}"
                                                              ItemsSource="{Binding Children}">
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Subject}"
                                                       FontFamily="{DynamicResource Font.UI}"
                                                       FontSize="{DynamicResource Font.Size.Body}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Subject}" />

                                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding ShortId}"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           FontSize="{DynamicResource Font.Size.Caption}"
                                                           Foreground="{DynamicResource Brush.Accent.Default}"
                                                           ToolTip="{Binding Id}" />

                                                <!-- Absolute and local. The relative form git
                                                     prints is on the tooltip: it is friendlier
                                                     to read and useless to quote. -->
                                                <TextBlock Text="{Binding When}" Margin="8,0,0,0"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           FontSize="{DynamicResource Font.Size.Caption}"
                                                           Foreground="{DynamicResource Brush.Text.Disabled}"
                                                           ToolTip="{Binding Age}" />

                                                <TextBlock Text="{Binding Author}" Margin="8,0,0,0"
                                                           FontFamily="{DynamicResource Font.UI}"
                                                           FontSize="{DynamicResource Font.Size.Caption}"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="120"
                                                           ToolTip="{Binding Author}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>

                                    <!-- ITS OWN TEMPLATE, AND IT HAS TO BE.

                                         This drew ChangeRowTemplate until GP-J, on the
                                         argument that a deletion should be the same colour and
                                         the same letter wherever it is seen. Then GP-J taught
                                         that template to show an OBJECT - Primary, TypeLabel,
                                         IsExportOnly - and a CommitFileRow has none of those.
                                         WPF fails a binding to a missing property silently, so
                                         every row in this panel rendered with no filename at
                                         all and a lock glyph it had no business showing: the
                                         Visibility binding failed too, and a failed Visibility
                                         binding leaves the element Visible.

                                         Found by opening the app, not by any test - the
                                         realised-row tests GP-J added cover the git panel's own
                                         lists and never came here.

                                         The glyph and its colour still come from one place:
                                         ChangeGlyph, which is where that decision actually
                                         lives. What is NOT shared is the object surface, and a
                                         commit's files deliberately stay paths - the object
                                         index describes the CURRENT export, and naming a
                                         historical path from it would put today's name on
                                         yesterday's file. -->
                                    <DataTemplate DataType="{x:Type vm:CommitFileRow}">
                                        <Grid ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       FontSize="{DynamicResource Font.Size.Caption}"
                                                       FontWeight="{DynamicResource Font.Weight.Semibold}"
                                                       Foreground="{Binding BrushKey,
                                                           Converter={StaticResource ResourceKey}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Path}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       FontSize="{DynamicResource Font.Size.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>
                    </Border>

                    <!-- PROJECT: the one view. Every tracked project with its objects
                         underneath it, and every other changed file beside them.

                         This replaced two panels that were answering the same question and
                         disagreeing about the answer: a changed .st appeared in the file list
                         as a path and in the sync panel as an object, with nothing saying they
                         were the same edit. -->
                    <Border Grid.Row="1" x:Name="ProjectPanel" Padding="14,0,12,12">
                        <DockPanel>
                            <!-- What used to be a PLC status card is gone.
                                 It carried the toolchain name, its version and its profile -
                                 system information, identical for every repository, which now
                                 lives in Settings > Help > System information. And it carried
                                 two buttons that were disabled almost always: "Export now",
                                 replaced by exporting on open, and "Acknowledge failure",
                                 which belonged to one project rather than to the panel and is
                                 now on that project's own row.

                                 What is left are the two lines that are transient and worth
                                 interrupting for, and both hide themselves when empty. -->

                            <!-- What the scan found that Versio cannot resolve on its own: an
                                 export tree whose project was deleted, a binding pointing at
                                 nothing, a manifest claiming a different binding. Rare, and
                                 every one of them needs a person - which is why they are here
                                 rather than only in the log, where they used to stop. -->
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Sync.FindingsSummary}"
                                       TextWrapping="Wrap" Margin="2,0,0,8"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Status.Deleted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sync.FindingsSummary}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- What the export cannot carry. Distinct from staleness: stale
                                 means the mirror is behind the project, this means the mirror
                                 could never hold it in the first place. -->
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Sync.CoverageSummary}"
                                       TextWrapping="Wrap" Margin="2,0,0,8"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Status.Deleted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sync.CoverageSummary}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Projects the mirror is still behind on. Normally empty: the
                                 catch-up on open exports them. It is NOT empty when an export
                                 could not run - the project is open in the IDE, or the
                                 direction lock points the other way - and that is exactly when
                                 silence would read as "in sync". -->
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Sync.StalenessSummary}"
                                       TextWrapping="Wrap" Margin="2,0,0,8"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Status.Modified}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sync.StalenessSummary}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- A toolchain launch is 17-31 s with nothing on screen to show
                                 for it, and silence is indistinguishable from a hang. -->
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Sync.Activity}"
                                       TextWrapping="Wrap" Margin="2,0,0,8"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Status.Modified}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sync.Activity}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- THE COPIES THAT EXISTED AND NOTHING COULD REACH.

                                 Ten per project are written before every import, and until now
                                 the only route to one was knowing the layout of .versio/local/
                                 by heart - at the precise moment somebody is having a bad
                                 afternoon because an import damaged their project.

                                 Hidden rather than disabled when there are none, because that
                                 is the ordinary state: most projects have never had an import
                                 run, and a permanently dead button labelled "Restore" on every
                                 one of them would be furniture. It appears when the selected
                                 project has something to go back to. -->
                            <Button DockPanel.Dock="Top" Content="Restore a saved copy…"
                                    Margin="0,0,0,6" HorizontalAlignment="Left" Padding="10,2"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding Sync.RestoreBackupCommand}"
                                    ToolTip="Put a previous version of this project back. The version it replaces is saved first."
                                    Visibility="{Binding Sync.SelectedHasBackups,
                                        Converter={StaticResource BoolToVisibility}}" />

                            <TextBox DockPanel.Dock="Top" Margin="0,0,0,6"
                                     Style="{StaticResource FlatTextBox}"
                                     Tag="Find an object or a file…"
                                     Text="{Binding Sync.TreeSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" />

                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Sync.TreeSummary}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Disabled}" />

                            <!-- WPF TreeView virtualization is OFF by default and the cost is
                                 not marginal: measured at 94.7 ms virtualized against
                                 10,635 ms at the defaults on a 5,002-node CODESYS-shaped tree.
                                 All three attributes are required, and so is the
                                 VirtualizingStackPanel items panel. The spike that measured
                                 it lives in Spikes/ and runs from the command line.

                                 It matters more here than it did in the old panel: the tree
                                 renders every object rather than only the changed ones.
                                 Virtualization is what keeps that affordable on screen, and
                                 TreeRow's lazy Children is what keeps it affordable in
                                 memory. -->
                            <TreeView ItemsSource="{Binding Sync.Tree}"
                                      Background="Transparent" BorderThickness="0"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      VirtualizingStackPanel.ScrollUnit="Pixel"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectedItemChanged="OnTreeNodeSelected">
                                <TreeView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </TreeView.ItemsPanel>

                                <!-- TreeRowItem is what RowItem is for the lists: a tinted
                                     fill and an accent bar instead of Windows' own highlight
                                     blue, and a chevron instead of the Aero triangle. The
                                     IsExpanded binding stays here rather than in the style,
                                     because it is per-row state and it is what drives the
                                     lazy children. -->
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem"
                                           BasedOn="{StaticResource TreeRowItem}">
                                        <Setter Property="IsExpanded"
                                                Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>

                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       FontSize="{DynamicResource Font.Size.Caption}"
                                                       FontWeight="{DynamicResource Font.Weight.Semibold}"
                                                       Foreground="{Binding BrushKey,
                                                           Converter={StaticResource ResourceKey}}" />

                                            <!-- A file row's name is a whole repo-relative
                                                 path, and paths read in the monospaced face. -->
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Font.Size.Body}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Node.Path}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily"
                                                                Value="{DynamicResource Font.UI}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                                <Setter Property="FontFamily"
                                                                        Value="{DynamicResource Font.Mono}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsProject}" Value="True">
                                                                <Setter Property="FontWeight"
                                                                        Value="{DynamicResource Font.Weight.Semibold}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- A project reports its export state here; an
                                                 object reports its CODESYS type, so a POU and
                                                 a visualisation of the same name are told
                                                 apart. No row ever has both.

                                                 While a toolchain run is in flight the state
                                                 is the accent colour instead of the dimmest
                                                 one on the palette. The complaint that led
                                                 here was that a save looked like nothing was
                                                 happening for half a minute, and "exporting…"
                                                 rendered in the same grey as "in sync" is a
                                                 poor answer to it: the eye reads the colour
                                                 before it reads the word. -->
                                            <TextBlock Grid.Column="2" Text="{Binding Annotation}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       FontSize="{DynamicResource Font.Size.Caption}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Brush.Text.Disabled}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource Brush.Accent.Default}" />
                                                                <Setter Property="FontWeight"
                                                                        Value="{DynamicResource Font.Weight.Semibold}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Roll-up count, so a change is never hidden
                                                 behind a collapsed folder. -->
                                            <Border Grid.Column="3" Margin="8,0,4,0"
                                                    Background="{DynamicResource Brush.Surface.Sunken}"
                                                    CornerRadius="8" Padding="6,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Badge}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Badge}"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           FontSize="{DynamicResource Font.Size.Caption}"
                                                           Foreground="{Binding BrushKey,
                                                               Converter={StaticResource ResourceKey}}" />
                                            </Border>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </Border>

                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Diff -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Base}"
                    Margin="0,8,8,8" CornerRadius="{DynamicResource Radius.Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Style="{StaticResource SectionLabel}" Text="DIFF" />

                        <!-- Right-aligned inside its own column, so the path can be long
                             without reaching the label. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Margin="12,0,0,0" HorizontalAlignment="Right">
                            <!-- Three lines of context is enough for a typo and not enough
                                 for a POU, where whether an edit is safe depends on
                                 declarations well above it. Still a diff either way: the
                                 changed lines stay marked and coloured. -->
                            <CheckBox Content="Show full file" VerticalAlignment="Center"
                                      Margin="0,0,14,0"
                                      IsChecked="{Binding ShowFullFile}"
                                      Foreground="{DynamicResource Brush.Text.Secondary}"
                                      FontFamily="{DynamicResource Font.UI}"
                                      FontSize="{DynamicResource Font.Size.Caption}"
                                      ToolTip="Show every line of the file, with the changes still highlighted" />
                            <TextBlock Style="{StaticResource Mono}" VerticalAlignment="Center"
                                       Text="{Binding SelectedDiffPath}"
                                       Foreground="{DynamicResource Brush.Text.Disabled}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </StackPanel>
                    </Grid>
                    <!-- The failure pane. A failed project stops syncing until a person has
                         seen the failure - that gate is deliberate - so this is where they
                         see it: the reason the toolchain gave, and one button that clears the
                         failure and tries again. It used to be a permanently greyed button at
                         the top of the project panel, which said nothing about WHICH project
                         had failed. -->
                    <Border DockPanel.Dock="Top" Margin="6,0,6,8" Padding="14,12"
                            Background="{DynamicResource Brush.Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Visibility="{Binding Sync.HasFailure,
                                Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Sync.FailedProject.Name}"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       FontWeight="{DynamicResource Font.Weight.Semibold}"
                                       Foreground="{DynamicResource Brush.Status.Deleted}" />

                            <TextBlock Text="{Binding Sync.FailureDetail}" TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />

                            <Button Content="Try again" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Padding="16,4"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding Sync.RetryCommand}"
                                    ToolTip="Clear the failure and sync this project again" />
                        </StackPanel>
                    </Border>

                    <!-- THE IMPORT NOBODY HAS AGREED TO YET.

                         RequireImportConfirmation has been true since it shipped and the only
                         caller answered it "confirmed, because there is nobody to ask" - so a
                         setting that is switched on was consulted on every import and always
                         answered yes. There is somebody to ask now, and this is where they are
                         asked.

                         A BANNER, NOT A MODAL, and that is the whole design. The orchestrator's
                         own refusal reads "review the diff and confirm before importing", and a
                         dialog thrown up the instant a file settles arrives before the review -
                         while the user is still typing in the editor that caused it. The tree
                         beside this shows exactly what changed, by object name; the button is
                         pressed once they have looked. THEN a confirmation names the project.

                         Amber, not the failure pane's red: nothing has gone wrong. Something is
                         waiting for a decision, which is a different thing and should not read
                         like a fault. -->
                    <Border DockPanel.Dock="Top" Margin="6,0,6,8" Padding="14,12"
                            Background="{DynamicResource Brush.Surface.Sunken}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Visibility="{Binding Sync.HasPendingImport,
                                Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Sync.PendingImportProject.Name}"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       FontWeight="{DynamicResource Font.Weight.Semibold}"
                                       Foreground="{DynamicResource Brush.Status.Modified}" />

                            <TextBlock Text="{Binding Sync.PendingImportDetail}" TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />

                            <Button Content="Review and import" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Padding="16,4"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding Sync.ConfirmImportCommand}"
                                    ToolTip="Write the exported text back into the project. You will be asked to confirm, and a copy of the project is kept first." />
                        </StackPanel>
                    </Border>

                    <views:DiffView DiffText="{Binding SelectedDiff}"
                                    FilePath="{Binding SelectedDiffPath}"
                                    HunkCommand="{Binding HunkCommand}"
                                    ShowHunkActions="{Binding CanStageHunks}"
                                    HunkActionLabel="{Binding HunkAction}"
                                    Margin="6,0,6,8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </views:DiffView>
                </DockPanel>
            </Border>

            <!-- ============================ NOTIFICATIONS ============================

                 Events, as against state. The status bar below says what IS true - "3
                 changed" - and these say what just HAPPENED - "Pushed."

                 They were the same property until now, and the collision was not
                 theoretical: PushAsync set the message and then called RunRefreshAsync,
                 which overwrote it with the file count. A successful push produced no
                 visible confirmation at all.

                 Bottom-right, over the content and NOT modal: a failure card stays until it
                 is dismissed, so the panel underneath has to remain usable the whole time it
                 is up. IsHitTestVisible is left alone on the cards themselves - they carry
                 buttons - but the host is transparent to the mouse everywhere else, or an
                 invisible 420px column would swallow clicks along the whole right edge.

                 Last child of the Grid, spanning every column, so it paints above the panels
                 rather than reserving space beside them.
            -->
            <ItemsControl Grid.ColumnSpan="3"
                          Margin="0,0,18,14"
                          VerticalAlignment="Bottom" HorizontalAlignment="Right"
                          Background="Transparent"
                          ItemsSource="{Binding Notifications.Visible}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Toast}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The severity colour lives here rather than on the card's
                                     background: a card that is entirely red shouts, where the
                                     point is to be noticed and then leave. -->
                                <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                           Style="{StaticResource IconText}"
                                           FontSize="13" Margin="0,1,9,0"
                                           VerticalAlignment="Top"
                                           Text="{Binding Glyph,
                                               Converter={StaticResource ResourceKey}}"
                                           Foreground="{Binding BrushKey,
                                               Converter={StaticResource ResourceKey}}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Headline}"
                                               TextWrapping="Wrap"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               FontWeight="{DynamicResource Font.Weight.Medium}"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />

                                    <!-- Git's own words, verbatim and unabridged. This is the
                                         line that gets pasted into a message asking for help,
                                         and a paraphrase is useless for that. -->
                                    <TextBlock Text="{Binding Detail}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Visibility="{Binding HasDetail,
                                                   Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <!-- Only on the cards that stay. A close button on something
                                     about to vanish is a target that moves out from under the
                                     cursor, which is worse than no button. -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Top" Margin="8,0,0,0"
                                            Visibility="{Binding IsSticky,
                                                Converter={StaticResource BoolToVisibility}}">
                                    <Button Style="{StaticResource IconButton}"
                                            Padding="4,0" Click="OnCopyNotification"
                                            ToolTip="Copy this message"
                                            Content="{DynamicResource Icon.Copy}" />
                                    <Button Style="{StaticResource IconButton}"
                                            Padding="4,0"
                                            ToolTip="Dismiss"
                                            Command="{Binding DismissCommand}"
                                            Content="{DynamicResource Icon.Close}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- What is being held back, when more has happened than fits. -->
            <Border Grid.ColumnSpan="3" Style="{StaticResource Pill}"
                    Margin="0,0,18,4" Padding="8,2"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Visibility="{Binding Notifications.HasOverflow,
                        Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource PillText}"
                           Text="{Binding Notifications.OverflowText}" />
            </Border>
        </Grid>

        <!-- ============================= LOG PANEL ============================= -->
        <Border x:Name="LogConsole" Grid.Row="2" Grid.Column="1"
                Background="{DynamicResource Brush.Surface.Base}"
                Margin="8,0,8,8" CornerRadius="{DynamicResource Radius.Card}">
            <DockPanel>
                <!--
                    Header is always visible; only the list collapses.

                    The controls do not. A collapsed log is a one-line strip that exists to
                    be clicked open and to carry the count, and hanging a filter box, four
                    chips and a dropdown off it spends the width of the window on controls
                    for a list nobody is looking at. They appear with the list they filter.

                    Two things survive collapse, because both change what the strip MEANS:
                    the entry count, and the paused state.
                -->
                <Grid DockPanel.Dock="Top" Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="LogToggle"
                            Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Command="{Binding Log.ToggleExpandedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LogChevron" Style="{StaticResource IconText}"
                                       FontSize="11" Margin="0,0,8,0"
                                       Text="{DynamicResource Icon.ChevronDown}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="LOG" Style="{StaticResource SectionLabel}" />
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="1" Style="{StaticResource Pill}" Margin="4,0,0,0">
                        <TextBlock Text="{Binding Log.Rows.Count}"
                                   Style="{StaticResource PillText}" />
                    </Border>

                    <!--
                        PAUSED, said in words. The pause button alone could not carry this:
                        a paused log and an idle app look identical, and the reader who most
                        needs to know is the one who paused to read something, got
                        distracted, and came back to a panel that has not moved since.
                        The held count is the proof it is a freeze and not a silence.
                    -->
                    <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="6,0,0,0"
                            Background="{DynamicResource Brush.Accent.Muted}"
                            ToolTip="Entries are still being recorded and are waiting for you. The log file has them all."
                            Visibility="{Binding Log.IsPaused,
                                Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PAUSED" Style="{StaticResource PillText}"
                                       FontWeight="{DynamicResource Font.Weight.Semibold}"
                                       Foreground="{DynamicResource Brush.Accent.Default}" />
                            <TextBlock Style="{StaticResource PillText}" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Accent.Default}"
                                       Text="{Binding Log.HeldCount, StringFormat={}+{0}}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== Everything below appears only with the list it filters ===== -->

                    <!-- Level, as four chips rather than a minimum. The question somebody
                         has is "show me warnings and errors", which a threshold cannot
                         express, and at the default of Debug a threshold filters nothing. -->
                    <ItemsControl Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0"
                                  ItemsSource="{Binding Log.Filters.Levels}"
                                  Visibility="{Binding Log.IsExpanded,
                                      Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource FilterChip}"
                                              Content="{Binding Label}"
                                              Foreground="{Binding BrushKey,
                                                  Converter={StaticResource ResourceKey}}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              ToolTip="Click to hide this level, click again to bring it back" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Category, as a multi-select dropdown. Checkable rather than a single
                         choice because the question is usually about two at once: an export
                         is Sync deciding and Plc doing, and either alone is half the story. -->
                    <ToggleButton Grid.Column="5" x:Name="CategoryButton"
                                  Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                  Height="{DynamicResource Size.Control.Compact}" Padding="8,0"
                                  Visibility="{Binding Log.IsExpanded,
                                      Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Icon.Filter}"
                                       Style="{StaticResource IconText}"
                                       FontSize="11" Margin="0,0,6,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding Log.Filters.CategorySummary}"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Icon.ChevronDown}"
                                       Style="{StaticResource IconText}"
                                       FontSize="9" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Text.Disabled}" />
                        </StackPanel>
                    </ToggleButton>

                    <Popup PlacementTarget="{Binding ElementName=CategoryButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=CategoryButton, Mode=TwoWay}">
                        <Border Background="{DynamicResource Brush.Surface.Raised}"
                                CornerRadius="{DynamicResource Radius.Card}"
                                Padding="10" Margin="8" MinWidth="200">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                                  Opacity="0.35" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="CATEGORY"
                                               Style="{StaticResource SectionLabel}" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <!-- Both directions. "All" alone leaves the reader
                                             who wants one category unchecking nine. -->
                                        <Button Content="All" Padding="6,0" Height="20"
                                                Style="{StaticResource GhostButton}"
                                                FontSize="{DynamicResource Font.Size.Caption}"
                                                Command="{Binding Log.Filters.AllCategoriesCommand}" />
                                        <Button Content="None" Padding="6,0" Height="20"
                                                Style="{StaticResource GhostButton}"
                                                FontSize="{DynamicResource Font.Size.Caption}"
                                                Command="{Binding Log.Filters.NoCategoriesCommand}" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Log.Filters.Categories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource MenuCheck}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}">
                                                <Grid Width="150">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <!-- The counts are why the list is worth
                                                         opening: they say where the volume
                                                         is, which is usually the question. -->
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Text="{Binding Count}"
                                                               FontFamily="{DynamicResource Font.Mono}"
                                                               Foreground="{DynamicResource Brush.Text.Disabled}" />
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <TextBox Grid.Column="6" Width="200" Margin="0,0,6,0"
                             Style="{StaticResource FlatTextBox}"
                             Tag="Find…"
                             Visibility="{Binding Log.IsExpanded,
                                 Converter={StaticResource BoolToVisibility}}"
                             Text="{Binding Log.Filters.Text, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- The icon states what pressing it will do, so it shows Play while
                         paused. The tooltip used to say "pause auto-scroll", which promises
                         a much weaker thing than it does: the list stops entirely. -->
                    <Button Grid.Column="7"
                            Command="{Binding Log.TogglePauseCommand}"
                            Visibility="{Binding Log.IsExpanded,
                                Converter={StaticResource BoolToVisibility}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="{DynamicResource Icon.Pause}" />
                                <Setter Property="ToolTip"
                                        Value="Freeze the list. Nothing is lost — entries queue up and arrive when you resume" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Log.IsPaused}" Value="True">
                                        <Setter Property="Content"
                                                Value="{DynamicResource Icon.Play}" />
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource Brush.Accent.Default}" />
                                        <Setter Property="ToolTip"
                                                Value="Resume, and deliver everything that arrived while you were reading" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="8" Style="{StaticResource IconButton}" Margin="0,0,6,0"
                            Content="{DynamicResource Icon.Delete}"
                            Command="{Binding Log.ClearCommand}"
                            Visibility="{Binding Log.IsExpanded,
                                Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Clear the view — the log file keeps everything" />
                </Grid>

                <ListBox x:Name="LogList" Height="200"
                         ItemsSource="{Binding Log.Rows}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource LogRowItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}"
                                           Style="{StaticResource Mono}"
                                           Foreground="{DynamicResource Brush.Text.Disabled}" />
                                <TextBlock Grid.Column="1" Text="{Binding Level}"
                                           Style="{StaticResource Mono}"
                                           Foreground="{DynamicResource Brush.Status.Neutral}" />
                                <!-- Secondary, not accent. Accent was on the brand, the
                                     hashes, the divergence, the watch state, the busy caption
                                     and every category in a scrolling log at once, and a
                                     colour used for six things marks nothing. The category is
                                     a column you scan structurally; it does not need to
                                     compete with the message beside it. -->
                                <TextBlock Grid.Column="2" Text="{Binding Category}"
                                           Style="{StaticResource Mono}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Grid.Column="3" Text="{Binding Message}"
                                           Style="{StaticResource Mono}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================= STATUS BAR ============================= -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Surface.Base}" Padding="16,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{DynamicResource Brush.Status.Added}" />

                    <!-- What is running, beside the bar that says something is. A moving bar
                         with no caption tells the user to wait without saying what for, which
                         over twenty seconds of CODESYS is its own kind of unhelpful. -->
                    <!-- The moving bar two rows up is what says something is happening; this
                         says what, and does not need to shout it in accent as well. -->
                    <TextBlock Text="{Binding Busy.Message}" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Visibility="{Binding Busy.IsBusy,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusSummary}" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />

                    <!-- How fresh the file list is, and whether it is keeping itself that
                         way. Worth stating: on a network share the OS refuses to host a
                         watcher and the list falls back to a periodic re-read, which is a
                         real difference in behaviour rather than something to hide. -->
                    <TextBlock Text="{Binding LastRefreshText}" Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Text.Disabled}" />
                    <TextBlock Text="{Binding WatchState}" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Text.Disabled}" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Mono}"
                           Text="{Binding RepositoryPath}"
                           Foreground="{DynamicResource Brush.Text.Disabled}" />
            </Grid>
        </Border>
    </Grid>
</Window>
