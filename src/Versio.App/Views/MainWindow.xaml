<Window x:Class="Versio.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Versio.App.Views"
        Title="Versio" Height="840" Width="1420"
        Background="{DynamicResource Brush.Surface.Sunken}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:ResourceKeyConverter x:Key="ResourceKey" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- top bar   -->
            <RowDefinition Height="*" />      <!-- body      -->
            <RowDefinition Height="Auto" />   <!-- log       -->
            <RowDefinition Height="Auto" />   <!-- status    -->
        </Grid.RowDefinitions>

        <!-- ============================== TOP BAR ============================== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Base}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Versio" VerticalAlignment="Center"
                           Margin="6,0,18,0"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Subtitle}"
                           FontWeight="{DynamicResource Font.Weight.Semibold}"
                           Foreground="{DynamicResource Brush.Accent.Default}" />

                <!-- Repository dropdown.
                     The closed box shows the NAME only. The first pass also crammed the
                     full path in there, which made both dropdowns read as dense strings of
                     grey text. The path belongs in the open list, where there is room and
                     where it is actually needed - to tell two repos of the same name apart. -->
                <ComboBox Grid.Column="1" Width="230"
                          Style="{StaticResource FlatCombo}"
                          ItemContainerStyle="{StaticResource FlatComboItem}"
                          Tag="{DynamicResource Icon.Folder}"
                          ItemsSource="{Binding RecentRepositories}"
                          SelectedItem="{Binding SelectedRepository}"
                          ToolTip="{Binding RepositoryPath}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                        Content="{DynamicResource Icon.Folder}" Margin="6,0,0,0"
                        Click="OnOpenRepository" ToolTip="Open a repository…" />

                <!-- Branch dropdown. Closed: name and divergence only. Upstream tracking is
                     only useful while comparing branches, so it lives in the open list. -->
                <ComboBox Grid.Column="3" Width="200" Margin="20,0,0,0"
                          Style="{StaticResource FlatCombo}"
                          ItemContainerStyle="{StaticResource FlatComboItem}"
                          Tag="{DynamicResource Icon.Link}"
                          ItemsSource="{Binding Branches}"
                          SelectedItem="{Binding SelectedBranch}"
                          ToolTip="Switch branch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Body}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AheadBehind}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Accent.Default}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="4" Style="{StaticResource IconButton}"
                        HorizontalAlignment="Left" Margin="4,0,0,0"
                        Content="{DynamicResource Icon.Refresh}"
                        Command="{Binding RefreshCommand}" ToolTip="Refresh (F5)" />

                <!-- Settings: theme lives here now, not as a top-level button. -->
                <Button Grid.Column="5" x:Name="SettingsButton"
                        Style="{StaticResource IconButton}"
                        Content="{DynamicResource Icon.Settings}"
                        Click="OnOpenSettings" ToolTip="Settings" />
            </Grid>
        </Border>

        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom" HorizontalOffset="-190" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Card}" Padding="6" Width="230">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.24"
                                      Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}"
                               Margin="10,8,0,6" />
                    <RadioButton x:Name="ThemeSystem" Content="Follow system" GroupName="Theme"
                                 Margin="10,3" Foreground="{DynamicResource Brush.Text.Primary}"
                                 FontFamily="{DynamicResource Font.UI}"
                                 FontSize="{DynamicResource Font.Size.Body}"
                                 Checked="OnThemeChanged" Tag="System" />
                    <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme"
                                 Margin="10,3" Foreground="{DynamicResource Brush.Text.Primary}"
                                 FontFamily="{DynamicResource Font.UI}"
                                 FontSize="{DynamicResource Font.Size.Body}"
                                 Checked="OnThemeChanged" Tag="Light" />
                    <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme"
                                 Margin="10,3,10,8"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 FontFamily="{DynamicResource Font.UI}"
                                 FontSize="{DynamicResource Font.Size.Body}"
                                 Checked="OnThemeChanged" Tag="Dark" />

                    <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}"
                            Margin="6,4" />

                    <TextBlock Text="LOG" Style="{StaticResource SectionLabel}"
                               Margin="10,6,0,6" />
                    <CheckBox Content="Show log panel" Margin="10,3,10,10"
                              Foreground="{DynamicResource Brush.Text.Primary}"
                              FontFamily="{DynamicResource Font.UI}"
                              FontSize="{DynamicResource Font.Size.Body}"
                              IsChecked="{Binding Log.IsExpanded, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================================ BODY ================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="380" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- Rail. Selected state is an accent bar, not a border.
                 These were dead placeholders; each now switches the panel beside it. A
                 button that visibly does nothing is worse than one that says why. -->
            <Border Grid.Column="0" Width="52"
                    Background="{DynamicResource Brush.Surface.Base}">
                <StackPanel Margin="6,10,6,0">
                    <RadioButton x:Name="RailChanges" Style="{StaticResource RailButton}"
                                 IsChecked="True" Tag="Changes"
                                 Content="{DynamicResource Icon.Document}"
                                 Checked="OnRailChanged"
                                 ToolTip="Changed files — everything git reports as modified" />
                    <RadioButton x:Name="RailGit" Style="{StaticResource RailButton}"
                                 Tag="Git"
                                 Content="{DynamicResource Icon.Link}"
                                 Checked="OnRailChanged"
                                 ToolTip="Git — staging, commit, pull and push" />
                    <RadioButton x:Name="RailSync" Style="{StaticResource RailButton}"
                                 Tag="Sync"
                                 Content="{DynamicResource Icon.Sync}"
                                 Checked="OnRailChanged"
                                 ToolTip="PLC sync — export and import between the project and its text mirror" />
                </StackPanel>
            </Border>

            <!-- Left panel. One card; the rail swaps its contents. -->
            <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Base}"
                    Margin="8,8,0,8" CornerRadius="{DynamicResource Radius.Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,12,8">
                        <TextBlock Style="{StaticResource SectionLabel}"
                                   Text="{Binding PanelTitle}" />
                        <Border HorizontalAlignment="Right"
                                x:Name="ChangeCountBadge"
                                Background="{DynamicResource Brush.Accent.Muted}"
                                CornerRadius="9" Padding="8,1" MinWidth="22">
                            <TextBlock Text="{Binding Changes.Count}"
                                       HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Accent.Default}" />
                        </Border>
                    </Grid>

                    <!-- GIT: not built yet. An empty state that explains what will live
                         here beats a blank panel, which reads as a bug. -->
                    <Border x:Name="GitPanel" Visibility="Collapsed" Padding="20,8,20,20">
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{DynamicResource Icon.Link}"
                                       FontFamily="{DynamicResource Font.Icon}" FontSize="26"
                                       Foreground="{DynamicResource Brush.Text.Disabled}"
                                       Margin="0,10,0,12" />
                            <TextBlock Text="Git panel"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Subtitle}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       Margin="0,0,0,8" />
                            <TextBlock TextWrapping="Wrap"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Text="Not built yet. This will hold staging, the commit message box, and pull / push / fetch / stash." />
                            <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Disabled}"
                                       Text="The underlying git client already supports all of it — only the panel is missing." />
                        </StackPanel>
                    </Border>

                    <!-- PLC SYNC: the feature Versio exists for. Real scan, real toolchain
                         probe, no sample data. -->
                    <Border x:Name="SyncPanel" Visibility="Collapsed" Padding="14,0,12,12">
                        <DockPanel>
                            <!-- Toolchain state. Its absence is reported, not thrown: a repo
                                 full of CODESYS projects is still a perfectly usable git repo
                                 on a machine without CODESYS. -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource Brush.Surface.Sunken}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Padding="10,8" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource Brush.Status.Deleted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Sync.ToolchainAvailable}"
                                                                     Value="True">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource Brush.Status.Added}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Sync.VendorName}"
                                                   FontFamily="{DynamicResource Font.UI}"
                                                   FontSize="{DynamicResource Font.Size.Body}"
                                                   FontWeight="{DynamicResource Font.Weight.Medium}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Sync.ToolchainState}"
                                               TextWrapping="Wrap" Margin="15,3,0,0"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </StackPanel>
                            </Border>

                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Sync.Summary}" TextWrapping="Wrap"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Body}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />

                                <!-- The three actions, in the order they are used: track a
                                     project, export it, clear a failure if one happened.
                                     Each disables itself when it cannot apply, and the
                                     sentence above says why. -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Track project"
                                            Style="{StaticResource AccentButton}"
                                            Command="{Binding Sync.AdoptCommand}" />
                                    <Button Content="Export now" Margin="6,0,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding Sync.ExportCommand}" />
                                    <Button Content="Rescan" Margin="6,0,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding Sync.RescanCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- The direction lock, in plain English. Without this the lock
                                 is invisible magic that blocks the user with no explanation
                                 (plan section 9.5). -->
                            <Border DockPanel.Dock="Top"
                                    Background="{DynamicResource Brush.Surface.Sunken}"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Padding="10,8" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sync.LockState}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Sync.LockState}" TextWrapping="Wrap"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <Button Content="Acknowledge failure"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding Sync.AcknowledgeCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Heartbeat. A CODESYS launch is 17-31 s with nothing on screen
                                 to show for it, and silence is indistinguishable from a hang. -->
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Sync.Activity}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Status.Modified}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sync.Activity}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock DockPanel.Dock="Top" Text="PROJECTS"
                                       Style="{StaticResource SectionLabel}" Margin="0,4,0,6" />

                            <ListBox ItemsSource="{Binding Sync.Projects}"
                                     SelectedItem="{Binding Sync.SelectedProject}"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource RowItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="260">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{DynamicResource Font.UI}"
                                                           FontSize="{DynamicResource Font.Size.Body}"
                                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                                <TextBlock Text="{Binding Folder}"
                                                           FontFamily="{DynamicResource Font.Mono}"
                                                           FontSize="{DynamicResource Font.Size.Caption}"
                                                           Foreground="{DynamicResource Brush.Text.Disabled}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding State}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       FontSize="{DynamicResource Font.Size.Caption}"
                                                       Foreground="{Binding BrushKey,
                                                           Converter={StaticResource ResourceKey}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <ListBox x:Name="ChangesList" ItemsSource="{Binding Changes}"
                             SelectedItem="{Binding SelectedChange}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               FontWeight="{DynamicResource Font.Weight.Semibold}"
                                               Foreground="{DynamicResource Brush.Status.Modified}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="2" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Diff -->
            <Border Grid.Column="3" Background="{DynamicResource Brush.Surface.Base}"
                    Margin="0,8,8,8" CornerRadius="{DynamicResource Radius.Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,12,8">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="DIFF" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Mono}"
                                   Text="{Binding SelectedChange.Path}"
                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    </Grid>
                    <views:DiffView DiffText="{Binding SelectedDiff}"
                                    FilePath="{Binding SelectedChange.Path}"
                                    Margin="6,0,6,8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </views:DiffView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================= LOG PANEL ============================= -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Base}"
                Margin="8,0,8,8" CornerRadius="{DynamicResource Radius.Card}">
            <DockPanel>
                <!-- Header is always visible; only the list collapses. -->
                <Grid DockPanel.Dock="Top" Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="LogToggle"
                            Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Command="{Binding Log.ToggleExpandedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LogChevron" Style="{StaticResource IconText}"
                                       FontSize="11" Margin="0,0,8,0"
                                       Text="{DynamicResource Icon.ChevronDown}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="LOG" Style="{StaticResource SectionLabel}" />
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Sunken}"
                            CornerRadius="9" Padding="8,1" VerticalAlignment="Center"
                            Margin="4,0,0,0">
                        <TextBlock Text="{Binding Log.Rows.Count}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </Border>

                    <TextBox Grid.Column="3" Width="240" Margin="0,0,6,0"
                             Style="{StaticResource FlatTextBox}"
                             Tag="Filter messages or categories…"
                             Text="{Binding Log.Filter, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="4" Style="{StaticResource IconButton}"
                            Content="{DynamicResource Icon.Pause}"
                            Command="{Binding Log.TogglePauseCommand}"
                            ToolTip="Pause auto-scroll" />

                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Margin="0,0,6,0"
                            Content="{DynamicResource Icon.Delete}"
                            Command="{Binding Log.ClearCommand}"
                            ToolTip="Clear the view — the log file keeps everything" />
                </Grid>

                <ListBox x:Name="LogList" Height="200"
                         ItemsSource="{Binding Log.Rows}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource LogRowItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}"
                                           Style="{StaticResource Mono}"
                                           Foreground="{DynamicResource Brush.Text.Disabled}" />
                                <TextBlock Grid.Column="1" Text="{Binding Level}"
                                           Style="{StaticResource Mono}"
                                           Foreground="{DynamicResource Brush.Status.Neutral}" />
                                <TextBlock Grid.Column="2" Text="{Binding Category}"
                                           Style="{StaticResource Mono}"
                                           Foreground="{DynamicResource Brush.Accent.Default}" />
                                <TextBlock Grid.Column="3" Text="{Binding Message}"
                                           Style="{StaticResource Mono}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================= STATUS BAR ============================= -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.Base}" Padding="16,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{DynamicResource Brush.Status.Added}" />
                    <TextBlock Text="{Binding StatusSummary}" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Mono}"
                           Text="{Binding RepositoryPath}"
                           Foreground="{DynamicResource Brush.Text.Disabled}" />
            </Grid>
        </Border>
    </Grid>
</Window>
