<Window x:Class="Versio.App.Views.BranchDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete branches" Width="540" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface.Base}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- No private resource dictionary, deliberately. App.xaml merges the stylesheet once into
         Application.Resources and ThemeManager swaps the palette inside THAT dictionary; a copy
         here would give this window its own palette the theme buttons never reach. Both
         converters this uses live in the stylesheet for the same reason. -->

    <Border Padding="18">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                       FontFamily="{DynamicResource Font.UI}"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Text="Choose the branches to delete." />

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <!-- Live, and the thing somebody reads before pressing. A confirmation that
                     says "12 branches" without saying which is not a confirmation. -->
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />

                <!-- Shown only when something unmerged is chosen. Force is a separate,
                     deliberate acknowledgement rather than an escalation the code makes on its
                     own: git refuses an unmerged branch and that refusal is information. -->
                <CheckBox x:Name="ForceCheck" Margin="0,10,0,0" Visibility="Collapsed"
                          Style="{StaticResource MenuCheck}"
                          Foreground="{DynamicResource Brush.Status.Deleted}"
                          Content="Yes, delete work that is not merged" />

                <CheckBox x:Name="RemoteCheck" Margin="0,8,0,0"
                          Style="{StaticResource MenuCheck}"
                          Content="Delete from the remote as well" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
                            Style="{StaticResource GhostButton}" />
                    <Button x:Name="DeleteButton" Content="Delete" Margin="8,0,0,0"
                            Style="{StaticResource AccentButton}"
                            ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
            </StackPanel>

            <!-- Merged / not merged is the most useful column here: it is the difference
                 between deleting a tidy-up and deleting somebody's afternoon. -->
            <ListBox x:Name="BranchList" Margin="0,12,0,0" MaxHeight="340"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource RowItem}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource MenuCheck}"
                                      IsEnabled="{Binding CanSelect}"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="{Binding Blocked}"
                                      IsChecked="{Binding IsChosen, Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />

                            <TextBlock Grid.Column="2" Text="{Binding WhereText}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Disabled}" />

                            <TextBlock Grid.Column="3" Text="{Binding MergedText}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{Binding MergedBrushKey,
                                           Converter={StaticResource ResourceKey}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
