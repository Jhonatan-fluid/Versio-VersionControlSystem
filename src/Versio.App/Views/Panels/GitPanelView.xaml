<!--
    GIT: the commit message, the one changes list, and the remote operations.

    Every button here goes dead while any operation runs - see ShellViewModel.Ready. Git
    serialises some of this itself with index and ref locks, but not a push racing a commit,
    and not a commit landing while the gate's export is still writing the mirror.

    WHAT STAYS ON THE INSTANCE RATHER THAN HERE. MainWindow owns where this sits and whether
    it is showing - Grid.Row, x:Name and Visibility are set there, by the rail. Setting them
    here as well would mean two files deciding the same thing.

    The DataContext is inherited, so the bindings below read the same ShellViewModel they read
    when this markup lived in MainWindow.xaml. ChangesList is named inside this control's own
    scope now, so a test reaches it through the panel rather than through the window - see
    GitPanelGeometryTests.Inside.
-->
<UserControl x:Class="Versio.App.Views.Panels.GitPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Merged here rather than relied on from MainWindow: a UserControl resolves a
                 StaticResource against itself and its own merges, never against the Window
                 hosting it. See RowTemplates.xaml. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../RowTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                ONE LIST, ONE MENU.

                Staging is no longer a visible verb: the checkbox says what the next commit
                or discard applies to, and double-click toggles that box. The body is still
                ChangeRowTemplate, shared with the history panel's commit-file list.

                THE MENU HANGS OFF THE ROW'S OWN GRID, which is the shape the project tree
                uses and is not a style choice: a ContextMenu inherits its DataContext from
                the element it is set on, so every entry acts on the row that was
                right-clicked. Hanging it off the ListBox instead would make it act on the
                SELECTION - and WPF does not select a row on right-click.

                Discard acts on the CLICKED ROW, never on the ticks. The button above the
                list already acts on the ticked set; someone who ticked three files and then
                right-clicks a fourth must not get their three swept in.
            -->

            <!--
                DOUBLE-CLICK HANGS OFF THE ROW CONTAINER, NOT THE LIST.

                Control.MouseDoubleClick is registered with RoutingStrategy.DIRECT, so it
                does not bubble — a handler on the ListBox never sees a click on a row.
                Attached to the container, sender IS the row.
            -->
            <Style x:Key="ChangeRowContainer" TargetType="ListBoxItem"
                   BasedOn="{StaticResource ChangeRowItem}">
                <EventSetter Event="MouseDoubleClick" Handler="OnChangeRowDoubleClick" />
            </Style>

            <DataTemplate x:Key="PendingRowTemplate">
                <Grid>
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <!-- Still the only entry that destroys work nothing else has a
                                 copy of, and it still goes through DiscardRowsAsync - which
                                 names every file it will touch and asks first. The
                                 ellipsis says a question is coming. -->
                            <MenuItem Header="Discard changes…" Click="OnDiscardRow" />
                            <Separator />
                            <MenuItem Header="Reveal in Explorer" Click="OnRevealRow" />
                            <MenuItem Header="Copy path" Click="OnCopyRowPath" />
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <ContentPresenter Content="{Binding}"
                                      ContentTemplate="{StaticResource StageRowTemplate}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Ctrl+Shift+P pushes (GP-L §10.6), from anywhere in the panel — including the commit
         box, whose own KeyDown handler takes Ctrl+Enter and lets everything else bubble.
         Scoped to this panel rather than the window: push is this panel's verb, and a
         shortcut that fired while somebody was typing in the log filter would be spooky.
         The command's own CanExecute still gates it, so the key does nothing a dead button
         would not. -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl+Shift" Key="P"
                    Command="{Binding Remote.PushCommand}" />
    </UserControl.InputBindings>

    <Border Padding="14,0,12,12">
            <DockPanel>
                <!-- GIT ITSELF IS MISSING.

                     First, above everything, because nothing below it can work:
                     every operation in this panel is git.exe resolved from PATH.
                     A first-class state rather than a toast, because it does not
                     go away and there is nothing else to look at.

                     Bound to GitIsMissing, which is false until the launch probe
                     has actually answered - GitPresence.Unknown is deliberately
                     not Missing, or this banner would flash on every launch
                     during the moment before the probe returns. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding GitIsMissing,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="GIT NOT AVAILABLE"
                                   Style="{StaticResource SectionLabel}"
                                   Foreground="{DynamicResource Brush.Status.Deleted}" />
                        <TextBlock Text="{Binding GitPresenceExplanation}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                </Border>

                <!-- COMMIT IDENTITY.

                     git commit refuses without user.name and user.email, and in
                     Versio it refuses AFTER the export gate has spent 17-31 s
                     running CODESYS - the gate goes first so the mirror is never
                     committed stale. A long wait followed by git's nine-line
                     lecture is the worst first run this app can produce, and
                     two config reads at open remove it entirely.

                     Persistent rather than a toast: it is a state to be fixed,
                     not an event that happened. It disappears the moment git can
                     name a committer. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding Auth.IdentityIsMissing,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Auth.IdentityExplanation}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Status.Modified}" />

                        <TextBox Style="{StaticResource FlatTextBox}"
                                 Margin="0,8,0,0" Tag="Your name"
                                 Height="{DynamicResource Size.Control.Compact}"
                                 Text="{Binding Auth.IdentityName,
                                     UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Style="{StaticResource FlatTextBox}"
                                 Margin="0,6,0,0" Tag="you@example.com"
                                 Height="{DynamicResource Size.Control.Compact}"
                                 Text="{Binding Auth.IdentityEmail,
                                     UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Advisory, never a gate: git accepts anything non-empty,
                             and engineer@plc is a perfectly good intranet address.
                             Refusing it would make Versio stricter than the git it
                             is driving. -->
                        <TextBlock Text="That does not look like an email address."
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                   Visibility="{Binding Auth.IdentityEmailLooksWrong,
                                       Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Save" Style="{StaticResource AccentButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Command="{Binding Auth.SaveIdentityCommand}" />
                            <!-- Local by default. A work machine carrying a personal
                                 global identity is a common and annoying way to
                                 attribute commits to the wrong person. -->
                            <CheckBox Content="Every repository" Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource MenuCheck}"
                                      ToolTip="Write to the global git config as well as this repository"
                                      IsChecked="{Binding Auth.IdentityGlobal}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CONFLICTS, AND THE WAY OUT OF A DIVERGED BRANCH.

                     First, above everything, because nothing else in the panel can
                     proceed while the tree is mid-merge: git refuses the commit,
                     and the sync engine refuses both directions
                     (SyncVerdict.BlockedByConflict).

                     The DETECTION is not here. IConflictProbe and the sync
                     narrative already own it, and a second detection path would
                     give the panel and the engine two ways to disagree about the
                     same tree. This binds to what git reported.

                     The conflicted files are their OWN section rather than being
                     folded into staged or not-staged. An unmerged file is reported
                     in both of git's columns and is really in neither state - it is
                     stuck - so putting it in either list would misrepresent what
                     git will do with it. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding ShowsConflicts,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ConflictHeadline}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Status.Conflict}" />

                        <ListBox ItemsSource="{Binding Conflicted}"
                                 SelectedItem="{Binding SelectedConflict}"
                                 Background="Transparent" BorderThickness="0"
                                 Margin="0,6,0,0" MaxHeight="120"
                                 ItemContainerStyle="{StaticResource ChangeRowItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemTemplate="{StaticResource ChangeRowTemplate}" />

                        <!-- "Ours" and "theirs" swap meaning under a rebase - git
                             replays your commits onto the upstream - so the labels
                             say which BRANCH rather than which pronoun. Nobody
                             should have to remember that rule to press a button. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Keep mine" Padding="8,2"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Take this branch's version of the selected file"
                                    Command="{Binding ResolveCommand}"
                                    CommandParameter="True" />
                            <Button Content="Keep theirs" Padding="8,2" Margin="6,0,0,0"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Take the incoming version of the selected file"
                                    Command="{Binding ResolveCommand}"
                                    CommandParameter="False" />

                            <!-- The way back. Offering an operation that can stop
                                 half-done without offering the undo is how somebody
                                 ends up in a state they cannot describe.

                                 Only while there IS an operation. Conflicts from a
                                 stash apply have nothing behind them to abandon -
                                 the section shows for them since the 2026-10-24
                                 review's item 30 - and a disabled Abandon there
                                 would promise a way back that does not exist. -->
                            <Button Content="Abandon" Padding="8,2" Margin="6,0,0,0"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Style="{StaticResource GhostButton}"
                                    Foreground="{DynamicResource Brush.Status.Deleted}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Put the branch back where it was before this started"
                                    Visibility="{Binding IsMidMerge,
                                        Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding AbortMergeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- STASHES, ONLY WHILE THERE ARE ANY.

                     The design the withdrawn one owed. The first version was six
                     permanent controls in the panel's narrowest column for
                     something reached a few times a month; this is the inversion —
                     ZERO permanent controls, a section that exists exactly while
                     `git stash list` has rows, the same rule the conflicts section
                     follows one border up. No "save" button: the auto-stash takes
                     stashes where Versio's flows need one, and the deliberate case
                     belongs to a terminal. See StashRow for the rest. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding HasStashes,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="STASHES"
                                   Style="{StaticResource SectionLabel}" />

                        <ItemsControl ItemsSource="{Binding Stashes}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}"
                                                       FontFamily="{DynamicResource Font.UI}"
                                                       FontSize="{DynamicResource Font.Size.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                                            <TextBlock Text="{Binding Detail}"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       FontSize="{DynamicResource Font.Size.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.Disabled}" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Apply" Padding="8,2"
                                                Margin="8,0,0,0"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                Style="{StaticResource GhostButton}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Put these changes back into the working tree. The stash stays until you drop it."
                                                Command="{Binding ApplyCommand}" />
                                        <Button Grid.Column="2" Content="Drop" Padding="8,2"
                                                Margin="6,0,0,0"
                                                Height="{DynamicResource Size.Control.Compact}"
                                                Style="{StaticResource GhostButton}"
                                                Foreground="{DynamicResource Brush.Status.Deleted}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Delete this stash, after a confirmation naming it"
                                                Command="{Binding DropCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- THE DIVERGED BRANCH'S ONLY EXIT.

                     Until this existed the panel's own badge said "diverged, pull
                     first" and a fast-forward-only pull refuses a diverged branch by
                     design, so the advice pointed at a button that could not work and
                     the way out was a terminal.

                     Fast-forward-only stays the default and this is not a relaxation
                     of it: that default exists because auto-merging native CODESYS XML
                     produces a file nobody reviewed. What changes is that the user
                     can ask for one BY NAME, having been told what it means.

                     Rebase leads, because it is the usual answer for a feature
                     branch and it keeps the exported history linear - which matters
                     more here than in most repositories, since the diff being read
                     is generated text. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding Remote.Standing.IsDiverged,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Remote.Standing.Headline}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Status.Modified}" />

                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="A fast-forward cannot resolve this. Replaying your commits on top keeps the history linear; merging records both sides." />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Rebase onto the remote"
                                    Style="{StaticResource AccentButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Replay your commits on top of the remote's"
                                    Command="{Binding ReconcileCommand}"
                                    CommandParameter="True" />
                            <Button Content="Merge" Margin="6,0,0,0" Padding="8,2"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Bring the remote's commits in and record both sides"
                                    Command="{Binding ReconcileCommand}"
                                    CommandParameter="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CREDENTIALS.

                     Versio implements no login and must not start. Driving git.exe
                     is what makes Git Credential Manager, SSH agents, 2FA and
                     corporate proxies behave exactly as they do in the engineer's
                     own terminal; storing a token here would mean owning a secret
                     store, a rotation story and a breach story, and a
                     username/password box cannot do 2FA or SSO. So the job is
                     detect, explain, hand off - never store.

                     The Sign in button is bound to CanSignIn rather than to the
                     banner's own visibility, and that is the important part. A 403
                     means the credential WORKED and the account lacks access, and
                     an SSH remote has no credential helper at all. Both read like
                     authentication failures; offering to sign in again on either
                     is offering a button that cannot work, and on the 403 it is a
                     loop that cannot terminate. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding Auth.NeedsAttentionForAuth,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Auth.AuthExplanation}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Status.Modified}" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Sign in" Style="{StaticResource AccentButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Hand off to your git credential helper. Versio never sees the credential."
                                    Command="{Binding Auth.SignInCommand}"
                                    Visibility="{Binding Auth.CanSignIn,
                                        Converter={StaticResource BoolToVisibility}}" />

                            <!-- The button no git GUI offers, and the one that
                                 fixes the failure people actually hit: an expired
                                 token the helper keeps cheerfully returning, so
                                 every push fails identically and nothing inside the
                                 app changes it. -->
                            <Button Content="Forget credential" Margin="6,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Erase the saved credential for this host, so the next fetch asks for a new one"
                                    Command="{Binding Auth.SignOutCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Branch and divergence. The remote state is why somebody opens
                     this panel, so it leads. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Icon.Link}"
                                       Style="{StaticResource IconText}"
                                       FontSize="12" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding BranchName}"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       FontWeight="{DynamicResource Font.Weight.Medium}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <!-- One button per direction, because each opens its own
                                 preview: what a push would send, what a pull would
                                 bring. The combined "↑1 ↓2" glyph survives in the
                                 branch dropdown, where compact is right; here each
                                 half answers a different question. -->
                            <Button Content="{Binding Remote.AheadLabel}" Margin="10,0,0,0"
                                    Style="{StaticResource GhostButton}" Padding="6,0"
                                    Height="18" FontFamily="{DynamicResource Font.Mono}"
                                    FontSize="{DynamicResource Font.Size.Caption}"
                                    Foreground="{DynamicResource Brush.Accent.Default}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="See the commits a push would send. Escape closes the preview."
                                    Command="{Binding Remote.ShowOutgoingCommand}"
                                    Visibility="{Binding Remote.HasAhead,
                                        Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{Binding Remote.BehindLabel}" Margin="4,0,0,0"
                                    Style="{StaticResource GhostButton}" Padding="6,0"
                                    Height="18" FontFamily="{DynamicResource Font.Mono}"
                                    FontSize="{DynamicResource Font.Size.Caption}"
                                    Foreground="{DynamicResource Brush.Accent.Default}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="See the commits a pull would bring, and which objects they touch. Escape closes the preview."
                                    Command="{Binding Remote.ShowIncomingCommand}"
                                    Visibility="{Binding Remote.HasBehind,
                                        Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- WHERE PUSH GOES (GP-L §10.3). "origin · github.com/org/repo",
                             because the word "push" is meaningless without it and on a
                             machine with several remotes it is a real question. Hidden
                             with no remote — that is the standing sentence's line. -->
                        <TextBlock Text="{Binding RemoteDisplay}" Margin="0,2,0,0"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RemoteDisplay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RemoteDisplay}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- WHERE THIS BRANCH STANDS, IN WORDS.

                             The arrows above are compact and ask the reader to
                             remember which one means somebody else moved. This
                             says it. Three states used to be indistinguishable
                             here: in sync, no upstream and no remote all rendered
                             as an empty string, so a branch nobody else could see
                             looked exactly like a branch that was fully pushed.

                             The colour is chosen by RemoteStanding, not here:
                             amber only when doing nothing has a cost. -->
                        <TextBlock Text="{Binding Remote.Standing.Headline}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{Binding Remote.Standing.BrushKey,
                                       Converter={StaticResource ResourceKey}}" />

                        <!-- THE WAY OUT, BESIDE THE SENTENCE THAT DESCRIBES THE TRAP (UX-10).

                             §9e argued for exactly this and only half of it was built: the
                             amber sentence landed, the escape did not. A detached HEAD is
                             reached from OUTSIDE the app - a `git checkout <commit>` in a
                             terminal, a CI tool; nothing inside Versio detaches HEAD -
                             so the reader is somebody who did not mean to be here and does not
                             know the vocabulary. Telling them their next commit is reachable
                             only from the reflog and then leaving the remedy in the top bar's
                             "+" is the menu §9e was arguing against.

                             It is the only standing whose action is not already on this card.
                             Push, publish, pull and the divergence pair all have their buttons
                             above; this one had a warning and no door.

                             The name is not pre-filled. Worth a moment's thought and not worth
                             blocking on: any default good enough to accept unread would have to
                             know what the work IS, and a wrong-but-plausible branch name is
                             harder to notice than an empty box. -->
                        <Button Content="Put this on a branch…"
                                x:Name="PutOnBranchButton"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                Style="{StaticResource AccentButton}"
                                Height="{DynamicResource Size.Control.Compact}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Create a branch here and switch to it, so this work is kept"
                                Command="{Binding PutOnBranchCommand}"
                                Visibility="{Binding Remote.Standing.IsDetached,
                                    Converter={StaticResource BoolToVisibility}}" />

                        <!-- WHAT THE ARROWS STAND FOR, LISTED (GP-K §9d).

                             Opened by the ↑/↓ buttons above, closed by clicking the
                             same one again, and it follows the counts: reloaded when
                             they move, gone when its direction reaches zero. The
                             objects line above the commits is the pull side's whole
                             point — changes arriving under an export tree will be
                             imported into a .project, and which objects are about to
                             move is a question for BEFORE the pull.

                             Capped and scrolling: fifty commits behind is real on a
                             branch someone left for a month, and an uncapped list
                             would push the staging lists off the panel. -->
                        <Border Margin="0,6,0,0" Padding="8,6"
                                Background="{DynamicResource Brush.Surface.Base}"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Visibility="{Binding Remote.IsPreviewOpen,
                                    Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Remote.PreviewTitle}"
                                           TextWrapping="Wrap"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />

                                <TextBlock Text="{Binding Remote.PreviewObjects}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           FontWeight="{DynamicResource Font.Weight.Semibold}"
                                           Foreground="{DynamicResource Brush.Text.Primary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Remote.PreviewObjects}"
                                                             Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ScrollViewer MaxHeight="150" Margin="0,4,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Remote.PreviewCommits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="{Binding ShortId}"
                                                               Margin="0,0,8,0"
                                                               FontFamily="{DynamicResource Font.Mono}"
                                                               FontSize="{DynamicResource Font.Size.Caption}"
                                                               Foreground="{DynamicResource Brush.Text.Disabled}" />
                                                    <TextBlock Text="{Binding Age}"
                                                               DockPanel.Dock="Right"
                                                               Margin="8,0,0,0"
                                                               FontFamily="{DynamicResource Font.UI}"
                                                               FontSize="{DynamicResource Font.Size.Caption}"
                                                               Foreground="{DynamicResource Brush.Text.Disabled}" />
                                                    <TextBlock Text="{Binding Subject}"
                                                               FontFamily="{DynamicResource Font.UI}"
                                                               FontSize="{DynamicResource Font.Size.Caption}"
                                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Compact: three buttons inside a card that is itself
                             inside a 380 px panel. At the full 32 px they set the
                             height of the whole card and pushed the file lists
                             down for nothing. -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                        <!-- A WrapPanel, AND IT FIXES SOMETHING THAT PREDATES THIS ROW.

                             Measured at the panel's MinWidth of 260 px, where the row is
                             206 px: on a DIVERGED branch the captions carry their counts, and
                             Fetch + "Pull (12)" + "Push (127)" want 207 px with their margins.
                             The three verbs alone were already a pixel over before anything
                             was added beside them - a StackPanel hands every child the width
                             it asks for and then overflows, so Push simply drew past the row.

                             Wrapping is the honest answer for a row of fixed-width verbs whose
                             captions grow with the repository's state. It costs a second line
                             of height in exactly the case that could not fit on one, and the
                             lists below give up 24 px only while a branch is diverged at the
                             narrowest panel width. Nothing ever overlaps. -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal">
                            <!-- ToolTipService.ShowOnDisabled on every one of
                                 these. A dead button with no reason is what sends
                                 somebody to the command line, which is the thing
                                 this panel exists to avoid, and WPF hides tooltips
                                 on disabled controls unless told otherwise. The
                                 explanation would be invisible exactly when it is
                                 wanted. -->
                            <Button Content="Fetch" Style="{StaticResource GhostButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Ask the remote what has changed, without touching your files"
                                    Command="{Binding Remote.FetchCommand}" />
                            <Button Content="{Binding Remote.PullLabel}" Margin="6,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{Binding Remote.Standing.Headline}"
                                    Command="{Binding Remote.PullCommand}" />

                            <!-- Push and Publish swap rather than sharing a button.
                                 A plain push on a branch with no upstream fails
                                 outright, so they are different operations, and one
                                 control meaning both would have a failure mode that
                                 only appears sometimes. -->
                            <Button Content="{Binding Remote.PushLabel}" Margin="6,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{Binding Remote.PushTooltip}"
                                    Command="{Binding Remote.PushCommand}"
                                    Visibility="{Binding Remote.ShowPush,
                                        Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Publish branch" Margin="6,0,0,0"
                                    Style="{StaticResource AccentButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Push this branch to the remote and start tracking it"
                                    Command="{Binding Remote.PublishCommand}"
                                    Visibility="{Binding Remote.ShowPublish,
                                        Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>

                        <!-- A GLYPH, NOT A WORD, AND THAT IS THE WHOLE COST OF MOVING IT HERE.

                             Measured at the panel's own MinWidth of 260 px: the row is 206 px
                             and Fetch, Pull and Push need 151 of it with their margins. That
                             leaves 49 px, and `Branch ⌄` wanted 68 - so Push sat underneath
                             it. With real counts on the labels ("Pull (12)", "Push (127)")
                             there is less again, and GP-H had already measured a fourth button
                             on this row overflowing outright at 380.

                             So the container gives way rather than the verbs. Fetch, Pull and
                             Push are the things somebody presses all day; this is a lid on a
                             box opened a few times a month, and it is the only control here
                             that is not itself an action.

                             It loses its caption to do it, which is a real cost - "a caption
                             says what will happen" is why it was not called `More…`. What
                             replaces it is the same bargain every icon in the top bar makes:
                             the tooltip carries the meaning, and it now NAMES THE ENTRIES
                             rather than describing the button, so the answer to "what is
                             behind this" arrives on hover instead of on click.

                             ButtonBase, not Button: GhostButton targets ButtonBase so a
                             ToggleButton may wear it, and IconButton targets Button and would
                             throw at construction. That is the crash MainWindowTests exists
                             for. -->
                        <ToggleButton Grid.Column="1" x:Name="BranchMenuButton"
                                      Padding="7,2" Margin="6,0,0,0"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Right"
                                      Style="{StaticResource GhostButton}"
                                      Height="{DynamicResource Size.Control.Compact}"
                                      AutomationProperties.Name="Branch actions"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="Branch actions — merge a branch in, or delete branches">
                            <TextBlock Text="{DynamicResource Icon.ChevronDown}"
                                       Style="{StaticResource IconText}" FontSize="11" />
                        </ToggleButton>

                        <Popup x:Name="BranchMenuPopup"
                               PlacementTarget="{Binding ElementName=BranchMenuButton}"
                               Placement="Bottom" HorizontalOffset="-120" VerticalOffset="4"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{Binding IsChecked, ElementName=BranchMenuButton,
                                   Mode=TwoWay}">
                            <!-- A Popup rather than a ContextMenu: the log panel's category
                                 filter already does exactly this, so the shape and its theming
                                 are precedented. A popup carries its own HWND and inherits
                                 none of the window's palette, which is why the Border paints
                                 itself from the tokens rather than relying on anything. -->
                            <Border Background="{DynamicResource Brush.Surface.Raised}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1" Padding="4" Width="220"
                                    CornerRadius="{DynamicResource Radius.Card}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4"
                                                      Opacity="0.24" Direction="270" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Content="{Binding MergeBranchLabel}"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,4" Margin="0,0,0,2"
                                            Style="{StaticResource GhostButton}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Bring another branch's commits into this one"
                                            Command="{Binding MergeBranchCommand}"
                                            Click="OnBranchMenuItem" />

                                    <Border Height="1" Margin="4,3"
                                            Background="{DynamicResource Brush.Border.Subtle}" />

                                    <!-- Destructive last and separated, the same order the
                                         delete dialog itself uses for its force checkbox. -->
                                    <Button Content="Delete branches…"
                                            HorizontalContentAlignment="Left"
                                            Padding="8,4"
                                            Style="{StaticResource GhostButton}"
                                            Foreground="{DynamicResource Brush.Status.Deleted}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Remove branches from this machine, and optionally from the remote"
                                            Command="{Binding DeleteBranchesCommand}"
                                            Click="OnBranchMenuItem" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        </Grid>

                        <!-- ITS OWN ROW, AND NOT BESIDE FETCH.

                             GP-H already measured what a fourth button on that row
                             does: it overflows the 380 px panel outright. And it
                             does not belong there anyway - fetch, pull and push are
                             one rhythm somebody repeats all day, and raising a
                             merge request is a deliberate act that happens once per
                             branch. Different weight, different row.

                             COLLAPSED, NOT DISABLED, when the forge is unknown. A
                             self-hosted GitLab is unidentifiable from its URL and a
                             local-only repository has no forge at all - and neither
                             is a problem the user can fix from this panel, so a
                             permanently dead control with a tooltip about repo.json
                             would be clutter on every repository that will never
                             have one.

                             The caption is bound because it means three different
                             things: create one, go to the one that exists, or open
                             the list on a forge that cannot tell us which. It is
                             also in the forge's own vocabulary - GitLab has merge
                             requests, the other four have pull requests.

                             LEFT-ALIGNED, like the verbs above it. It was stretched
                             across the card with its caption centred, which on a clean
                             panel - where nothing else is below it - read as a line of
                             grey text floating in the middle rather than as a button.
                             Seen in the running window on 2026-09-21. -->
                        <Button Content="{Binding MergeRequest.Label}"
                                Margin="0,8,0,0" HorizontalAlignment="Left" Padding="10,0"
                                Style="{StaticResource GhostButton}"
                                Height="{DynamicResource Size.Control.Compact}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding MergeRequestTooltip}"
                                Command="{Binding OpenMergeRequestCommand}"
                                Visibility="{Binding MergeRequest.IsVisible,
                                    Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Commit box. Ctrl+Enter commits, because reaching for the
                     mouse after typing a message is the one interaction here
                     that happens dozens of times a day. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="COMMIT MESSAGE"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource SectionLabel}" />
                        <!-- Coloured at 50 and 72 (GP-L §10.5): quiet inside the
                             convention, amber over it, red past git's own wrap.
                             The bare number was undecodable to anyone who did not
                             hover it. -->
                        <!-- And absent while there is no subject: a "0" over an empty box
                             measured nothing and read as a count of something. -->
                        <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                   AutomationProperties.Name="Subject length"
                                   Text="{Binding CommitSubjectLength}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{Binding CommitSubjectBrushKey,
                                       Converter={StaticResource ResourceKey}}"
                                   ToolTip="Subject length. The convention is 50 characters, hard limit 72.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CommitSubjectLength}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- What this commit is about to record, counted as OBJECTS.

                         "5 changed" is what git can say. "3 POUs, 1 GVL and 1 DUT
                         changed in RefrigeratorControl" is the sentence the
                         engineer would have written, and it is available only
                         because the export wrote the manifest beside the files.

                         It counts what the button will commit, not the working
                         tree - those differ the moment anything is staged, and a
                         line that disagreed with the caption under it would be
                         two controls describing one press.

                         Hidden rather than empty when nothing here belongs to a
                         PLC project: the rows are ordinary paths then, and the
                         list already says how many. -->
                    <TextBlock Text="{Binding ChangeSummaryLine}"
                               TextWrapping="Wrap" Margin="0,0,0,6"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Visibility="{Binding HasChangeSummary,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <!-- Padding carries the vertical inset: the template now honours Top,
                         and with the style's 10,0 the first line would kiss the border. -->
                    <TextBox x:Name="CommitMessageBox" Height="72"
                             Style="{StaticResource FlatTextBox}"
                             Tag="Summary of the change…"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Padding="10,8"
                             KeyDown="OnCommitMessageKeyDown"
                             Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- ONE BUTTON, TWO BEHAVIOURS, AND A CAPTION THAT SAYS WHICH.

                         "Commit & Push" is gone. Staging as a visible verb is gone too:
                         the button stages in the background after a preflight, and the
                         caption says Commit or Commit (N) according to the ticks.

                         ToolTipService.ShowOnDisabled because WPF hides a tooltip
                         on a disabled control by default, so the one moment the
                         explanation is wanted is the one moment it would be
                         missing. -->
                    <!-- A WrapPanel for the same reason the Fetch row is one: a row of
                         fixed-width verbs whose first caption grows with the repository's
                         state. "Commit (127)" beside Draft and Amend is real, and a
                         StackPanel would hand each child the width it asks for and let the
                         last one draw past the panel. -->
                    <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding Commit.Label}"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding CommitCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding CommitExplanation}" />

                        <!-- THE NEXT PRESS AFTER COMMIT, WHERE THE HAND ALREADY IS.

                             The same command, label and tooltip as the Push at the top
                             - one operation, two places, so nothing about it can drift.
                             The top one stays because Fetch, Pull and Push are one
                             rhythm. This one exists because pushing is what follows a
                             commit, and Push was only at the far end of the panel from
                             it (owner, 2026-10-03).

                             Same size as Commit and an accent, but HIDDEN until there are
                             commits to send: Remote.ReadyToPush. Not shown for Publish -
                             that is a different operation with its own button. -->
                        <Button Content="{Binding Remote.PushLabel}" Margin="8,0,0,0"
                                AutomationProperties.Name="Push committed work"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding Remote.PushCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding Remote.PushTooltip}"
                                Visibility="{Binding Remote.ReadyToPush,
                                    Converter={StaticResource BoolToVisibility}}" />

                        <!-- OFFERED, NEVER APPLIED, AND NEVER OVER TYPED WORDS.

                             The button goes dead the moment the box has anything
                             in it, so there is no press that can lose a
                             half-written message. An "are you sure" over
                             somebody's own sentence is a worse answer than not
                             offering the action; clearing the box offers it
                             again. -->
                        <Button Content="Draft" Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding DraftCommitMessageCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Fill the box with a subject built from the changed objects. Available while the box is empty." />

                        <!-- THE ONE HISTORY REWRITE THE APP OFFERS (UX-12).

                             Amend is the most-reached-for git verb after commit, and the
                             narrow case is a typo in the subject thirty seconds after
                             pressing the button. It is also history rewriting — so the
                             offer exists only while HEAD is unpushed, a rule this app can
                             enforce and a terminal cannot: Remote.HeadIsUnpushed carries
                             the derivation, and the flow re-verifies before rewriting.

                             HIDDEN, NOT DISABLED, on a pushed branch — that is the
                             ordinary state most of the day, and a permanently dead button
                             wearing a tooltip about history rewriting would be furniture.
                             While it IS offered and merely blocked (busy, mid-merge), the
                             disabled tooltip explains, same as every button here.

                             Message-only, deliberately: a bare amend sweeps the index
                             into the rewritten commit, so fixing a typo would silently
                             commit whatever was staged since. Content belongs in a new
                             commit, where the export gate can see it. -->
                        <Button Content="Amend" Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding AmendCommitCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Rewrite the last commit's message. Press with the box empty to load the current message first. Offered only while the commit is unpushed."
                                Visibility="{Binding Remote.HeadIsUnpushed,
                                    Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>

                    <!-- The most surprising rule in the tool, stated where the
                         decision is made rather than discovered afterwards - but
                         only when it is about to happen.

                         It used to be permanent, and a caption that says the same
                         thing on every refresh is read once and never again; this
                         codebase has already argued that out over a coverage line
                         that congratulated itself every time. The half about
                         pushing releasing the lock is on the Push button's own
                         tooltip, which is where somebody asks it. -->
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Status.Modified}"
                               Text="A stale PLC export runs before this commit, and is staged with it.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <!-- Not StalenessSummary: that also names a FAILED
                                         project, and a failed one is refused at commit, not
                                         exported before it. -->
                                    <DataTrigger Binding="{Binding Sync.HasUnexportedChanges}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Staged / unstaged.
                     Two columns, not one cell with a right-aligned button in it.
                     Sharing the cell is how "NOT STAGED" and "Discard" ended up
                     touching in a 380 px panel: a right-aligned child grows
                     leftwards across the label instead of pushing it, and neither
                     one knows the other is there. The label takes what is left and
                     trims; the buttons keep their width. -->
                <!--
                    ONE LIST. Staging is not a visible verb: the checkboxes pick
                    what the next commit or discard applies to, and git add
                    happens in the background after a preflight.
                -->
                <Grid>
                    <!-- ONE LINE INSTEAD OF AN EMPTY BOX (GP-L §10.2). -->
                    <TextBlock Text="Working tree clean — nothing to commit."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Body}"
                               Foreground="{DynamicResource Brush.Text.Disabled}"
                               Visibility="{Binding IsWorkingTreeClean,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkingTreeClean}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="60" />
                    </Grid.RowDefinitions>

                    <!-- FIND, AS A VEIL (UX-6). The project panel's box, same style, same
                         200 ms delay, same placeholder grammar. It narrows what is SHOWN and
                         nothing else — the header keeps counting the full set, and the ticks
                         it hides still commit and still discard. That rule lives on
                         PendingFilter's own remarks; the box only binds it. -->
                    <TextBox Grid.Row="0" x:Name="ChangesFilterBox" Margin="0,0,0,6"
                             AutomationProperties.Name="Find a changed file"
                             Style="{StaticResource FlatTextBox}"
                             Tag="Find a changed file…"
                             ToolTip="Narrow the list. Ctrl+F puts the caret here."
                             Text="{Binding PendingFilter,
                                 UpdateSourceTrigger=PropertyChanged, Delay=200}" />

                    <!-- THREE COLUMNS, NOT FOUR, AND THAT IS THE OVERFLOW FIX.
                         Auto | * | Auto — checkbox, trimming header, Discard.
                         See StagingSelection.Header. -->
                    <Grid Grid.Row="1" Margin="0,0,0,4" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="24" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Margin="0,0,6,0"
                                  VerticalAlignment="Center" IsThreeState="True"
                                  Style="{StaticResource MenuCheck}"
                                  ToolTip="Tick or clear every changed file"
                                  IsChecked="{Binding PendingAllSelected, Mode=TwoWay}" />

                        <TextBlock Grid.Column="1" Text="{Binding PendingHeader}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding PendingHeader}"
                                   Style="{StaticResource SectionLabel}" />

                        <Button Grid.Column="2" Content="{Binding DiscardLabel}"
                                Margin="8,0,0,0" Padding="8,2"
                                Height="{DynamicResource Size.Control.Compact}"
                                Style="{StaticResource GhostButton}"
                                Foreground="{DynamicResource Brush.Status.Deleted}"
                                Command="{Binding DiscardCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Throw these changes away — this cannot be undone" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="ChangesList"
                                 AutomationProperties.Name="Changed files"
                                 ItemsSource="{Binding Pending}"
                                 SelectedItem="{Binding SelectedPending}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemTemplate="{StaticResource PendingRowTemplate}"
                                 ItemContainerStyle="{StaticResource ChangeRowContainer}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling" />

                        <!-- WHICH EMPTY THIS IS. A list emptied by the filter looks exactly
                             like a clean working tree, and "clean" is the one thing it is
                             not — the changes are still there, still counted, still ticked.
                             Said where the rows would have been, only while the filter is
                             the reason they are not. -->
                        <TextBlock Text="No changed file matches. The list and its ticks are unchanged — only hidden."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="12,0"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                   Visibility="{Binding PendingFilterHidesEverything,
                                       Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    </Grid>
                </Grid>
            </DockPanel>
    </Border>

</UserControl>
