<!--
    GIT: staging, the commit message, and the remote operations.

    Every button here goes dead while any operation runs - see ShellViewModel.Ready. Git
    serialises some of this itself with index and ref locks, but not a push racing a commit,
    and not a commit landing while the gate's export is still writing the mirror.

    WHAT STAYS ON THE INSTANCE RATHER THAN HERE. MainWindow owns where this sits and whether
    it is showing - Grid.Row, x:Name and Visibility are set there, by the rail. Setting them
    here as well would mean two files deciding the same thing.

    The DataContext is inherited, so the bindings below read the same ShellViewModel they read
    when this markup lived in MainWindow.xaml. StagedList and UnstagedList are named inside
    this control's own scope now, so a test reaches them through the panel rather than through
    the window - see GitPanelGeometryTests.Inside.
-->
<UserControl x:Class="Versio.App.Views.Panels.GitPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Merged here rather than relied on from MainWindow: a UserControl resolves a
                 StaticResource against itself and its own merges, never against the Window
                 hosting it. See RowTemplates.xaml. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../RowTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="14,0,12,12">
            <DockPanel>
                <!-- GIT ITSELF IS MISSING.

                     First, above everything, because nothing below it can work:
                     every operation in this panel is git.exe resolved from PATH.
                     A first-class state rather than a toast, because it does not
                     go away and there is nothing else to look at.

                     Bound to GitIsMissing, which is false until the launch probe
                     has actually answered - GitPresence.Unknown is deliberately
                     not Missing, or this banner would flash on every launch
                     during the moment before the probe returns. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding GitIsMissing,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="GIT NOT AVAILABLE"
                                   Style="{StaticResource SectionLabel}"
                                   Foreground="{DynamicResource Brush.Status.Deleted}" />
                        <TextBlock Text="{Binding GitPresenceExplanation}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                </Border>

                <!-- COMMIT IDENTITY.

                     git commit refuses without user.name and user.email, and in
                     Versio it refuses AFTER the export gate has spent 17-31 s
                     running CODESYS - the gate goes first so the mirror is never
                     committed stale. A long wait followed by git's nine-line
                     lecture is the worst first run this app can produce, and
                     two config reads at open remove it entirely.

                     Persistent rather than a toast: it is a state to be fixed,
                     not an event that happened. It disappears the moment git can
                     name a committer. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding IdentityIsMissing,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding IdentityExplanation}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Status.Modified}" />

                        <TextBox Style="{StaticResource FlatTextBox}"
                                 Margin="0,8,0,0" Tag="Your name"
                                 Height="{DynamicResource Size.Control.Compact}"
                                 Text="{Binding IdentityName,
                                     UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Style="{StaticResource FlatTextBox}"
                                 Margin="0,6,0,0" Tag="you@example.com"
                                 Height="{DynamicResource Size.Control.Compact}"
                                 Text="{Binding IdentityEmail,
                                     UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Advisory, never a gate: git accepts anything non-empty,
                             and engineer@plc is a perfectly good intranet address.
                             Refusing it would make Versio stricter than the git it
                             is driving. -->
                        <TextBlock Text="That does not look like an email address."
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                   Visibility="{Binding IdentityEmailLooksWrong,
                                       Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Save" Style="{StaticResource AccentButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Command="{Binding SaveIdentityCommand}" />
                            <!-- Local by default. A work machine carrying a personal
                                 global identity is a common and annoying way to
                                 attribute commits to the wrong person. -->
                            <CheckBox Content="Every repository" Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource MenuCheck}"
                                      ToolTip="Write to the global git config as well as this repository"
                                      IsChecked="{Binding IdentityGlobal}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CONFLICTS, AND THE WAY OUT OF A DIVERGED BRANCH.

                     First, above everything, because nothing else in the panel can
                     proceed while the tree is mid-merge: git refuses the commit,
                     and the sync engine refuses both directions
                     (SyncVerdict.BlockedByConflict).

                     The DETECTION is not here. IConflictProbe and the sync
                     narrative already own it, and a second detection path would
                     give the panel and the engine two ways to disagree about the
                     same tree. This binds to what git reported.

                     The conflicted files are their OWN section rather than being
                     folded into staged or not-staged. An unmerged file is reported
                     in both of git's columns and is really in neither state - it is
                     stuck - so putting it in either list would misrepresent what
                     git will do with it. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding IsMidMerge,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ConflictHeadline}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Status.Conflict}" />

                        <ListBox ItemsSource="{Binding Conflicted}"
                                 SelectedItem="{Binding SelectedConflict}"
                                 Background="Transparent" BorderThickness="0"
                                 Margin="0,6,0,0" MaxHeight="120"
                                 ItemContainerStyle="{StaticResource RowItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemTemplate="{StaticResource ChangeRowTemplate}" />

                        <!-- "Ours" and "theirs" swap meaning under a rebase - git
                             replays your commits onto the upstream - so the labels
                             say which BRANCH rather than which pronoun. Nobody
                             should have to remember that rule to press a button. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Keep mine" Padding="8,2"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Take this branch's version of the selected file"
                                    Command="{Binding ResolveCommand}"
                                    CommandParameter="True" />
                            <Button Content="Keep theirs" Padding="8,2" Margin="6,0,0,0"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Take the incoming version of the selected file"
                                    Command="{Binding ResolveCommand}"
                                    CommandParameter="False" />

                            <!-- The way back. Offering an operation that can stop
                                 half-done without offering the undo is how somebody
                                 ends up in a state they cannot describe. -->
                            <Button Content="Abandon" Padding="8,2" Margin="6,0,0,0"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Style="{StaticResource GhostButton}"
                                    Foreground="{DynamicResource Brush.Status.Deleted}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Put the branch back where it was before this started"
                                    Command="{Binding AbortMergeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- THE DIVERGED BRANCH'S ONLY EXIT.

                     Until this existed the panel's own badge said "diverged, pull
                     first" and a fast-forward-only pull refuses a diverged branch by
                     design, so the advice pointed at a button that could not work and
                     the way out was a terminal.

                     Fast-forward-only stays the default and this is not a relaxation
                     of it: that default exists because auto-merging native CODESYS XML
                     produces a file nobody reviewed. What changes is that the user
                     can ask for one BY NAME, having been told what it means.

                     Rebase leads, because it is the usual answer for a feature
                     branch and it keeps the exported history linear - which matters
                     more here than in most repositories, since the diff being read
                     is generated text. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding Standing.IsDiverged,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Standing.Headline}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Status.Modified}" />

                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="A fast-forward cannot resolve this. Replaying your commits on top keeps the history linear; merging records both sides." />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Rebase onto the remote"
                                    Style="{StaticResource AccentButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Replay your commits on top of the remote's"
                                    Command="{Binding ReconcileCommand}"
                                    CommandParameter="True" />
                            <Button Content="Merge" Margin="6,0,0,0" Padding="8,2"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Bring the remote's commits in and record both sides"
                                    Command="{Binding ReconcileCommand}"
                                    CommandParameter="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CREDENTIALS.

                     Versio implements no login and must not start. Driving git.exe
                     is what makes Git Credential Manager, SSH agents, 2FA and
                     corporate proxies behave exactly as they do in the engineer's
                     own terminal; storing a token here would mean owning a secret
                     store, a rotation story and a breach story, and a
                     username/password box cannot do 2FA or SSO. So the job is
                     detect, explain, hand off - never store.

                     The Sign in button is bound to CanSignIn rather than to the
                     banner's own visibility, and that is the important part. A 403
                     means the credential WORKED and the account lacks access, and
                     an SSH remote has no credential helper at all. Both read like
                     authentication failures; offering to sign in again on either
                     is offering a button that cannot work, and on the 403 it is a
                     loop that cannot terminate. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding NeedsAttentionForAuth,
                            Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding AuthExplanation}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Status.Modified}" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Sign in" Style="{StaticResource AccentButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Hand off to your git credential helper. Versio never sees the credential."
                                    Command="{Binding SignInCommand}"
                                    Visibility="{Binding CanSignIn,
                                        Converter={StaticResource BoolToVisibility}}" />

                            <!-- The button no git GUI offers, and the one that
                                 fixes the failure people actually hit: an expired
                                 token the helper keeps cheerfully returning, so
                                 every push fails identically and nothing inside the
                                 app changes it. -->
                            <Button Content="Forget credential" Margin="6,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Erase the saved credential for this host, so the next fetch asks for a new one"
                                    Command="{Binding SignOutCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Branch and divergence. The remote state is why somebody opens
                     this panel, so it leads. -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        CornerRadius="{DynamicResource Radius.Control}"
                        Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Icon.Link}"
                                       Style="{StaticResource IconText}"
                                       FontSize="12" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding BranchName}"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       FontWeight="{DynamicResource Font.Weight.Medium}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <TextBlock Text="{Binding AheadBehind}" Margin="10,0,0,0"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Accent.Default}" />
                        </StackPanel>

                        <!-- BRANCH HOUSEKEEPING, ON THE BRANCH LINE.

                             Not in the fetch/pull/push row, and the geometry test
                             is what settled it: a fourth button there overflowed
                             the 380 px panel outright. It does not belong in that
                             rhythm anyway - deleting branches is about which
                             branches exist, not about the remote's state - and a
                             destructive action sitting where Fetch sits gives it
                             the same weight as a fetch.

                             Right-aligned and quiet: reached deliberately, not
                             stumbled into. -->
                        <Button Content="Delete branches…" Padding="8,2"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource GhostButton}"
                                Height="{DynamicResource Size.Control.Compact}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Remove branches from this machine, and optionally from the remote"
                                Command="{Binding DeleteBranchesCommand}" />

                        <!-- WHERE THIS BRANCH STANDS, IN WORDS.

                             The arrows above are compact and ask the reader to
                             remember which one means somebody else moved. This
                             says it. Three states used to be indistinguishable
                             here: in sync, no upstream and no remote all rendered
                             as an empty string, so a branch nobody else could see
                             looked exactly like a branch that was fully pushed.

                             The colour is chosen by RemoteStanding, not here:
                             amber only when doing nothing has a cost. -->
                        <TextBlock Text="{Binding Standing.Headline}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{Binding Standing.BrushKey,
                                       Converter={StaticResource ResourceKey}}" />

                        <!-- Compact: three buttons inside a card that is itself
                             inside a 380 px panel. At the full 32 px they set the
                             height of the whole card and pushed the file lists
                             down for nothing. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <!-- ToolTipService.ShowOnDisabled on every one of
                                 these. A dead button with no reason is what sends
                                 somebody to the command line, which is the thing
                                 this panel exists to avoid, and WPF hides tooltips
                                 on disabled controls unless told otherwise. The
                                 explanation would be invisible exactly when it is
                                 wanted. -->
                            <Button Content="Fetch" Style="{StaticResource GhostButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Ask the remote what has changed, without touching your files"
                                    Command="{Binding FetchCommand}" />
                            <Button Content="{Binding PullLabel}" Margin="6,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{Binding Standing.Headline}"
                                    Command="{Binding PullCommand}" />

                            <!-- Push and Publish swap rather than sharing a button.
                                 A plain push on a branch with no upstream fails
                                 outright, so they are different operations, and one
                                 control meaning both would have a failure mode that
                                 only appears sometimes. -->
                            <Button Content="{Binding PushLabel}" Margin="6,0,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{Binding Standing.Headline}"
                                    Command="{Binding PushCommand}"
                                    Visibility="{Binding ShowPush,
                                        Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Publish branch" Margin="6,0,0,0"
                                    Style="{StaticResource AccentButton}"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Push this branch to the remote and start tracking it"
                                    Command="{Binding PublishCommand}"
                                    Visibility="{Binding ShowPublish,
                                        Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- ITS OWN ROW, FULL WIDTH, AND NOT BESIDE FETCH.

                             GP-H already measured what a fourth button on that row
                             does: it overflows the 380 px panel outright. And it
                             does not belong there anyway - fetch, pull and push are
                             one rhythm somebody repeats all day, and raising a
                             merge request is a deliberate act that happens once per
                             branch. Different weight, different row.

                             COLLAPSED, NOT DISABLED, when the forge is unknown. A
                             self-hosted GitLab is unidentifiable from its URL and a
                             local-only repository has no forge at all - and neither
                             is a problem the user can fix from this panel, so a
                             permanently dead control with a tooltip about repo.json
                             would be clutter on every repository that will never
                             have one.

                             The caption is bound because it means three different
                             things: create one, go to the one that exists, or open
                             the list on a forge that cannot tell us which. It is
                             also in the forge's own vocabulary - GitLab has merge
                             requests, the other four have pull requests. -->
                        <Button Content="{Binding MergeRequest.Label}"
                                Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                Style="{StaticResource GhostButton}"
                                Height="{DynamicResource Size.Control.Compact}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding MergeRequestTooltip}"
                                Command="{Binding OpenMergeRequestCommand}"
                                Visibility="{Binding MergeRequest.IsVisible,
                                    Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Commit box. Ctrl+Enter commits, because reaching for the
                     mouse after typing a message is the one interaction here
                     that happens dozens of times a day. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="COMMIT MESSAGE"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource SectionLabel}" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                   Text="{Binding CommitSubjectLength}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                   ToolTip="Subject length. The convention is 50 characters, hard limit 72." />
                    </Grid>

                    <!-- What this commit is about to record, counted as OBJECTS.

                         "5 changed" is what git can say. "3 POUs, 1 GVL and 1 DUT
                         changed in RefrigeratorControl" is the sentence the
                         engineer would have written, and it is available only
                         because the export wrote the manifest beside the files.

                         It counts what the button will commit, not the working
                         tree - those differ the moment anything is staged, and a
                         line that disagreed with the caption under it would be
                         two controls describing one press.

                         Hidden rather than empty when nothing here belongs to a
                         PLC project: the rows are ordinary paths then, and the
                         list already says how many. -->
                    <TextBlock Text="{Binding ChangeSummaryLine}"
                               TextWrapping="Wrap" Margin="0,0,0,6"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Visibility="{Binding HasChangeSummary,
                                   Converter={StaticResource BoolToVisibility}}" />

                    <TextBox x:Name="CommitMessageBox" Height="72"
                             Style="{StaticResource FlatTextBox}"
                             Tag="Summary of the change…"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             KeyDown="OnCommitMessageKeyDown"
                             Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- ONE BUTTON, THREE BEHAVIOURS, AND A CAPTION THAT SAYS
                         WHICH.

                         "Commit & Push" is gone. It bundled two operations with
                         different failure modes, and its failure story was the
                         worst in the panel: the commit succeeds, the push fails,
                         and one message has to describe both. Push is a deliberate
                         act of its own now, up in the remote row where the
                         ahead-count already lives.

                         The caption is bound because it MEANS different things:
                         "Stage & commit (3)" stages what is ticked, "Stage all &
                         commit" takes the lot, and a plain "Commit" leaves the
                         unstaged files exactly where they are. That last one is
                         the safeguard - somebody who staged three files on purpose
                         must not get a fourth swept in - and it is only visible
                         before the press if the caption carries it.

                         ToolTipService.ShowOnDisabled because WPF hides a tooltip
                         on a disabled control by default, so the one moment the
                         explanation is wanted is the one moment it would be
                         missing. The tooltip says what the button will do while it
                         is live, and why it cannot while it is not. -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{Binding Commit.Label}"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding CommitCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding CommitExplanation}" />

                        <!-- OFFERED, NEVER APPLIED, AND NEVER OVER TYPED WORDS.

                             The button goes dead the moment the box has anything
                             in it, so there is no press that can lose a
                             half-written message. An "are you sure" over
                             somebody's own sentence is a worse answer than not
                             offering the action; clearing the box offers it
                             again. -->
                        <Button Content="Draft" Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding DraftCommitMessageCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Fill the box with a subject built from the changed objects. Available while the box is empty." />
                    </StackPanel>

                    <!-- The most surprising rule in the tool, stated where the
                         decision is made rather than discovered afterwards - but
                         only when it is about to happen.

                         It used to be permanent, and a caption that says the same
                         thing on every refresh is read once and never again; this
                         codebase has already argued that out over a coverage line
                         that congratulated itself every time. The half about
                         pushing releasing the lock is on the Push button's own
                         tooltip, which is where somebody asks it. -->
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.Status.Modified}"
                               Text="A stale PLC export runs before this commit, and is staged with it.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sync.StalenessSummary}"
                                                 Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Staged / unstaged.
                     Two columns, not one cell with a right-aligned button in it.
                     Sharing the cell is how "NOT STAGED" and "Discard" ended up
                     touching in a 380 px panel: a right-aligned child grows
                     leftwards across the label instead of pushing it, and neither
                     one knows the other is there. The label takes what is left and
                     trims; the buttons keep their width. -->
                <!--
                    TWO PANES THAT BOTH SCROLL, AND A SPLITTER BETWEEN THEM.

                    The staged list used to be docked top with a hard
                    MaxHeight="150" while the unstaged list took everything left.
                    So a forty-file stage was trapped in four rows next to an empty
                    list holding four hundred pixels of nothing - the layout was
                    honest about neither.

                    Both rows are star-sized with a MinHeight, so neither can be
                    crushed to nothing, and the splitter lets somebody who is
                    mostly reviewing what is staged give it the room.
                -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="60" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="60" />
                    </Grid.RowDefinitions>

                    <!-- STAGED header: master checkbox, label, count, action. -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Three-state, and the middle one is only ever produced,
                             never accepted: "set this to partially ticked" has no
                             meaning. -->
                        <CheckBox Grid.Column="0" Margin="0,0,6,0"
                                  VerticalAlignment="Center" IsThreeState="True"
                                  Style="{StaticResource MenuCheck}"
                                  ToolTip="Tick or clear every staged file"
                                  IsChecked="{Binding StagedAllSelected, Mode=TwoWay}" />

                        <TextBlock Grid.Column="1" Text="STAGED"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionLabel}" />

                        <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                   Text="{Binding StagedSelectionCaption}" />

                        <Button Grid.Column="3" Content="{Binding UnstageLabel}"
                                Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}" Padding="8,2"
                                Height="{DynamicResource Size.Control.Compact}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Take these back out of the next commit"
                                Command="{Binding UnstageCommand}" />
                    </Grid>

                    <ListBox Grid.Row="1" x:Name="StagedList"
                             AutomationProperties.Name="Staged files"
                             ItemsSource="{Binding Staged}"
                             SelectedItem="{Binding SelectedStaged}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemTemplate="{StaticResource StageRowTemplate}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling" />

                    <!-- The staged list can be tall now, so it virtualizes too.
                         It could not before, behind its 150 px ceiling. -->
                    <GridSplitter Grid.Row="2" Height="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource PaneSplitter}"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows"
                                  AutomationProperties.Name="Resize the staged list" />

                    <Grid Grid.Row="3" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Margin="0,0,6,0"
                                  VerticalAlignment="Center" IsThreeState="True"
                                  Style="{StaticResource MenuCheck}"
                                  ToolTip="Tick or clear every changed file"
                                  IsChecked="{Binding UnstagedAllSelected, Mode=TwoWay}" />

                        <TextBlock Grid.Column="1" Text="NOT STAGED"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SectionLabel}" />

                        <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource Font.UI}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                   Text="{Binding UnstagedSelectionCaption}" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                    Margin="8,0,0,0">
                            <!-- Still the only button here that destroys work
                                 nothing else has a copy of, and it still confirms
                                 with the files named. What changed is that it can
                                 now act on a ticked set rather than only on the
                                 one row somebody happened to click. -->
                            <Button Content="{Binding DiscardLabel}" Padding="8,2"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Style="{StaticResource GhostButton}"
                                    Foreground="{DynamicResource Brush.Status.Deleted}"
                                    Command="{Binding DiscardCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Throw these changes away — this cannot be undone" />
                            <Button Content="{Binding StageLabel}" Padding="8,2"
                                    Margin="6,0,0,0"
                                    Height="{DynamicResource Size.Control.Compact}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Put these into the next commit"
                                    Command="{Binding StageCommand}" />
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="4" x:Name="UnstagedList"
                             AutomationProperties.Name="Files not staged"
                             ItemsSource="{Binding Unstaged}"
                             SelectedItem="{Binding SelectedUnstaged}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemTemplate="{StaticResource StageRowTemplate}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling" />
                </Grid>
            </DockPanel>
    </Border>

</UserControl>
