<!--
    PROJECT: the one view.

    Every tracked project with its objects underneath it, and every other changed file beside
    them. This replaced two panels that were answering the same question and disagreeing about
    the answer: a changed .st appeared in the file list as a path and in the sync panel as an
    object, with nothing saying they were the same edit.

    WHAT STAYS ON THE INSTANCE RATHER THAN HERE. MainWindow owns where this sits and whether
    it is showing - Grid.Row, x:Name and Visibility are set there, by the rail. This is the
    one panel that starts visible, and that too is the shell's decision rather than this
    file's.

    Everything below reaches only the stylesheet for its resources - BoolToVisibility,
    FlatTextBox, GhostButton, ResourceKey, TreeRowItem - so unlike the git panel it needs no
    dictionary merged here. The DataContext is inherited, so the bindings read the same
    ShellViewModel they read when this markup lived in MainWindow.xaml.
-->
<UserControl x:Class="Versio.App.Views.Panels.ProjectPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="14,0,12,12">
            <DockPanel>
                <!-- What used to be a PLC status card is gone.
                     It carried the toolchain name, its version and its profile -
                     system information, identical for every repository, which now
                     lives in Settings > Help > System information. And it carried
                     two buttons that were disabled almost always: "Export now",
                     replaced by exporting on open, and "Acknowledge failure",
                     which belonged to one project rather than to the panel and is
                     now on that project's own row.

                     What is left are the two lines that are transient and worth
                     interrupting for, and both hide themselves when empty. -->

                <!-- What the scan found that Versio cannot resolve on its own: an
                     export tree whose project was deleted, a binding pointing at
                     nothing, a manifest claiming a different binding. Rare, and
                     every one of them needs a person - which is why they are here
                     rather than only in the log, where they used to stop. -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding Sync.FindingsSummary}"
                           TextWrapping="Wrap" Margin="2,0,0,8"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Status.Deleted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sync.FindingsSummary}"
                                             Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- What the export cannot carry. Distinct from staleness: stale
                     means the mirror is behind the project, this means the mirror
                     could never hold it in the first place. -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding Sync.CoverageSummary}"
                           TextWrapping="Wrap" Margin="2,0,0,8"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Status.Deleted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sync.CoverageSummary}"
                                             Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Projects the mirror is still behind on. Normally empty: the
                     catch-up on open exports them. It is NOT empty when an export
                     could not run - the project is open in the IDE, or the
                     direction lock points the other way - and that is exactly when
                     silence would read as "in sync". -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding Sync.StalenessSummary}"
                           TextWrapping="Wrap" Margin="2,0,0,8"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Status.Modified}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sync.StalenessSummary}"
                                             Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- A toolchain launch is 17-31 s with nothing on screen to show
                     for it, and silence is indistinguishable from a hang. -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding Sync.Activity}"
                           TextWrapping="Wrap" Margin="2,0,0,8"
                           FontFamily="{DynamicResource Font.Mono}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Status.Modified}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sync.Activity}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- THE COPIES THAT EXISTED AND NOTHING COULD REACH.

                     Ten per project are written before every import, and until now
                     the only route to one was knowing the layout of .versio/local/
                     by heart - at the precise moment somebody is having a bad
                     afternoon because an import damaged their project.

                     Hidden rather than disabled when there are none, because that
                     is the ordinary state: most projects have never had an import
                     run, and a permanently dead button labelled "Restore" on every
                     one of them would be furniture. It appears when the selected
                     project has something to go back to. -->
                <Button DockPanel.Dock="Top" Content="Restore a saved copy…"
                        Margin="0,0,0,6" HorizontalAlignment="Left" Padding="10,2"
                        Height="{DynamicResource Size.Control.Compact}"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding Sync.RestoreBackupCommand}"
                        ToolTip="Put a previous version of this project back. The version it replaces is saved first."
                        Visibility="{Binding Sync.SelectedHasBackups,
                            Converter={StaticResource BoolToVisibility}}" />

                <TextBox DockPanel.Dock="Top" Margin="0,0,0,6" x:Name="TreeSearchBox"
                         AutomationProperties.Name="Find an object or a file"
                         Style="{StaticResource FlatTextBox}"
                         Tag="Find an object or a file…"
                         ToolTip="Narrow the tree. Ctrl+F puts the caret here."
                         Text="{Binding Sync.TreeSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" />

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Sync.TreeSummary}"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Text.Disabled}" />

                <!-- IN SYNC: the tracked projects the tree leaves out.

                     The tree hides a clean project on purpose - its premise is "what
                     is there to review". Before this list the calm state had no rows
                     at all: four projects in sync drew an empty card whose middle
                     said "Open a repository", with the truth in a grey footnote.

                     Docked under the search box while the tree is empty, so the calm
                     day reads top-down like any other; docked at the bottom once there
                     are changes, so the changes keep the top of the panel. One row per
                     project, never expandable - the Explorer is where a clean project's
                     objects are browsed. -->
                <StackPanel Margin="0,6,0,0"
                            AutomationProperties.Name="Projects in sync">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="DockPanel.Dock" Value="Bottom" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sync.Tree.Count}" Value="0">
                                    <Setter Property="DockPanel.Dock" Value="Top" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Sync.InSyncProjects.Count}"
                                             Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="IN SYNC" Margin="2,0,0,4"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               FontWeight="{DynamicResource Font.Weight.Semibold}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <ItemsControl ItemsSource="{Binding Sync.InSyncProjects}"
                                  Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="{DynamicResource Size.Row.Tree}"
                                      Background="Transparent"
                                      ToolTip="{Binding Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- The one green thing on a calm screen. A dot
                                         rather than a tick glyph, so it cannot be read
                                         as a checkbox. -->
                                    <Ellipse Grid.Column="0" Width="6" Height="6"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center" Margin="3,0,0,0"
                                             Fill="{DynamicResource Brush.Status.Added}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Body}"
                                               FontWeight="{DynamicResource Font.Weight.Semibold}"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding State}"
                                               VerticalAlignment="Center" Margin="8,0,4,0"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- WPF TreeView virtualization is OFF by default and the cost is
                     not marginal: measured at 94.7 ms virtualized against
                     10,635 ms at the defaults on a 5,002-node CODESYS-shaped tree.
                     All three attributes are required, and so is the
                     VirtualizingStackPanel items panel. The spike that measured
                     it lives in Spikes/ and runs from the command line.

                     It matters more here than it did in the old panel: the tree
                     renders every object rather than only the changed ones.
                     Virtualization is what keeps that affordable on screen, and
                     TreeRow's lazy Children is what keeps it affordable in
                     memory. -->
                <!--
                    THE FIRST THING ANYBODY SEES.

                    With no repository open this tree is empty, and so are the
                    diff pane and the log - three blank cards, which reads as a
                    window that failed to load rather than as an application
                    waiting to be pointed at something.

                    Sharing the DockPanel's fill with the tree rather than
                    docking beside it, and behind it, so the first row covers it.
                -->
                <Grid>
                <!-- The sentence and the two ways to act on it. It used to be the
                     sentence alone, with the buttons that answer it as two unlabelled
                     icons at the far end of the top bar - an empty window that says
                     "open a repository" should be the place to do it. Seen on a fresh
                     window on 2026-09-21. Hidden with the sentence, by the same trigger. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Visibility, ElementName=OpenRepositoryHint}">
                <TextBlock x:Name="OpenRepositoryHint"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Margin="12"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Body}"
                           Foreground="{DynamicResource Brush.Text.Disabled}"
                           Text="Open a repository to see what is in it">
                    <!-- Keyed on the repository, not on the tree. It used to read
                         Tree.Count == 0, which is also what a repository with every
                         project in sync looks like - so the calmest state the tool has
                         told its user to open the repository they had open. -->
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sync.HasRepository}"
                                             Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Open a repository…"
                                Style="{StaticResource AccentButton}"
                                Height="{DynamicResource Size.Control.Height}"
                                Command="ApplicationCommands.Open"
                                ToolTip="Choose a folder that is a Git repository (Ctrl+O)" />
                        <Button Content="Clone…" Margin="8,0,0,0"
                                Style="{StaticResource GhostButton}"
                                Height="{DynamicResource Size.Control.Height}"
                                Padding="14,0"
                                Command="{Binding CloneCommand}"
                                ToolTip="Copy a repository from a server" />
                    </StackPanel>
                </StackPanel>
                <TreeView ItemsSource="{Binding Sync.Tree}"
                          AutomationProperties.Name="Project contents"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingStackPanel.ScrollUnit="Pixel"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="OnTreeNodeSelected">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>

                    <!-- TreeRowItem is what RowItem is for the lists: a tinted
                         fill and an accent bar instead of Windows' own highlight
                         blue, and a chevron instead of the Aero triangle. The
                         IsExpanded binding stays here rather than in the style,
                         because it is per-row state and it is what drives the
                         lazy children. -->
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem"
                               BasedOn="{StaticResource TreeRowItem}">
                            <Setter Property="IsExpanded"
                                    Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <!-- Two-way so the shell can DESELECT when the rail leaves
                                 the panel; SelectedItem is read-only and cannot. -->
                            <Setter Property="IsSelected"
                                    Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid Margin="0,1" Background="Transparent">
                                <!-- The menu's DataContext is this row, inherited from the
                                     grid it is placed on; the handlers reach the shell
                                     through the panel's DataContext, the same route the
                                     selection handler already takes. Background is set
                                     because a Grid with none is transparent to hit-testing
                                     everywhere its children are not — a right-click in the
                                     gap between name and annotation opened nothing. -->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Stage" Click="OnStageNode"
                                                  Visibility="{Binding CanStageOrDiscard,
                                                      Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem Header="Discard changes…" Click="OnDiscardNode"
                                                  Visibility="{Binding CanStageOrDiscard,
                                                      Converter={StaticResource BoolToVisibility}}" />
                                        <Separator Visibility="{Binding CanStageOrDiscard,
                                                       Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem Header="Reveal in Explorer" Click="OnRevealNode" />
                                        <MenuItem Header="Copy path" Click="OnCopyNodePath" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           FontWeight="{DynamicResource Font.Weight.Semibold}"
                                           Foreground="{Binding BrushKey,
                                               Converter={StaticResource ResourceKey}}" />

                                <!-- A file row's name is a whole repo-relative
                                     path, and paths read in the monospaced face. -->
                                <DockPanel Grid.Column="1">
                                    <!-- What kind of row, before its name. Dim, so the
                                         name stays what the eye lands on. -->
                                    <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0"
                                               Style="{StaticResource IconText}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="{Binding IconKey,
                                                   Converter={StaticResource ResourceKey}}" />
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource Font.Size.Body}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Node.Path}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily"
                                                        Value="{DynamicResource Font.UI}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                        <Setter Property="FontFamily"
                                                                Value="{DynamicResource Font.Mono}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsProject}" Value="True">
                                                        <Setter Property="FontWeight"
                                                                Value="{DynamicResource Font.Weight.Semibold}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>

                                <!-- A project reports its export state here; an
                                     object reports its type in its vendor's words,
                                     so a POU and a visualisation of the same name
                                     are told apart. No row ever has both.

                                     While a toolchain run is in flight the state
                                     is the accent colour instead of the dimmest
                                     one on the palette. The complaint that led
                                     here was that a save looked like nothing was
                                     happening for half a minute, and "exporting…"
                                     rendered in the same grey as "in sync" is a
                                     poor answer to it: the eye reads the colour
                                     before it reads the word. -->
                                <TextBlock Grid.Column="2" Text="{Binding Annotation}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Caption}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource Brush.Text.Disabled}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource Brush.Accent.Default}" />
                                                    <Setter Property="FontWeight"
                                                            Value="{DynamicResource Font.Weight.Semibold}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Roll-up count, so a change is never hidden
                                     behind a collapsed folder. -->
                                <Border Grid.Column="3" Margin="8,0,4,0"
                                        Background="{DynamicResource Brush.Surface.Sunken}"
                                        CornerRadius="8" Padding="6,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Badge}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Badge}"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{Binding BrushKey,
                                                   Converter={StaticResource ResourceKey}}" />
                                </Border>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                </Grid>
            </DockPanel>
    </Border>

</UserControl>
