<!--
    EXPLORER: the open clone as a folder tree.

    PLC projects are grafted in as the same CODESYS-shaped object tree the Project panel
    already builds. Clicks visualize — they never ask git for a diff.

    WHAT STAYS ON THE INSTANCE RATHER THAN HERE. MainWindow owns where this sits and whether
    it is showing. The DataContext is inherited, so the bindings read the same ShellViewModel.
-->
<UserControl x:Class="Versio.App.Views.Panels.ExplorerPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="14,0,12,12">
        <DockPanel>
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,6" x:Name="ExplorerSearchBox"
                     AutomationProperties.Name="Find a file or an object"
                     Style="{StaticResource FlatTextBox}"
                     Tag="Find a file or an object…"
                     ToolTip="Narrow the tree. Ctrl+F puts the caret here."
                     Text="{Binding Explorer.Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Explorer.Summary}"
                       TextWrapping="Wrap" Margin="0,6,0,0"
                       FontFamily="{DynamicResource Font.UI}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.Text.Disabled}" />

            <Grid>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Margin="12"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Body}"
                           Foreground="{DynamicResource Brush.Text.Disabled}"
                           Text="Open a repository to browse it">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Explorer.Tree.Count}"
                                             Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TreeView x:Name="ExplorerTree" ItemsSource="{Binding Explorer.Tree}"
                          AutomationProperties.Name="Repository contents"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingStackPanel.ScrollUnit="Pixel"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="OnTreeNodeSelected">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem"
                               BasedOn="{StaticResource TreeRowItem}">
                            <Setter Property="IsExpanded"
                                    Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <!-- Two-way so the shell can DESELECT when the rail leaves
                                 the panel; SelectedItem is read-only and cannot. -->
                            <Setter Property="IsSelected"
                                    Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid Margin="0,1" Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Reveal in Explorer" Click="OnRevealNode" />
                                        <MenuItem Header="Copy path" Click="OnCopyNodePath" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           FontWeight="{DynamicResource Font.Weight.Semibold}"
                                           Foreground="{Binding BrushKey,
                                               Converter={StaticResource ResourceKey}}" />
                                <!-- Left-aligned so the dot lands beside the name rather
                                     than at the far end of the column. -->
                                <DockPanel Grid.Column="1" HorizontalAlignment="Left">
                                    <!-- What kind of row, before its name. Dim, so the
                                         name stays what the eye lands on. -->
                                    <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0"
                                               Style="{StaticResource IconText}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               Text="{Binding IconKey,
                                                   Converter={StaticResource ResourceKey}}" />
                                    <!-- A dot while the row is collapsed with changes under
                                         it, nothing while open: the one mark a parent
                                         carries. The Project panel's row says why; docked
                                         right and declared before the name, which fills. -->
                                    <Ellipse DockPanel.Dock="Right" Width="7" Height="7"
                                             Margin="6,0,0,0" VerticalAlignment="Center"
                                             ToolTip="Changes below"
                                             Fill="{Binding HiddenChangeBrushKey,
                                                 Converter={StaticResource ResourceKey}}"
                                             Visibility="{Binding HidesChanges,
                                                 Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource Font.Size.Body}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Node.Path}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily"
                                                        Value="{DynamicResource Font.UI}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                        <Setter Property="FontFamily"
                                                                Value="{DynamicResource Font.Mono}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsProject}" Value="True">
                                                        <Setter Property="FontWeight"
                                                                Value="{DynamicResource Font.Weight.Semibold}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Annotation}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Disabled}" />
                                <!-- TOOLCHAIN: which IDE opens what is in here - "TIA Portal V21".
                                     On the project's folder for a directory project, on the
                                     row itself for a one-file project; RepoExplorerBuilder has
                                     why. Accent, not a status colour: it is an identity, never
                                     a state, and green or amber here would read as "in sync"
                                     or "changed".
                                     LAST COLUMN, ONE MINIMUM WIDTH. The first cut sat it before
                                     the export state, so a row with "in sync" pushed its pill
                                     left of one without, and "TwinCAT 3" was narrower than
                                     "TIA Portal V21" - four pills at four positions and three
                                     widths in the running window. At the right edge with a
                                     floor wide enough for the longest single label, they line
                                     up as a column. A minimum rather than a width, so a folder
                                     holding V20 and V21 grows instead of clipping. -->
                                <Border Grid.Column="3" Margin="8,0,4,0" MinWidth="100"
                                        Background="{DynamicResource Brush.Accent.Muted}"
                                        CornerRadius="8" Padding="6,0"
                                        VerticalAlignment="Center"
                                        ToolTip="PLC project detected here">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Toolchain}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Toolchain}"
                                               TextAlignment="Center"
                                               FontFamily="{DynamicResource Font.UI}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Border>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
