<!--
    HISTORY: what already happened, as against the git panel's what is about to.

    A commit opens to the files it touched, and a file opens its patch in the same pane the
    working tree uses - one pane, so a change reads the same wherever it was reached from.

    Nothing here is read before somebody asks for it. The log is not walked until this panel
    is first shown, a page at a time after that; a commit's files are fetched when it is
    expanded; and a patch when a file is clicked. The panel this replaced re-read the whole
    log on every refresh that touched git's metadata, open or not.

    WHAT STAYS ON THE INSTANCE RATHER THAN HERE. MainWindow owns where this sits and whether
    it is showing - Grid.Row, x:Name and Visibility are set there, by the rail. Setting them
    here as well would mean two files deciding the same thing and the shell winning silently.

    The DataContext is inherited, so the bindings below read the same ShellViewModel they read
    when this markup lived in MainWindow.xaml.
-->
<UserControl x:Class="Versio.App.Views.Panels.HistoryPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Versio.App.ViewModels">

    <Border Padding="14,0,12,12">
        <DockPanel>
            <!-- One page back at a time. Hidden once the branch runs out,
                 rather than greyed: there is nothing further to say about a
                 history somebody has reached the beginning of. -->
            <Button DockPanel.Dock="Bottom" Margin="0,8,0,0"
                    HorizontalAlignment="Left" Padding="8,2"
                    Style="{StaticResource GhostButton}"
                    Content="Load older commits"
                    Command="{Binding History.LoadMoreCommand}"
                    Visibility="{Binding History.HasMore,
                        Converter={StaticResource BoolToVisibility}}" />

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding History.Summary}"
                       TextWrapping="Wrap" Margin="0,6,0,0"
                       FontFamily="{DynamicResource Font.UI}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.Text.Disabled}" />

            <!-- A TreeView for the same reason the project panel uses one:
                 expand and collapse, one selection across both levels, and
                 virtualization that is measured rather than assumed. All
                 three attributes below are required, and so is the
                 VirtualizingStackPanel items panel - see the project tree,
                 where the defaults cost 10,635 ms against 94.7 ms. -->
            <TreeView ItemsSource="{Binding History.Commits}"
                      AutomationProperties.Name="Commit history"
                      Background="Transparent" BorderThickness="0"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      VirtualizingStackPanel.ScrollUnit="Pixel"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectedItemChanged="OnHistoryRowSelected">
                <TreeView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </TreeView.ItemsPanel>

                <!-- TreeRowItem is what RowItem is for the lists: a tinted
                     fill and an accent bar instead of Windows' own highlight
                     blue, and a chevron instead of the Aero triangle. The
                     IsExpanded binding stays here rather than in the style,
                     because it is per-row state and it is what drives the
                     lazy children. -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem"
                           BasedOn="{StaticResource TreeRowItem}">
                        <Setter Property="IsExpanded"
                                Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.Resources>
                    <!-- Two lines, because four facts do not fit across a
                         380 px column. The subject leads - it is what
                         somebody is scanning for - and the identifying
                         details sit under it in the quieter face. -->
                    <HierarchicalDataTemplate DataType="{x:Type vm:CommitRow}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Margin="0,2">
                            <!--
                                WHICH OF THESE IS STILL ONLY HERE.

                                Every commit was drawn identically, so nothing
                                on screen separated work that exists in one
                                place from work a colleague can already see.
                                The branch badge says "2 ahead" - it does not
                                say WHICH two, and on a branch with no upstream
                                it has nothing to count against at all.

                                AN ARROW, NOT A LABEL. The first version was a
                                filled pill reading "unpushed" and it was too
                                loud for a list this dense - a word repeated
                                down every row of a run, when the run is the
                                thing being read. The arrow is the convention
                                every git client uses for this, it is the SAME
                                character the branch badge already spends on
                                ahead-ness, and it needs no legend.
                            -->
                            <TextBlock Text="{Binding Subject}"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Subject}" />

                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <!-- Collapsed rather than made transparent, so
                                     a pushed commit's metadata line starts
                                     where it always did. Mono, because it sits
                                     in the same run as the hash and the date
                                     and has to share their baseline. -->
                                <TextBlock Text="&#x2191;" Margin="0,0,5,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           FontWeight="{DynamicResource Font.Weight.Semibold}"
                                           Foreground="{DynamicResource Brush.Status.Modified}"
                                           ToolTip="Not pushed — no remote has this commit yet"
                                           Visibility="{Binding IsUnpushed,
                                               Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{Binding ShortId}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Accent.Default}"
                                           ToolTip="{Binding Id}" />

                                <!-- Absolute and local. The relative form git
                                     prints is on the tooltip: it is friendlier
                                     to read and useless to quote. -->
                                <TextBlock Text="{Binding When}" Margin="8,0,0,0"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Disabled}"
                                           ToolTip="{Binding Age}" />

                                <TextBlock Text="{Binding Author}" Margin="8,0,0,0"
                                           FontFamily="{DynamicResource Font.UI}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="120"
                                           ToolTip="{Binding Author}" />
                            </StackPanel>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <!-- ITS OWN TEMPLATE, AND IT HAS TO BE.

                         This drew ChangeRowTemplate until GP-J, on the
                         argument that a deletion should be the same colour and
                         the same letter wherever it is seen. Then GP-J taught
                         that template to show an OBJECT - Primary, TypeLabel,
                         IsExportOnly - and a CommitFileRow has none of those.
                         WPF fails a binding to a missing property silently, so
                         every row in this panel rendered with no filename at
                         all and a lock glyph it had no business showing: the
                         Visibility binding failed too, and a failed Visibility
                         binding leaves the element Visible.

                         Found by opening the app, not by any test - the
                         realised-row tests GP-J added cover the git panel's own
                         lists and never came here.

                         The glyph and its colour still come from one place:
                         ChangeGlyph, which is where that decision actually
                         lives. What is NOT shared is the object surface, and a
                         commit's files deliberately stay paths - the object
                         index describes the CURRENT export, and naming a
                         historical path from it would put today's name on
                         yesterday's file. -->
                    <DataTemplate DataType="{x:Type vm:CommitFileRow}">
                        <Grid ToolTip="{Binding Path}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       FontWeight="{DynamicResource Font.Weight.Semibold}"
                                       Foreground="{Binding BrushKey,
                                           Converter={StaticResource ResourceKey}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Path}"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </DockPanel>
    </Border>

</UserControl>
