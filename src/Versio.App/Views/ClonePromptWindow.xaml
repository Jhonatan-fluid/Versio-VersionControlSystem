<Window x:Class="Versio.App.Views.ClonePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clone a repository"
        Height="330" Width="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <!-- Verify before Clone, and Clone stays dead until Verify passes (plan §9.2). The
         point is not ceremony: a clone of a repository full of PLC binaries is minutes
         long, and the two failures worth catching early — a typo in the URL and
         credentials that do not work — both show up in ls-remote in under a second. -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- url label      -->
            <RowDefinition Height="Auto" />   <!-- url + verify   -->
            <RowDefinition Height="Auto" />   <!-- verify result  -->
            <RowDefinition Height="Auto" />   <!-- folder label   -->
            <RowDefinition Height="Auto" />   <!-- folder + pick  -->
            <RowDefinition Height="Auto" />   <!-- destination    -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />   <!-- buttons        -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="REPOSITORY URL" Style="{StaticResource SectionLabel}" />

        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="UrlBox"
                     Style="{StaticResource FlatTextBox}"
                     FontFamily="{DynamicResource Font.Mono}"
                     Tag="https://… or git@…"
                     TextChanged="OnUrlChanged" />

            <Button Grid.Column="1" x:Name="VerifyButton" Content="Verify"
                    Style="{StaticResource GhostButton}"
                    Padding="16,4" Margin="8,0,0,0"
                    IsEnabled="False" Click="OnVerify" />
        </Grid>

        <TextBlock Grid.Row="2" x:Name="VerifyMessage" Margin="2,8,0,0"
                   TextWrapping="Wrap"
                   FontFamily="{DynamicResource Font.UI}"
                   FontSize="{DynamicResource Font.Size.Caption}"
                   Foreground="{DynamicResource Brush.Text.Secondary}" />

        <TextBlock Grid.Row="3" Text="CLONE INTO" Style="{StaticResource SectionLabel}"
                   Margin="0,16,0,0" />

        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="FolderBox"
                     Style="{StaticResource FlatTextBox}"
                     FontFamily="{DynamicResource Font.Mono}"
                     Tag="Parent folder…"
                     TextChanged="OnFolderChanged" />

            <Button Grid.Column="1" Content="Browse…"
                    Style="{StaticResource GhostButton}"
                    Padding="16,4" Margin="8,0,0,0"
                    Click="OnBrowse" />
        </Grid>

        <!-- The full path the clone will create, spelled out. A parent folder plus a name
             taken from the URL is two guesses the user never sees resolved otherwise. -->
        <TextBlock Grid.Row="5" x:Name="DestinationMessage" Margin="2,8,0,0"
                   TextWrapping="Wrap"
                   FontFamily="{DynamicResource Font.Mono}"
                   FontSize="{DynamicResource Font.Size.Caption}"
                   Foreground="{DynamicResource Brush.Text.Secondary}" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource GhostButton}"
                    Padding="16,4" IsCancel="True" Click="OnCancel" />
            <Button x:Name="CloneButton" Content="Clone"
                    Style="{StaticResource AccentButton}"
                    Padding="16,4" Margin="8,0,0,0"
                    IsDefault="True" IsEnabled="False" Click="OnClone" />
        </StackPanel>
    </Grid>
</Window>
