<Window x:Class="Versio.App.Views.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System information"
        Height="520" Width="700"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <!-- What this machine has, not what this repository is doing. Toolchains, profiles,
         versions and paths: identical for every repository, changing only when somebody
         installs something. It lived at the top of the project panel until it was pointed
         out that a panel about changed files is the wrong place for it. -->

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   FontFamily="{DynamicResource Font.UI}"
                   FontSize="{DynamicResource Font.Size.Caption}"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="What Versio found on this machine. Copy this into a bug report — every line here is something that changes what the app can do." />

        <!-- What the last row action said: the add that ran, the prompt that was declined.
             Under the list rather than in a message box, so it stays readable beside the
             rows it changed and copies out with them. Empty until a button has been pressed. -->
        <TextBlock x:Name="Outcome" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   AutomationProperties.Name="Outcome of the last action"
                   FontFamily="{DynamicResource Font.UI}"
                   FontSize="{DynamicResource Font.Size.Caption}"
                   Foreground="{DynamicResource Brush.Text.Primary}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copy all" Style="{StaticResource GhostButton}"
                    Padding="16,4" Click="OnCopy"
                    ToolTip="Copy every line to the clipboard" />
            <Button Content="Close" Style="{StaticResource AccentButton}"
                    Padding="16,4" Margin="8,0,0,0" IsCancel="True" IsDefault="True"
                    Click="OnClose" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- A section header spans both columns and has no value; a plain
                                 row has both. One template, told apart by IsHeader, so the
                                 list stays a flat sequence rather than a nested one. -->
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Label}"
                                       Margin="0,14,0,4"
                                       Style="{StaticResource SectionLabel}"
                                       Visibility="{Binding IsHeader,
                                           Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                       VerticalAlignment="Top"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Visibility="{Binding IsValue,
                                           Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Grid.Column="1"
                                        Visibility="{Binding IsValue,
                                            Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Value}"
                                           TextWrapping="Wrap"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />

                                <!-- The one row that acts: a vendor's fix for a toolchain
                                     it reported as refused. The label is the vendor's; the
                                     click runs the action and shows its sentence below the
                                     list. Collapsed on every other row. -->
                                <Button Content="{Binding Action.Label}"
                                        HorizontalAlignment="Left" Margin="0,6,0,4" Padding="12,3"
                                        Style="{StaticResource AccentButton}"
                                        Click="OnRunAction"
                                        AutomationProperties.Name="{Binding Action.Label}"
                                        Visibility="{Binding HasAction,
                                            Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
