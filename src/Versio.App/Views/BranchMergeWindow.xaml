<Window x:Class="Versio.App.Views.BranchMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge a branch" Width="520" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface.Base}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- No private resource dictionary, for the reason BranchDeleteWindow records: App.xaml
         merges the stylesheet once into Application.Resources and ThemeManager swaps the
         palette inside THAT dictionary, so a copy here would give this window its own palette
         the theme buttons never reach. -->

    <Border Padding="18">
        <DockPanel>
            <TextBlock x:Name="Headline" DockPanel.Dock="Top" TextWrapping="Wrap"
                       FontFamily="{DynamicResource Font.UI}"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <!-- WHY THE BUTTON IS DEAD, WHERE THE ANSWER IS WANTED.

                     Three of the reasons a row cannot be chosen are ordinary and one is not:
                     already merged, the current branch itself, nothing selected - and "this
                     merge would change a PLC project", which is a refusal specific to Versio
                     and needs its whole sentence rather than a greyed button. -->
                <TextBlock x:Name="Reason" TextWrapping="Wrap"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Status.Modified}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
                            Style="{StaticResource GhostButton}" />
                    <Button x:Name="MergeButton" Content="Merge" Margin="8,0,0,0"
                            Style="{StaticResource AccentButton}"
                            ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
            </StackPanel>

            <!-- Merged / not merged is the column that matters here, as it is next door in the
                 delete dialog - for the opposite reason. There it separates a tidy-up from
                 losing an afternoon; here it separates a real merge from a no-op. -->
            <ListBox x:Name="BranchList" Margin="0,12,0,0" MaxHeight="320"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource RowItem}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />

                            <TextBlock Grid.Column="1" Text="{Binding WhereText}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Disabled}" />

                            <TextBlock Grid.Column="2" Text="{Binding MergedText}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{Binding MergedBrushKey,
                                           Converter={StaticResource ResourceKey}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
