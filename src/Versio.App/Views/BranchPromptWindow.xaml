<Window x:Class="Versio.App.Views.BranchPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New branch"
        Height="228" Width="480"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <!-- No styles of its own: every brush, font and control style comes from the one
         stylesheet (plan §9.0). A dialog that hand-rolled its own spacing would be the
         first place the design system stopped being true. -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="BRANCH NAME" Style="{StaticResource SectionLabel}" />

        <!-- No watermark. The box is focused the moment the dialog opens, and a watermark
             is the one hint focus hides — under the old template it sat beneath a blinking
             caret instead, which read as text to delete (2026-10-14). The example lives in
             the message line below, where a caret can never sit on it. -->
        <TextBox Grid.Row="1" x:Name="NameBox" Margin="0,6,0,0"
                 Style="{StaticResource FlatTextBox}"
                 FontFamily="{DynamicResource Font.Mono}"
                 TextChanged="OnNameChanged" />

        <!-- Why the name is refused, or what it will do if accepted. The box is never
             silently dead: a disabled Create with no explanation is the failure this
             whole check exists to avoid. -->
        <TextBlock Grid.Row="2" x:Name="Message" Margin="2,8,0,0"
                   TextWrapping="Wrap"
                   FontFamily="{DynamicResource Font.UI}"
                   FontSize="{DynamicResource Font.Size.Caption}"
                   Foreground="{DynamicResource Brush.Text.Secondary}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource GhostButton}"
                    Padding="16,4" IsCancel="True" Click="OnCancel" />
            <Button x:Name="CreateButton" Content="Create and switch"
                    Style="{StaticResource AccentButton}"
                    Padding="16,4" Margin="8,0,0,0"
                    IsDefault="True" IsEnabled="False" Click="OnCreate" />
        </StackPanel>
    </Grid>
</Window>
