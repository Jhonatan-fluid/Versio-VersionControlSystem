<Window x:Class="Versio.App.Views.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore a saved copy" Width="560" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface.Base}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- No private resource dictionary, deliberately. App.xaml merges the stylesheet once into
         Application.Resources and ThemeManager swaps the palette inside THAT dictionary; a copy
         here would give this window its own palette the theme buttons never reach. This is the
         third window to have that written on it and the reason is still SystemInfoWindow. -->

    <Border Padding="18">
        <DockPanel>
            <TextBlock x:Name="Headline" DockPanel.Dock="Top" TextWrapping="Wrap"
                       FontFamily="{DynamicResource Font.UI}"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <!-- WHAT IT DOES AND WHAT IT KEEPS, stated before the button rather than in a
                     second dialog on top of this one. Choosing a named version from a list is
                     already a deliberate act; an "are you sure" over it is how people learn to
                     dismiss both without reading either.

                     The second sentence is the one that makes this safe to try: somebody who
                     goes back one copy too far has not lost anything, and they should know
                     that BEFORE they decide rather than discover it afterwards. -->
                <TextBlock TextWrapping="Wrap"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="Restoring replaces the project file on disk. The version it replaces is saved first, so this can be undone by restoring that one." />

                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,8,0,0"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Status.Modified}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
                            Style="{StaticResource GhostButton}" />
                    <Button x:Name="RestoreButton" Content="Restore" Margin="8,0,0,0"
                            Style="{StaticResource AccentButton}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Replace the project with the copy selected above" />
                </StackPanel>
            </StackPanel>

            <!-- The time is the column somebody actually navigates by - "the one from before
                 lunch" - so it leads, in local time because that is the clock they were
                 looking at. A copy whose name this could not read still appears, with its
                 file name instead of a time: it is very possibly the one they want, and
                 hiding it would be indistinguishable from Versio having lost it. -->
            <ListBox x:Name="BackupList" Margin="0,12,0,0" MaxHeight="340"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding When}"
                                       FontFamily="{DynamicResource Font.UI}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <TextBlock Text="{Binding Detail}"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
