<!--
    R25 spike: does a WPF TreeView stay smooth at the size a real machine project reaches?

    WPF TreeView virtualization is OFF BY DEFAULT. Left at the defaults it realises every
    node, and the app's primary control - the one users look at all day - crawls. The
    VirtualizingStackPanel settings below are the entire point of this window: it renders
    the same tree twice, virtualized and not, and measures both.
-->
<Window x:Class="Versio.App.Spikes.TreePerformanceSpike"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Versio - R25 tree performance spike"
        Height="760" Width="1180"
        Background="{DynamicResource Brush.Surface.Sunken}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Expand every node. A collapsed tree realises only its roots, which would
                 make the measurement meaningless - the first run of this spike reported a
                 pass with 13 containers realised because nothing was ever visible. -->
            <Style x:Key="ExpandedItemStyle" TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>

            <!-- The tree row, as specified in plan section 9.3:
                 glyph, label, status, roll-up badge. -->
            <HierarchicalDataTemplate x:Key="NodeTemplate"
                                      ItemsSource="{Binding Children}"
                                      ItemContainerStyle="{StaticResource ExpandedItemStyle}">
                <Grid Height="{DynamicResource Size.Row.Tree}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Glyph}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{Binding StatusBrush}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Body}"
                               Foreground="{DynamicResource Brush.Text.Primary}" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding Status}"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               FontWeight="{DynamicResource Font.Weight.Semibold}"
                               Foreground="{Binding StatusBrush}" />

                    <Border Grid.Column="3"
                            Background="{DynamicResource Brush.Accent.Muted}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="6,0,6,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding BadgeVisibility}">
                        <TextBlock Text="{Binding Badge}"
                                   FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.Accent.Default}" />
                    </Border>
                </Grid>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Brush.Surface.Base}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="12">
            <StackPanel>
                <TextBlock Text="R25 — virtualized TreeView at scale"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Subtitle}"
                           FontWeight="{DynamicResource Font.Weight.Semibold}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock x:Name="SubtitleText"
                           Margin="0,4,0,0"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Body}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="RunButton" Content="Run measurement"
                            Click="OnRun" Padding="12,5" MinWidth="150" />
                    <Button x:Name="ThemeButton" Content="Toggle theme"
                            Click="OnToggleTheme" Padding="12,5" Margin="8,0,0,0" MinWidth="120" />
                    <TextBlock x:Name="VerdictText" Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.UI}"
                               FontSize="{DynamicResource Font.Size.Body}"
                               FontWeight="{DynamicResource Font.Weight.Semibold}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="12">
            <TextBlock x:Name="ResultsText"
                       FontFamily="{DynamicResource Font.Mono}"
                       FontSize="{DynamicResource Font.Size.Code}"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="VIRTUALIZED (recycling)"
                           Margin="12,10,12,6"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           FontWeight="{DynamicResource Font.Weight.Semibold}"
                           Foreground="{DynamicResource Brush.Status.Added}" />
                <!-- The three attributes that make the difference. Off by default. -->
                <TreeView x:Name="VirtualizedTree"
                          ItemTemplate="{StaticResource NodeTemplate}"
                          ItemContainerStyle="{StaticResource ExpandedItemStyle}"
                          Background="{DynamicResource Brush.Surface.Base}"
                          BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingStackPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>
                </TreeView>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource Brush.Border.Subtle}" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="DEFAULTS (no virtualization)"
                           Margin="12,10,12,6"
                           FontFamily="{DynamicResource Font.UI}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           FontWeight="{DynamicResource Font.Weight.Semibold}"
                           Foreground="{DynamicResource Brush.Status.Deleted}" />
                <TreeView x:Name="PlainTree"
                          ItemTemplate="{StaticResource NodeTemplate}"
                          ItemContainerStyle="{StaticResource ExpandedItemStyle}"
                          Background="{DynamicResource Brush.Surface.Base}"
                          BorderThickness="0" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
