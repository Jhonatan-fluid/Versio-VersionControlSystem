<!--
    Buttons, and the navigation rail built from them.

    MERGES Primitives.xaml, AND THAT LINE IS LOAD-BEARING.

    This file reaches into Primitives for FocusRing, FocusRingInset, IconText and the
    Motion.Indicator storyboards.
    A StaticResource resolves against its own dictionary and that dictionary's own
    merges - never against a sibling the parent merged alongside it - so merging
    Primitives in Controls.xaml does not put what this file needs within reach here. Drop the
    merge below and this file still compiles clean, then throws
    "Cannot find resource named 'Motion.IndicatorIn'" the first time something renders.

    DynamicResource is not the way out of it either: the storyboards are
    Freezables, and a DynamicResource inside one resolves once and is never
    re-resolved - the trap ThemeManager.cs documents at length.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Primitives.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================== BUTTON -->
    <!-- Ghost by default: no border, no fill until hovered. Borders on every control are
         the single strongest "old app" signal. -->
    <!--
        TargetType is ButtonBase, not Button, so this also styles a ToggleButton.

        It targeted Button until the log panel's category dropdown - a ToggleButton, because
        it has to stay pressed while its popup is open - asked for it and WPF threw
        "'Button' TargetType does not match type of element 'ToggleButton'" at window
        construction. That is a runtime failure with a clean build behind it: BAML compiles
        the reference happily, and nothing looks at it again until somebody opens the window.
        Everything derived from this still targets Button, which stays legal because Button
        is a ButtonBase.
    -->
    <Style x:Key="GhostButton" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square, and the same height as everything else in its row. It used to hardcode 32
         against a 28 px Size.Control.Height, which is why the top bar's buttons stood taller
         than the dropdowns beside them. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <!--
            WHAT THIS BUTTON IS CALLED.

            Content is the glyph, and WPF derives a control's automation name from its content
            - so Open, Clone, New branch, Refresh, Settings, the log's Pause and its Clear all
            announced a Private Use Area codepoint. That is the whole top bar and it is not a
            small thing: an icon-only button with no name is unusable by a screen reader and
            unreachable by voice control.

            Bound to the button's own ToolTip rather than set per call site. Every one of these
            already has one written for a sighted user hovering, so there is nothing new to
            author and nothing to keep in step - and a new icon button inherits a name from the
            tooltip its author was going to write anyway. It follows a ToolTip that changes
            too, which the log's Pause does: it says Resume while paused.
        -->
        <!--
            TargetNullValue, because a style setter is applied BEFORE the call site's own
            ToolTip is. AutomationProperties.Name is typed string and ToolTip is object, so
            for that moment the binding hands null to a string property and WPF reports
            "Value produced by BindingExpression is not valid for target property" - once per
            control, thirteen times across a launch. Harmless, since the binding updates the
            moment the real tooltip lands, but it filled the one instrument that exists for
            finding real binding faults, and a tracer with thirteen expected errors in it is a
            tracer nobody reads.
        -->
        <Setter Property="AutomationProperties.Name"
                Value="{Binding ToolTip, RelativeSource={RelativeSource Self},
                    TargetNullValue=''}" />
        <Setter Property="Width" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="Height" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!--
        A PILL THAT IS ALSO A BUTTON (UX-9).

        For a summary that is now pressable: it has to keep reading as the count it is, and
        start behaving like the control it has become. The notification overflow is the case -
        "+2 more", appearing only when several things have gone wrong at once, and until this
        existed it was a Border with nothing behind it.

        BasedOn GhostButton rather than templated from the Pill style, and that is the whole
        reason this is a keyed style instead of an inline template at the call site. Ghost
        already carries the focus ring, the hover and pressed fills, the hand cursor and the
        disabled foreground. An inline template would have had to restate all five and would
        have restated four of them - the focus ring is exactly the setter every retemplated
        control in this stylesheet once missed, and FocusVisualTests exists because nothing
        fails when it is absent.

        What it changes from Ghost is only the shape: the pill's own radius and sunken fill,
        and a height that belongs beside body text rather than in a control row.

        The radius is written here rather than taken from the Pill style because CornerRadius
        is not a Button property, so there is nothing for a setter to reach - Ghost's template
        fixes it at Radius.Control. 9 is the Pill's, restated to match it, and the two are
        worth keeping in step by eye.
    -->
    <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />

        <!-- MONO, and it is inherited from neither side - which is why it is written out.
             Ghost is Font.UI because its content is words on a button; a pill's content is a
             COUNT, and PillText has been mono since the pill existed so that "+2 more" and
             "+12 more" do not shift the glyphs around them. Taking Ghost's default here would
             have been a silent change of typeface on the one control being converted, invisible
             in a diff of the call site because the setter that used to carry it - the PillText
             style on the TextBlock - went away with the TextBlock. -->
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="9"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== RAIL -->
    <!-- Selected state is an accent bar plus a tinted fill, never a border. -->
    <Style x:Key="RailButton" TargetType="RadioButton">
        <!--
            Name from Tag, not from ToolTip, and that is deliberate: these three tooltips are
            whole sentences - "Project - the repository as CODESYS structures it, with every
            change marked" - and a name is what a reader says every time focus lands. The Tag
            already holds the short one the panel is called by, so Project, Git and History.
            The sentence stays in HelpText, where a reader offers it on request.
        -->
        <!-- TargetNullValue on both, for the reason recorded on IconButton above. -->
        <Setter Property="AutomationProperties.Name"
                Value="{Binding Tag, RelativeSource={RelativeSource Self},
                    TargetNullValue=''}" />
        <Setter Property="AutomationProperties.HelpText"
                Value="{Binding ToolTip, RelativeSource={RelativeSource Self},
                    TargetNullValue=''}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Width="40" Height="40">
                        <Border x:Name="Fill" CornerRadius="{DynamicResource Radius.Card}"
                                Background="Transparent" Margin="2" />
                        <Border x:Name="Indicator" Width="3" Height="18" Margin="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="0,2,2,0"
                                Background="{DynamicResource Brush.Accent.Default}"
                                Opacity="0" />
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}"
                                   Style="{StaticResource IconText}" FontSize="16"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- The bar slides in rather than appearing. The fill and the
                                 glyph colour still switch outright: a colour crossfade on a
                                 40 px tile is a smear, not a transition. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard
                                    Storyboard="{StaticResource Motion.IndicatorIn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard
                                    Storyboard="{StaticResource Motion.IndicatorOut}" />
                            </Trigger.ExitActions>

                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Muted}" />
                            <Setter TargetName="Glyph" Property="Foreground"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
