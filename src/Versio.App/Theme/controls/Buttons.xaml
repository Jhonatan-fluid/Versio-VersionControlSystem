<!--
    Buttons, and the navigation rail built from them.

    MERGES Primitives.xaml, AND THAT LINE IS LOAD-BEARING.

    This file reaches into Primitives for FocusRing, FocusRingInset, IconText and the
    Motion.Indicator storyboards.
    A StaticResource resolves against its own dictionary and that dictionary's own
    merges - never against a sibling the parent merged alongside it - so merging
    Primitives in Controls.xaml does not put what this file needs within reach here. Drop the
    merge below and this file still compiles clean, then throws
    "Cannot find resource named 'Motion.IndicatorIn'" the first time something renders.

    DynamicResource is not the way out of it either: the storyboards are
    Freezables, and a DynamicResource inside one resolves once and is never
    re-resolved - the trap ThemeManager.cs documents at length.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Primitives.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================== BUTTON -->
    <!-- Ghost by default: no border, no fill until hovered. Borders on every control are
         the single strongest "old app" signal. -->
    <!--
        TargetType is ButtonBase, not Button, so this also styles a ToggleButton.

        It targeted Button until the log panel's category dropdown - a ToggleButton, because
        it has to stay pressed while its popup is open - asked for it and WPF threw
        "'Button' TargetType does not match type of element 'ToggleButton'" at window
        construction. That is a runtime failure with a clean build behind it: BAML compiles
        the reference happily, and nothing looks at it again until somebody opens the window.
        Everything derived from this still targets Button, which stays legal because Button
        is a ButtonBase.
    -->
    <Style x:Key="GhostButton" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square, and the same height as everything else in its row. It used to hardcode 32
         against a 28 px Size.Control.Height, which is why the top bar's buttons stood taller
         than the dropdowns beside them. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <!--
            WHAT THIS BUTTON IS CALLED.

            Content is the glyph, and WPF derives a control's automation name from its content
            - so Open, Clone, New branch, Refresh, Settings, the log's Pause and its Clear all
            announced a Private Use Area codepoint. That is the whole top bar and it is not a
            small thing: an icon-only button with no name is unusable by a screen reader and
            unreachable by voice control.

            Bound to the button's own ToolTip rather than set per call site. Every one of these
            already has one written for a sighted user hovering, so there is nothing new to
            author and nothing to keep in step - and a new icon button inherits a name from the
            tooltip its author was going to write anyway. It follows a ToolTip that changes
            too, which the log's Pause does: it says Resume while paused.
        -->
        <Setter Property="AutomationProperties.Name"
                Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Width" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="Height" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- ==================================================================== RAIL -->
    <!-- Selected state is an accent bar plus a tinted fill, never a border. -->
    <Style x:Key="RailButton" TargetType="RadioButton">
        <!--
            Name from Tag, not from ToolTip, and that is deliberate: these three tooltips are
            whole sentences - "Project - the repository as CODESYS structures it, with every
            change marked" - and a name is what a reader says every time focus lands. The Tag
            already holds the short one the panel is called by, so Project, Git and History.
            The sentence stays in HelpText, where a reader offers it on request.
        -->
        <Setter Property="AutomationProperties.Name"
                Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
        <Setter Property="AutomationProperties.HelpText"
                Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Width="40" Height="40">
                        <Border x:Name="Fill" CornerRadius="{DynamicResource Radius.Card}"
                                Background="Transparent" Margin="2" />
                        <Border x:Name="Indicator" Width="3" Height="18" Margin="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="0,2,2,0"
                                Background="{DynamicResource Brush.Accent.Default}"
                                Opacity="0" />
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}"
                                   Style="{StaticResource IconText}" FontSize="16"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- The bar slides in rather than appearing. The fill and the
                                 glyph colour still switch outright: a colour crossfade on a
                                 40 px tile is a smear, not a transition. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard
                                    Storyboard="{StaticResource Motion.IndicatorIn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard
                                    Storyboard="{StaticResource Motion.IndicatorOut}" />
                            </Trigger.ExitActions>

                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Muted}" />
                            <Setter TargetName="Glyph" Property="Foreground"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
