<!--
    Control styles.

    The first pass looked like a Win32 app, and the reasons were specific: every button
    carried a visible border, selection used the system blue highlight, hard 1px dividers
    separated everything, and the rail used colour emoji. Modern Windows chrome is the
    opposite of all four - borderless surfaces separated by tone rather than lines,
    selection expressed as a tinted fill plus an accent bar, and a single monochrome icon
    font that inherits the foreground colour.

    Four controls were left out of that argument and kept every problem it describes, which is
    worth stating because the omission was invisible: nothing fails when a control is simply
    never styled.

    - CheckBox and RadioButton were WPF's own Aero glyphs, on a dark surface, in the settings
      popup and beside "Show full file". Both are implicit styles now - keyed by type, named by
      nothing, which is the only way to reach controls whose call sites do not mention a style.
    - TreeViewItem, twice. ListBoxItem was retemplated here BECAUSE the system highlight is the
      loudest tell, and the project tree is not a ListBox - so it kept highlight-blue selection
      and the Aero expander triangle, and the history tree inherited the same the day it was
      added. TreeRowItem is RowItem's equivalent for both.
    - ToolTip, which is a Popup and therefore reachable from no window's visual tree at all.

    The pattern in all four: an implicit style, or a keyed one a container asks for, and a test
    that applies and MEASURES it - a key can hold a template that resolves fine and throws the
    first time something renders it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:views="clr-namespace:Versio.App.Views">

    <!--
        SPACING IS MERGED HERE AS WELL AS IN Theme.xaml, AND IT HAS TO BE.

        Everything in this file that reaches another token file uses DynamicResource, which
        resolves at render time against the whole application dictionary and therefore finds
        Spacing.xaml wherever it sits. A Storyboard cannot do that: it is a Freezable, and a
        DynamicResource inside one resolves once and is never re-resolved - the exact trap
        ThemeManager.cs documents at length. So the motion durations have to be StaticResource.

        And a StaticResource CANNOT see a sibling. Theme.xaml merges Spacing before Controls,
        which is enough for the BAML compiler and not enough at load: a merged dictionary
        resolves static references against itself and its own merges, not against whatever the
        parent merged alongside it. The first version of this compiled with zero warnings and
        threw the moment anything rendered a rail button:

            XamlParseException: Cannot find resource named 'Motion.Fast'

        Which is this file's own header, happening to this file. Merging Spacing here costs one
        extra dictionary of fifteen immutable primitives - no colours, nothing theme-dependent,
        so the duplicate cannot disagree with the original about anything.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../tokens/Spacing.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Declared once, here, because every window needs it and a window cannot see another
        window's resources.

        It lived in MainWindow.Resources, and SystemInfoWindow used the same key without
        declaring it - so opening Settings → System information threw
        "Cannot find resource named 'BoolToVisibility'" from inside the row DataTemplate,
        during Measure. Nothing caught it: the reference compiles, the window is the one
        dialog with no test constructing it, and the throw only happens when somebody opens
        it. The same blind spot already written up for modal dialogs, found again in the
        modal that was added after the write-up.
    -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!--
        Turns a brush KEY into a brush, so a view model can decide what something means while
        the theme decides what it looks like. Rows across the application carry a BrushKey
        rather than a Brush for that reason.

        Declared here rather than in a window, after BranchDeleteWindow became the second window
        to want it. A private copy is why SystemInfoWindow once threw on open - see the note in
        MainWindow.xaml. One instance, one place.
    -->
    <views:ResourceKeyConverter x:Key="ResourceKey" />

    <!-- Segoe Fluent Icons is the Windows 11 system icon font; Segoe MDL2 covers Windows 10.
         Monochrome, so glyphs inherit Foreground and re-theme for free - which colour emoji
         never do. -->
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:String x:Key="Icon.Folder">&#xE8B7;</sys:String>
    <sys:String x:Key="Icon.Document">&#xE8A5;</sys:String>
    <sys:String x:Key="Icon.Refresh">&#xE72C;</sys:String>
    <sys:String x:Key="Icon.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Icon.Sync">&#xE895;</sys:String>
    <sys:String x:Key="Icon.Link">&#xE71B;</sys:String>
    <sys:String x:Key="Icon.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Icon.ChevronUp">&#xE70E;</sys:String>
    <sys:String x:Key="Icon.Delete">&#xE74D;</sys:String>
    <sys:String x:Key="Icon.Add">&#xE710;</sys:String>
    <sys:String x:Key="Icon.Undo">&#xE7A7;</sys:String>
    <sys:String x:Key="Icon.Download">&#xE896;</sys:String>
    <sys:String x:Key="Icon.Pause">&#xE769;</sys:String>
    <sys:String x:Key="Icon.Play">&#xE768;</sys:String>
    <sys:String x:Key="Icon.Filter">&#xE71C;</sys:String>
    <sys:String x:Key="Icon.Check">&#xE73E;</sys:String>
    <sys:String x:Key="Icon.History">&#xE81C;</sys:String>

    <!-- Notification glyphs. Error is the filled circle rather than the outlined one: a failed
         push is the card that must not be mistaken for a caution, and at caption size the
         outlined variants of these two are hard to tell apart. -->
    <sys:String x:Key="Icon.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Icon.Error">&#xEA39;</sys:String>
    <sys:String x:Key="Icon.Close">&#xE711;</sys:String>
    <sys:String x:Key="Icon.Copy">&#xE8C8;</sys:String>

    <!-- ==================================================================== ICON -->
    <Style x:Key="IconText" TargetType="TextBlock">
        <!--
            An EMPTY name, so a screen reader skips the glyph.

            These are Private Use Area codepoints from Segoe Fluent Icons - E8B7, E72C, E713.
            They carry no text at all, and left as they were a reader announced whatever it
            made of an unmapped character, right beside the name the button now has.

            An empty string rather than AccessibilityView="Raw", which is a UWP property and
            does not exist in WPF - it compiles nowhere and fails at build, which is at least
            the good kind of wrong. An empty automation name is the WPF idiom for decoration.
        -->
        <Setter Property="AutomationProperties.Name" Value="" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- =================================================================== MOTION -->
    <!--
        NOTHING IN THE APPLICATION ANIMATED, AND THE DURATIONS HAD ALREADY BEEN CHOSEN.

        Motion.Fast and Motion.Base have been in Spacing.xaml since it was written, with a good
        argument attached - "animation in a tool is feedback, not decoration" - and there was
        not one Storyboard, DoubleAnimation or VisualStateManager anywhere in the codebase.
        Every state change snapped: hover fills appeared instantly, the rail's accent indicator
        popped from Opacity 0 to 1, selection bars flicked on. Snapping is what people describe
        as "feels like an old app" without being able to point at anything.

        ONLY THE MARKS THAT ALREADY EXIST AS OPACITY TRIGGERS. Nothing here animates list
        content, a layout property or a colour: the diff and the project tree are virtualized
        and have to stay instant, and an animation that runs during a scroll is a dropped frame
        per row.

        StaticResource, not Dynamic: a Storyboard is a Freezable and a DynamicResource inside
        one resolves once and then never again - the trap ThemeManager.cs documents at length.
        The durations are theme-independent, so a static reference is not just tolerable here,
        it is correct.
    -->
    <Storyboard x:Key="Motion.MarkIn">
        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="{StaticResource Motion.Fast}" />
    </Storyboard>

    <Storyboard x:Key="Motion.MarkOut">
        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="{StaticResource Motion.Fast}" />
    </Storyboard>

    <Storyboard x:Key="Motion.IndicatorIn">
        <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                         To="1" Duration="{StaticResource Motion.Fast}" />
    </Storyboard>

    <Storyboard x:Key="Motion.IndicatorOut">
        <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                         To="0" Duration="{StaticResource Motion.Fast}" />
    </Storyboard>

    <!-- =================================================================== FOCUS -->
    <!--
        Where the keyboard is.

        EVERY control in this file was retemplated and not one of them said anything about
        focus, so the whole app fell through to WPF's own focus adorner: a 1 px dotted BLACK
        rectangle. On Surface.Base at #1D2026 that is invisible, and on light it is the exact
        piece of 2009 chrome this file's header spends four paragraphs removing. Tabbing
        through the git panel gave no way to tell whether Enter would fetch, pull, push or
        discard - and Discard is in that row.

        A FocusVisualStyle rather than an IsFocused trigger per template, and that is the
        important half: WPF only draws it when focus arrived FROM THE KEYBOARD, which is the
        behaviour wanted. A trigger on IsFocused would ring every button the moment it was
        clicked, and a mouse user does not need to be told where they just clicked.

        No TargetType, and the setters are qualified with Control. - a focus visual is a style
        for the adorner, not for the control it decorates, so an unqualified Template would
        not bind to anything.
    -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <!-- Outside the control's own bounds, so it never covers a glyph or a
                         label. Fine for anything that sits in a bar or a panel. -->
                    <Border Margin="-2"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Accent.Default}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The same ring, drawn INSIDE the control's own bounds.

        For anything whose neighbours are already touching it - the rail, where a 40 px button
        sits in a 44 px column, and a ring expanding outward would run into the window edge.
    -->
    <Style x:Key="FocusRingInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="2"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Brush.Accent.Default}"
                            CornerRadius="{DynamicResource Radius.Card}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== BUTTON -->
    <!-- Ghost by default: no border, no fill until hovered. Borders on every control are
         the single strongest "old app" signal. -->
    <!--
        TargetType is ButtonBase, not Button, so this also styles a ToggleButton.

        It targeted Button until the log panel's category dropdown - a ToggleButton, because
        it has to stay pressed while its popup is open - asked for it and WPF threw
        "'Button' TargetType does not match type of element 'ToggleButton'" at window
        construction. That is a runtime failure with a clean build behind it: BAML compiles
        the reference happily, and nothing looks at it again until somebody opens the window.
        Everything derived from this still targets Button, which stays legal because Button
        is a ButtonBase.
    -->
    <Style x:Key="GhostButton" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square, and the same height as everything else in its row. It used to hardcode 32
         against a 28 px Size.Control.Height, which is why the top bar's buttons stood taller
         than the dropdowns beside them. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <!--
            WHAT THIS BUTTON IS CALLED.

            Content is the glyph, and WPF derives a control's automation name from its content
            - so Open, Clone, New branch, Refresh, Settings, the log's Pause and its Clear all
            announced a Private Use Area codepoint. That is the whole top bar and it is not a
            small thing: an icon-only button with no name is unusable by a screen reader and
            unreachable by voice control.

            Bound to the button's own ToolTip rather than set per call site. Every one of these
            already has one written for a sighted user hovering, so there is nothing new to
            author and nothing to keep in step - and a new icon button inherits a name from the
            tooltip its author was going to write anyway. It follows a ToolTip that changes
            too, which the log's Pause does: it says Resume while paused.
        -->
        <Setter Property="AutomationProperties.Name"
                Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Width" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="Height" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- ==================================================================== RAIL -->
    <!-- Selected state is an accent bar plus a tinted fill, never a border. -->
    <Style x:Key="RailButton" TargetType="RadioButton">
        <!--
            Name from Tag, not from ToolTip, and that is deliberate: these three tooltips are
            whole sentences - "Project - the repository as CODESYS structures it, with every
            change marked" - and a name is what a reader says every time focus lands. The Tag
            already holds the short one the panel is called by, so Project, Git and History.
            The sentence stays in HelpText, where a reader offers it on request.
        -->
        <Setter Property="AutomationProperties.Name"
                Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
        <Setter Property="AutomationProperties.HelpText"
                Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingInset}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Width="40" Height="40">
                        <Border x:Name="Fill" CornerRadius="{DynamicResource Radius.Card}"
                                Background="Transparent" Margin="2" />
                        <Border x:Name="Indicator" Width="3" Height="18" Margin="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="0,2,2,0"
                                Background="{DynamicResource Brush.Accent.Default}"
                                Opacity="0" />
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}"
                                   Style="{StaticResource IconText}" FontSize="16"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- The bar slides in rather than appearing. The fill and the
                                 glyph colour still switch outright: a colour crossfade on a
                                 40 px tile is a smear, not a transition. -->
                            <Trigger.EnterActions>
                                <BeginStoryboard
                                    Storyboard="{StaticResource Motion.IndicatorIn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard
                                    Storyboard="{StaticResource Motion.IndicatorOut}" />
                            </Trigger.ExitActions>

                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Muted}" />
                            <Setter TargetName="Glyph" Property="Foreground"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ COMBOBOX -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Root" Background="{DynamicResource Brush.Surface.Sunken}"
                CornerRadius="{DynamicResource Radius.Control}" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background"
                        Value="{DynamicResource Brush.Surface.Hover}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="FlatCombo" TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Height" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Template="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid Margin="10,0,8,0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="Leading"
                                       Style="{StaticResource IconText}" FontSize="13"
                                       Margin="0,0,8,0"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource IconText}"
                                       FontSize="10" Margin="10,0,0,0"
                                       Text="{DynamicResource Icon.ChevronDown}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </Grid>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource Brush.Surface.Raised}"
                                    CornerRadius="{DynamicResource Radius.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="320" Margin="0,4,0,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3"
                                                      Opacity="0.22" Direction="270" />
                                </Border.Effect>
                                <ScrollViewer Margin="4">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Leading" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatComboItem" TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource Radius.Control}" Margin="0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= TEXTBOX -->
    <Style x:Key="FlatTextBox" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource Brush.Text.Disabled}"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Base}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ LIST ROW -->
    <!-- The system highlight brush is the loudest "old app" tell. Selection here is an
         accent bar plus a tinted fill, and the row keeps its own foreground colours. -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <!-- Null, not FocusRing: the template below draws its own, because a row in a
             scrolling viewport clips an adorner that expands outward - so the ring on the
             first and last visible row would lose the edge nearest the clip, which is the
             edge somebody is looking at while they arrow towards it. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="{DynamicResource Size.Row.Tree}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Fill" Background="Transparent"
                                CornerRadius="{DynamicResource Radius.Control}" Margin="4,0" />
                        <Border x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                Margin="4,4,0,4" CornerRadius="2"
                                Background="{DynamicResource Brush.Accent.Default}" Opacity="0" />
                        <ContentPresenter VerticalAlignment="Center" Margin="12,0,8,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.MarkIn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.MarkOut}" />
                            </Trigger.ExitActions>

                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Selected}" />
                        </Trigger>

                        <!-- Focus is NOT selection here, and in the staged and not-staged
                             lists they genuinely come apart: those are extended-selection
                             lists, so Ctrl+Arrow walks the focus without moving what is
                             picked. An outline rather than the selected fill, so the two
                             states stay tellable apart when a row is both. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fill" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Fill" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LogRowItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
        <Setter Property="Height" Value="{DynamicResource Size.Row.Log}" />
    </Style>

    <!-- =============================================================== SCROLLBAR -->
    <!--
        Thin and quiet. The classic WPF scrollbar with its arrow buttons is instantly dated;
        this is a slim thumb that thickens on hover.

        TWO TEMPLATES, ONE PER AXIS, AND THAT IS THE FIX RATHER THAN THE STYLE.

        There was one template and a single trigger meant to adapt it, and every axis-dependent
        decision inside it was written for vertical:

        - Width="10" was a plain setter with nothing to release it, so a HORIZONTAL bar was
          arranged 10 px WIDE. Measured: 10 px across a 400 px viewport. It appears in exactly
          two places and both of them matter - the diff view and the log console - so long ST
          lines and long log messages could not be scrolled sideways at all.
        - The thumb hardcoded Width="6", which is the thumb's THICKNESS on a vertical bar and
          its LENGTH on a horizontal one.
        - IsDirectionReversed="True" is right for vertical and inverts the drag on horizontal.
        - The trough's page buttons issued PageUp and PageDown. They are Opacity="0" and
          therefore still hit-testable, so clicking the trough of a horizontal bar scrolled
          vertically.

        Four defects, one cause: an axis assumed rather than stated. Splitting the template is
        what makes each one impossible to write again, and it is what WPF's own theme does.

        WHAT THIS CANNOT DO. The 10 px is the bar's own preferred thickness and applies where
        a ScrollBar stands alone. Inside a ScrollViewer it does not win: that template assigns
        its bars a Width/Height from SystemParameters as a LOCAL value, which outranks any
        style setter, so the gutter stays the system's 17 px with a 6 px thumb centred in it.
        Reaching that last 7 px means retemplating ScrollViewer, which is a larger change than
        it looks and buys one shade of density. Stated here rather than quietly not happening.
    -->
    <ControlTemplate x:Key="VerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <!-- Reversed: on a vertical track the maximum is at the BOTTOM, and the Track
                 lays its children out from the low end by default. -->
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                    <Thumb>
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <!-- Width is the thickness here. The length is the Track's
                                     to decide - it is proportional to the viewport. -->
                                <Border x:Name="T" CornerRadius="3" Width="6"
                                        Background="{DynamicResource Brush.Border.Strong}"
                                        Opacity="0.55" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="T" Property="Opacity" Value="0.9" />
                                        <Setter TargetName="T" Property="Width" Value="8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                  Focusable="False" />
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                  Focusable="False" />
                </Track.DecreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <!-- NOT reversed: on a horizontal track the maximum is already at the far end
                 the Track lays out towards. -->
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.Thumb>
                    <Thumb>
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <!-- Height is the thickness on this axis. -->
                                <Border x:Name="T" CornerRadius="3" Height="6"
                                        Background="{DynamicResource Brush.Border.Strong}"
                                        Opacity="0.55" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="T" Property="Opacity" Value="0.9" />
                                        <Setter TargetName="T" Property="Height" Value="8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <!-- Left and Right, not Up and Down. These are invisible and still
                     hit-testable, so they are what a click in the trough runs. -->
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0"
                                  Focusable="False" />
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0"
                                  Focusable="False" />
                </Track.DecreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />

        <!-- Vertical is the default because it is what the app has most of, and because a
             bar with no orientation set is vertical anyway. -->
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />

        <Style.Triggers>
            <!-- A Style trigger, not a ControlTemplate one. Both of these release the
                 dimension that belongs to the other axis, and only a style trigger can
                 override a setter in the same style. -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ SPLITTER -->
    <!--
        A splitter you can find.

        Both of the app's splitters were Background="Transparent" with no template and no
        trigger, so the only feedback that either existed was the cursor changing if you
        happened to land on one. The 5 px one between the staged and not-staged lists sits
        inside a 380 px panel between two visually similar rows, and there was nothing at all
        to suggest it was there - the comment above it explains a resize behaviour most people
        would never discover.

        Invisible until hovered is a legitimate modern pattern. Invisible INCLUDING on hover is
        not, which is what this was.

        A line rather than a raised bar: the app separates surfaces by tone everywhere else,
        and a bevelled grip would be the one piece of Win32 furniture left. It appears only on
        hover and drag, so the resting layout is unchanged.
    -->
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <!-- The hit area is the whole control; the line is a hairline inside it,
                         so the target stays generous while the mark stays quiet. -->
                    <Border Background="{TemplateBinding Background}">
                        <Border x:Name="Line" Opacity="0"
                                Background="{DynamicResource Brush.Border.Strong}"
                                CornerRadius="1" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ResizeDirection" Value="Rows">
                            <Setter TargetName="Line" Property="Height" Value="2" />
                            <Setter TargetName="Line" Property="VerticalAlignment" Value="Center" />
                        </Trigger>
                        <Trigger Property="ResizeDirection" Value="Columns">
                            <Setter TargetName="Line" Property="Width" Value="2" />
                            <Setter TargetName="Line" Property="HorizontalAlignment" Value="Center" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                        </Trigger>

                        <!-- Held down, including once the pointer has left the control -
                         which it does immediately, because dragging a splitter moves the
                         layout out from under the cursor. -->
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================== LABELS -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================================================================= TOOLTIP -->
    <!--
        Implicit, and that is the point: there are dozens of ToolTips across the shell and the
        dialogs, every one of them written as a plain string on the element it explains. Not
        one of them named a style, so every one of them was the stock WPF tooltip - a
        near-white slab with a hard border and a square drop shadow - opening on top of a dark
        application. Retemplating them one by one would have meant touching dozens of call
        sites and missing the next one; an implicit style dresses the ones that exist and the
        ones nobody has written yet.

        A ToolTip is a Popup with its own HWND, so it is the other reason this file has to be
        honest about surfaces: nothing in the window's visual tree reaches it.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="MaxWidth" Value="340" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="HorizontalOffset" Value="0" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="10,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28"
                                              Direction="270" />
                        </Border.Effect>

                        <!-- Wrapping, because several of these are whole sentences: the
                             direction-lock rule, what Discard cannot undo, why a stash keeps
                             untracked files. A tooltip that ran off the screen edge would
                             lose the half that matters. -->
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== CHIPS -->
    <!--
        A filter toggle that reads as on or off at a glance and in peripheral vision.

        ON is a filled pill; OFF is the same pill emptied out and dimmed. Deliberately NOT
        a border-only difference: the log header carries four of these side by side, and a
        one-pixel outline is not a state anybody reads while scanning for a warning.

        The unchecked state keeps the text visible rather than hiding it, because the label
        IS the affordance - a chip that dropped its own name when switched off would leave
        four unlabelled buttons and no way to guess which one to press.
    -->
    <Style x:Key="FilterChip" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" CornerRadius="10" Padding="8,0"
                            Background="{DynamicResource Brush.Surface.Sunken}">
                        <ContentPresenter x:Name="Label"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="Transparent" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A small stated fact: a count, a state, a mode. Not clickable, and shaped so it does
        not read as a button somebody is failing to press.
    -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
    </Style>

    <!--
        Toast card.

        Raised rather than sunken, and bordered: this sits ON TOP of whatever panel is open, so
        it has to read as a separate surface rather than as another section of the page. The
        severity colour arrives on a child rather than on this style, because a card whose whole
        background is red would be shouting where the point is to be noticed and then leave.

        Deliberately not shaped like a button. Only the failure cards carry controls, and only
        two: dismiss, and copy git's own words - which is the line that gets pasted into a
        message asking a colleague for help.
    -->
    <Style x:Key="Toast" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A checkable row inside a dropdown: the category list, and anything like it. -->
    <Style x:Key="MenuCheck" TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
    </Style>

    <!-- ========================================================= CHECK AND RADIO -->
    <!--
        Implicit, both of them, and they are the last stock chrome in the app.

        Every other control here was retemplated in the first pass; these two were not, so the
        settings popup's theme radios, "Show full file", "+ untracked" and every row of the
        category dropdown were drawing WPF's own Aero glyphs - a shaded square and a shaded
        circle, sized for a 2009 desktop, lit as though the light were coming from above - on a
        dark surface. It is the loudest remaining "old app" tell in the product and it costs
        sixty lines to remove.

        Box and glyph rather than box and tick-shaped Path: the icon font is already the app's
        one source of glyphs, it inherits Foreground, and it re-themes for free.
    -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent background across the whole row, so the label is part of
                         the hit area rather than a 13 px square being the only target. -->
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                    Background="Transparent"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph"
                                           Style="{StaticResource IconText}"
                                           FontSize="11" Opacity="0"
                                           Text="{DynamicResource Icon.Check}"
                                           Foreground="{DynamicResource Brush.Text.OnAccent}" />
                            </Border>

                            <ContentPresenter x:Name="Label" Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>

                        <!-- Indeterminate is not used anywhere yet. Given a state rather than
                             left to render as unchecked, so the first three-state checkbox
                             does not silently lie about itself. -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Muted}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Subtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Implicit, and safe for the rail: RailButton sets Style explicitly, and an explicit
        style always beats an implicit one. Asserted by a test rather than trusted, because
        "it only applies where nothing else does" is the kind of rule that is obvious right up
        until it isn't.
    -->
    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" StrokeThickness="1"
                                         Stroke="{DynamicResource Brush.Border.Strong}"
                                         Fill="Transparent" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Opacity="0"
                                         Fill="{DynamicResource Brush.Accent.Default}" />
                            </Grid>

                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="Ring" Property="Stroke"
                                    Value="{DynamicResource Brush.Border.Subtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ TREE ROW -->
    <!--
        What RowItem does for lists, for the two TreeViews.

        This file's own header says the system highlight brush is the loudest "old app" tell,
        and that is why ListBoxItem was retemplated in the first pass. The TreeViews were not,
        so the project tree - the app's primary surface, and the one somebody looks at all day -
        painted its selected row in Windows' own highlight blue and drew the Aero expander
        triangle beside it. The second TreeView, the history, inherited the same thing the day
        it was added.

        The expander is a chevron from the icon font, rotated rather than swapped, so the two
        states cannot drift apart the way two glyph keys can.

        IsExpanded is NOT set here. Both TreeViews bind it two-way to the row - which is what
        drives the project tree's lazy children and the history's demand-driven file lists - and
        a Setter here would fight that binding. The test that matters for this style asserts the
        round-trip still works.
    -->
    <Style x:Key="TreeRowItem" TargetType="TreeViewItem">
        <!-- Its own, for the reason RowItem gives: an outward adorner is clipped by the
             viewport the row scrolls in. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- The row: fill, selection bar, expander, content. Indentation comes
                             from the ItemsPresenter's margin below rather than from a
                             per-level template, so a row's fill spans the full width and a
                             selected child is not a stripe floating in the middle. -->
                        <Grid Grid.Row="0">
                            <Border x:Name="Fill" Background="Transparent"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Margin="2,0" />
                            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                    Margin="2,3,0,3" CornerRadius="2"
                                    Background="{DynamicResource Brush.Accent.Default}"
                                    Opacity="0" />

                            <Grid Margin="8,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                              Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsExpanded,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Width="16" Height="16">
                                                <!-- One glyph, rotated, rather than two glyph
                                                     keys that can drift apart. The transform
                                                     is replaced wholesale in the trigger: a
                                                     RotateTransform is a Freezable and cannot
                                                     be reached by TargetName from inside a
                                                     template. -->
                                                <TextBlock x:Name="Chevron"
                                                           Style="{StaticResource IconText}"
                                                           FontSize="8"
                                                           Text="{DynamicResource Icon.ChevronDown}"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="-90" />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron"
                                                            Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chevron" Property="Foreground"
                                                            Value="{DynamicResource Brush.Text.Primary}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- 16 px, matching the expander column, so a child's glyph lands
                             under its parent's rather than at an arbitrary offset. -->
                        <ItemsPresenter x:Name="Children" Grid.Row="1" Margin="16,0,0,0" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Children" Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>

                        <!-- A leaf has no expander. Hidden rather than collapsed, so its
                             16 px column still lines the row up with its siblings. -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility"
                                    Value="Hidden" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>

                        <!-- IsSelected, not IsSelectionActive: the row stays visibly selected
                             when focus moves to the diff pane, which is exactly what happens
                             the moment somebody clicks a file to read it. The stock template
                             greys the selection out at that point, which is how a selected
                             file ends up looking unselected while its diff is on screen. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.MarkIn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Motion.MarkOut}" />
                            </Trigger.ExitActions>

                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Selected}" />
                        </Trigger>

                        <!-- IsKeyboardFocused, NOT IsKeyboardFocusWithin. Focus within is
                             true for every ancestor of the focused row, so a tree eight
                             levels deep would outline all eight. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fill" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Fill" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
