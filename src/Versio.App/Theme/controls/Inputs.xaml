<!--
    Combo boxes, text boxes, check boxes and radio buttons.

    MERGES Primitives.xaml, AND THAT LINE IS LOAD-BEARING.

    This file reaches into Primitives for FocusRing and IconText.
    A StaticResource resolves against its own dictionary and that dictionary's own
    merges - never against a sibling the parent merged alongside it - so merging
    Primitives in Controls.xaml does not put what this file needs within reach here. Drop the
    merge below and this file still compiles clean, then throws
    "Cannot find resource named 'FocusRing'" the first time something renders.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Primitives.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================ COMBOBOX -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Root" Background="{DynamicResource Brush.Surface.Sunken}"
                CornerRadius="{DynamicResource Radius.Control}" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background"
                        Value="{DynamicResource Brush.Surface.Hover}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="FlatCombo" TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Height" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Template="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid Margin="10,0,8,0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="Leading"
                                       Style="{StaticResource IconText}" FontSize="13"
                                       Margin="0,0,8,0"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource IconText}"
                                       FontSize="10" Margin="10,0,0,0"
                                       Text="{DynamicResource Icon.ChevronDown}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </Grid>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource Brush.Surface.Raised}"
                                    CornerRadius="{DynamicResource Radius.Card}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="320" Margin="0,4,0,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3"
                                                      Opacity="0.22" Direction="270" />
                                </Border.Effect>
                                <ScrollViewer Margin="4">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Leading" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatComboItem" TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource Radius.Control}" Margin="0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= TEXTBOX -->
    <Style x:Key="FlatTextBox" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource Brush.Text.Disabled}"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Base}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================= CHECK AND RADIO -->
    <!--
        Implicit, both of them, and they are the last stock chrome in the app.

        Every other control here was retemplated in the first pass; these two were not, so the
        settings popup's theme radios, "Show full file", "+ untracked" and every row of the
        category dropdown were drawing WPF's own Aero glyphs - a shaded square and a shaded
        circle, sized for a 2009 desktop, lit as though the light were coming from above - on a
        dark surface. It is the loudest remaining "old app" tell in the product and it costs
        sixty lines to remove.

        Box and glyph rather than box and tick-shaped Path: the icon font is already the app's
        one source of glyphs, it inherits Foreground, and it re-themes for free.
    -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Transparent background across the whole row, so the label is part of
                         the hit area rather than a 13 px square being the only target. -->
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                    Background="Transparent"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph"
                                           Style="{StaticResource IconText}"
                                           FontSize="11" Opacity="0"
                                           Text="{DynamicResource Icon.Check}"
                                           Foreground="{DynamicResource Brush.Text.OnAccent}" />
                            </Border>

                            <ContentPresenter x:Name="Label" Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>

                        <!-- Indeterminate is not used anywhere yet. Given a state rather than
                             left to render as unchecked, so the first three-state checkbox
                             does not silently lie about itself. -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Muted}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Subtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Implicit, and safe for the rail: RailButton sets Style explicitly, and an explicit
        style always beats an implicit one. Asserted by a test rather than trusted, because
        "it only applies where nothing else does" is the kind of rule that is obvious right up
        until it isn't.
    -->
    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" StrokeThickness="1"
                                         Stroke="{DynamicResource Brush.Border.Strong}"
                                         Fill="Transparent" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Opacity="0"
                                         Fill="{DynamicResource Brush.Accent.Default}" />
                            </Grid>

                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke"
                                    Value="{DynamicResource Brush.Accent.Default}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter TargetName="Ring" Property="Stroke"
                                    Value="{DynamicResource Brush.Border.Subtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
