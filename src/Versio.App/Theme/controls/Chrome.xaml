<!--
    Section labels, the monospace run, tooltips and chips.

    MERGES Primitives.xaml, AND THAT LINE IS LOAD-BEARING.

    This file reaches into Primitives for FocusRing.
    A StaticResource resolves against its own dictionary and that dictionary's own
    merges - never against a sibling the parent merged alongside it - so merging
    Primitives in Controls.xaml does not put what this file needs within reach here. Drop the
    merge below and this file still compiles clean, then throws
    "Cannot find resource named 'FocusRing'" the first time something renders.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Primitives.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================== LABELS -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================================================================= TOOLTIP -->
    <!--
        Implicit, and that is the point: there are dozens of ToolTips across the shell and the
        dialogs, every one of them written as a plain string on the element it explains. Not
        one of them named a style, so every one of them was the stock WPF tooltip - a
        near-white slab with a hard border and a square drop shadow - opening on top of a dark
        application. Retemplating them one by one would have meant touching dozens of call
        sites and missing the next one; an implicit style dresses the ones that exist and the
        ones nobody has written yet.

        A ToolTip is a Popup with its own HWND, so it is the other reason this file has to be
        honest about surfaces: nothing in the window's visual tree reaches it.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="MaxWidth" Value="340" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="HorizontalOffset" Value="0" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="10,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28"
                                              Direction="270" />
                        </Border.Effect>

                        <!-- Wrapping, because several of these are whole sentences: the
                             direction-lock rule, what Discard cannot undo, why a stash keeps
                             untracked files. A tooltip that ran off the screen edge would
                             lose the half that matters. -->
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ CONTEXT MENU -->
    <!--
        Implicit, for the ToolTip's reason one popup along: a ContextMenu is its own HWND,
        reachable from no window's visual tree, so leaving it unstyled means Aero's
        near-white slab opening over a dark application — the exact tell the first-pass
        audit was about, on the one surface nothing in the tree can dress.

        The MenuItem template is deliberately minimal: header text, hover fill, disabled
        dimming. No glyph column, no gesture column, and NO submenu popup — the menus in
        this application are flat lists of verbs, and a template that carried the machinery
        for submenus nobody opens would be the usual price of copying WPF's default instead
        of writing down what is needed. If a submenu is ever added, this style is the first
        thing its author must revisit, which is why the limitation is stated here rather
        than discovered as a menu that silently never opens.

        The MenuItem and Separator styles live INSIDE the ContextMenu style's resources, so
        a Separator in some future toolbar keeps its own look — the rule is "menus look like
        this", not "separators do".
    -->
    <Style TargetType="ContextMenu">
        <Style.Resources>
            <Style TargetType="MenuItem">
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
                <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Root" Padding="12,6" Margin="2,1"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Background="Transparent">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource Brush.Surface.Hover}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="8,4"
                                    Background="{DynamicResource Brush.Border.Subtle}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>

        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28"
                                              Direction="270" />
                        </Border.Effect>
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================================== CHIPS -->
    <!--
        A filter toggle that reads as on or off at a glance and in peripheral vision.

        ON is a filled pill; OFF is the same pill emptied out and dimmed. Deliberately NOT
        a border-only difference: the log header carries four of these side by side, and a
        one-pixel outline is not a state anybody reads while scanning for a warning.

        The unchecked state keeps the text visible rather than hiding it, because the label
        IS the affordance - a chip that dropped its own name when switched off would leave
        four unlabelled buttons and no way to guess which one to press.
    -->
    <Style x:Key="FilterChip" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" CornerRadius="10" Padding="8,0"
                            Background="{DynamicResource Brush.Surface.Sunken}">
                        <ContentPresenter x:Name="Label"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="Transparent" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One option of a choice: Rendered | Raw, ST | native.

        NOT a FilterChip, though it was one. A filter chip's OFF state is dimmed to 35 %
        because off means "this filter is not applied", and four of them read at a glance.
        A choice has no off: the option not taken is the other view, one click away, and at
        35 % it read as disabled - "Raw" beside "Rendered" looked like a control that could
        not be pressed. Seen in the running window on 2026-09-21.

        So the unchosen option keeps full opacity in the secondary text colour, and the chosen
        one is filled and in the primary colour. Sit these in a SegmentGroup, which draws the
        track that makes two chips read as one control.
    -->
    <Style x:Key="SegmentChip" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="18" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" CornerRadius="9" Padding="10,0"
                            Background="Transparent">
                        <ContentPresenter x:Name="Label"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Brush.Surface.Raised}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter Property="FontWeight"
                                    Value="{DynamicResource Font.Weight.Semibold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The track a run of SegmentChips sits in. -->
    <Style x:Key="SegmentGroup" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
    </Style>

    <!--
        A small stated fact: a count, a state, a mode. Not clickable, and shaped so it does
        not read as a button somebody is failing to press.
    -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
    </Style>

    <!--
        Toast card.

        Raised rather than sunken, and bordered: this sits ON TOP of whatever panel is open, so
        it has to read as a separate surface rather than as another section of the page. The
        severity colour arrives on a child rather than on this style, because a card whose whole
        background is red would be shouting where the point is to be noticed and then leave.

        Deliberately not shaped like a button. Only the failure cards carry controls, and only
        two: dismiss, and copy git's own words - which is the line that gets pasted into a
        message asking a colleague for help.
    -->
    <Style x:Key="Toast" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A checkable row inside a dropdown: the category list, and anything like it. -->
    <Style x:Key="MenuCheck" TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
    </Style>

</ResourceDictionary>
