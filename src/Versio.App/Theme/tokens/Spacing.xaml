<!--
    Spacing, shape and motion.

    Density is deliberate: this is a data-dense engineering tool, not a marketing site.
    A 24 px tree row means roughly 40 objects visible at once on a laptop, which is the
    difference between scanning a project and scrolling through it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Scale: 2 4 8 12 16 24 32. Nothing off-scale. -->
    <sys:Double x:Key="Space.1">2</sys:Double>
    <sys:Double x:Key="Space.2">4</sys:Double>
    <sys:Double x:Key="Space.3">8</sys:Double>
    <sys:Double x:Key="Space.4">12</sys:Double>
    <sys:Double x:Key="Space.5">16</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.7">32</sys:Double>

    <Thickness x:Key="Pad.Row">8,0,8,0</Thickness>
    <Thickness x:Key="Pad.Panel">12</Thickness>
    <Thickness x:Key="Pad.Control">8,4,8,4</Thickness>

    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Card">6</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">8</CornerRadius>

    <!-- Density -->
    <sys:Double x:Key="Size.Row.Tree">24</sys:Double>
    <sys:Double x:Key="Size.Row.Log">20</sys:Double>
    <!--
        One height for everything that sits in a row together. It was 28 while IconButton
        hardcoded 32, so the top bar had 28 px dropdowns beside 32 px buttons and a ragged
        baseline nobody could name but everybody could see. Both read this now.
    -->
    <sys:Double x:Key="Size.Control.Height">32</sys:Double>

    <!--
        The exception, stated once rather than re-invented per view: controls inside a strip
        that is itself dense - the log header, a filter row - where a 32 px control would set
        the height of the whole strip. Not a licence to pick a third value.
    -->
    <sys:Double x:Key="Size.Control.Compact">24</sys:Double>

    <sys:Double x:Key="Size.Rail.Width">44</sys:Double>

    <!-- Motion. Nothing over 200 ms: animation in a tool is feedback, not decoration. -->
    <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Motion.Base">0:0:0.20</Duration>

</ResourceDictionary>
