<!--
    Light palette.

    Every key here MUST also exist in Palette.Dark.xaml with the same name. Swapping the
    theme replaces this one dictionary and nothing else - that only works if the key sets
    are identical, which ThemeTokenTests asserts.

    Raw colours only. Nothing outside tokens/ refers to a Color.* key directly; views bind
    to the semantic brushes in Semantic.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="Color.Surface.Sunken">#F3F4F6</Color>
    <Color x:Key="Color.Surface.Base">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Raised">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Hover">#F0F1F3</Color>
    <Color x:Key="Color.Surface.Selected">#E4EDFB</Color>

    <!-- Borders -->
    <Color x:Key="Color.Border.Subtle">#E5E7EB</Color>
    <Color x:Key="Color.Border.Strong">#CBD0D8</Color>

    <!-- Text -->
    <Color x:Key="Color.Text.Primary">#14161A</Color>
    <Color x:Key="Color.Text.Secondary">#5B6270</Color>
    <Color x:Key="Color.Text.Disabled">#9BA1AC</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFF</Color>

    <!-- Accent -->
    <Color x:Key="Color.Accent.Default">#2563EB</Color>
    <Color x:Key="Color.Accent.Hover">#1D4FD7</Color>
    <Color x:Key="Color.Accent.Muted">#DCE8FD</Color>

    <!-- Status. One vocabulary shared by git state, sync state and log severity. -->
    <Color x:Key="Color.Status.Added">#1A7F45</Color>
    <Color x:Key="Color.Status.Modified">#B45309</Color>
    <Color x:Key="Color.Status.Deleted">#BE2D2D</Color>
    <Color x:Key="Color.Status.Renamed">#6D3FC4</Color>
    <Color x:Key="Color.Status.Conflict">#C2410C</Color>
    <Color x:Key="Color.Status.Neutral">#6B7280</Color>

    <!-- Syntax. Muted on purpose: in a diff the row tint carries the change and the
         colours only carry structure, so saturated syntax would fight the thing that
         matters. -->
    <Color x:Key="Color.Syntax.Keyword">#8250DF</Color>
    <Color x:Key="Color.Syntax.Type">#1A7F8E</Color>
    <Color x:Key="Color.Syntax.Comment">#6E7781</Color>
    <Color x:Key="Color.Syntax.String">#0A6B34</Color>
    <Color x:Key="Color.Syntax.Number">#0550AE</Color>
    <Color x:Key="Color.Syntax.Directive">#953800</Color>

    <!-- Diff -->
    <Color x:Key="Color.Diff.AddedBg">#E6F6EC</Color>
    <Color x:Key="Color.Diff.DeletedBg">#FCEAEA</Color>
    <Color x:Key="Color.Diff.AddedWord">#BBEBCB</Color>
    <Color x:Key="Color.Diff.DeletedWord">#F9CFCF</Color>

</ResourceDictionary>
