<!--
    Semantic brushes: the only colour surface views are allowed to touch.

    Every brush resolves its Color with {DynamicResource}. StaticResource would resolve once
    at load and never follow a theme switch - the single most common way a WPF theme system
    silently half-works.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Surface.Sunken"   Color="{DynamicResource Color.Surface.Sunken}" />
    <SolidColorBrush x:Key="Brush.Surface.Base"     Color="{DynamicResource Color.Surface.Base}" />
    <SolidColorBrush x:Key="Brush.Surface.Raised"   Color="{DynamicResource Color.Surface.Raised}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover"    Color="{DynamicResource Color.Surface.Hover}" />
    <SolidColorBrush x:Key="Brush.Surface.Selected" Color="{DynamicResource Color.Surface.Selected}" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{DynamicResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{DynamicResource Color.Border.Strong}" />

    <SolidColorBrush x:Key="Brush.Text.Primary"   Color="{DynamicResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled"  Color="{DynamicResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent"  Color="{DynamicResource Color.Text.OnAccent}" />

    <SolidColorBrush x:Key="Brush.Accent.Default" Color="{DynamicResource Color.Accent.Default}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover"   Color="{DynamicResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Muted"   Color="{DynamicResource Color.Accent.Muted}" />

    <SolidColorBrush x:Key="Brush.Status.Added"    Color="{DynamicResource Color.Status.Added}" />
    <SolidColorBrush x:Key="Brush.Status.Modified" Color="{DynamicResource Color.Status.Modified}" />
    <SolidColorBrush x:Key="Brush.Status.Deleted"  Color="{DynamicResource Color.Status.Deleted}" />
    <SolidColorBrush x:Key="Brush.Status.Renamed"  Color="{DynamicResource Color.Status.Renamed}" />
    <SolidColorBrush x:Key="Brush.Status.Conflict" Color="{DynamicResource Color.Status.Conflict}" />
    <SolidColorBrush x:Key="Brush.Status.Neutral"  Color="{DynamicResource Color.Status.Neutral}" />

    <SolidColorBrush x:Key="Brush.Diff.AddedBg"     Color="{DynamicResource Color.Diff.AddedBg}" />
    <SolidColorBrush x:Key="Brush.Diff.DeletedBg"   Color="{DynamicResource Color.Diff.DeletedBg}" />
    <SolidColorBrush x:Key="Brush.Diff.AddedWord"   Color="{DynamicResource Color.Diff.AddedWord}" />
    <SolidColorBrush x:Key="Brush.Diff.DeletedWord" Color="{DynamicResource Color.Diff.DeletedWord}" />

</ResourceDictionary>
