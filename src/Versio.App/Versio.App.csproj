<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WPF needs the Windows-flavoured TFM; the rest of the solution stays net9.0. -->
    <!-- Windows 10 1809's SDK projection, for WebView2CompositionControl: it renders through
         Windows.Graphics.Capture, and without Microsoft.Windows.SDK.NET in the output it threw
         FileNotFoundException from OnApplyTemplate - every rendered Markdown page and every
         HTML Web page view was blank (2026-10-04). A TargetPlatformVersion property beside a
         plain net9.0-windows is ignored (the TFM wins, measured), so the TFM carries it. -->
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>

    <!-- ...and the output folder keeps its old name. build.bat, CLAUDE.md's launch line and the
         tia/twincat tools scripts all address bin\Debug\net9.0-windows; renaming it would break
         each of them quietly, on the day someone next runs one. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net9.0-windows\</OutputPath>
    <UseWPF>true</UseWPF>
    <RootNamespace>Versio.App</RootNamespace>
    <AssemblyName>Versio</AssemblyName>
    <StartupObject>Versio.App.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Embedded into the PE image, which is what Explorer, the taskbar and the
         installer all read. WPF also falls back to it for the window's title-bar
         icon when Window.Icon is unset, so one declaration covers every surface.
         Regenerate with tools/New-VersioIcon.ps1 - never hand-edit the .ico. -->
    <ApplicationIcon>..\..\assets\versio.ico</ApplicationIcon>

    <!-- Plan section 13.2: unsupported for WPF. Asserted so nobody enables them for size
         and then hits runtime XAML failures on isolated screens. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- The dialogs expose a few internals - the destination a clone would create, the name
         it derives from a URL - so they can be driven by a test rather than made public for
         the benefit of one. Same arrangement Versio.Infrastructure has with its own suite. -->
    <InternalsVisibleTo Include="Versio.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Installer hooks. Must be the same version as the vpk tool Pack-Versio.ps1 installs. -->
    <PackageReference Include="Velopack" Version="1.2.0" />

    <!-- The diff pane's "Web page" view of an HTML file (2026-10-04). The engine is the
         Edge WebView2 runtime Windows 11 ships; this package is only the host control and
         its loader. Rejected: WPF's own WebBrowser, which is the retired IE engine and draws
         modern HTML wrong - a "view as web page" that renders a different page than any
         browser would is worse than none. WebPageView says so when the runtime is absent. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mermaid 11.17.2, pinned by file (sha256 581ed7d7...390eb8, MIT; LICENSE beside it).
         Draws ```mermaid diagrams in a rendered Markdown page. Embedded rather than fetched:
         a plant PC is often offline, and the page is not allowed a network anyway. -->
    <EmbeddedResource Include="Assets\mermaid\mermaid.min.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Versio.Core\Versio.Core.csproj" />
    <ProjectReference Include="..\Versio.Infrastructure\Versio.Infrastructure.csproj" />

    <!-- THE COMPOSITION ROOT, and the only project outside the pack itself that may name a
         vendor. App.xaml.cs calls CodesysPack.Register() then TiaPortalPack.Register()
         then TwinCatPack.Register();
         adding Rockwell means another reference here and another line there, and nothing
         else in the solution changes. -->
    <ProjectReference Include="..\Versio.Plc.Codesys.Infrastructure\Versio.Plc.Codesys.Infrastructure.csproj" />
    <ProjectReference Include="..\Versio.Plc.TiaPortal.Infrastructure\Versio.Plc.TiaPortal.Infrastructure.csproj" />
    <ProjectReference Include="..\Versio.Plc.TwinCat.Infrastructure\Versio.Plc.TwinCat.Infrastructure.csproj" />
  </ItemGroup>

  <Import Project="..\Versio.Plc.TiaPortal.Host\CopyHostToReferrer.targets" />
  <Import Project="..\Versio.Plc.TwinCat.Host\CopyHostToReferrer.targets" />

</Project>
