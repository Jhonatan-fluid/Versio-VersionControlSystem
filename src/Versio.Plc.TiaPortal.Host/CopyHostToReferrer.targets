<Project>
  <!-- The host exe does not travel with a ProjectReference: different TFM, and
       ReferenceOutputAssembly is false. Copy it beside any project that has to
       spawn it — Infrastructure, the app, the real-TIA tests. -->
  <Target Name="CopyTiaHostToReferrer" AfterTargets="Build">
    <PropertyGroup>
      <_TiaHostOut>$(MSBuildThisFileDirectory)bin\$(Configuration)\net48\</_TiaHostOut>
    </PropertyGroup>
    <ItemGroup>
      <_TiaHostFiles Include="$(_TiaHostOut)**\*.*"
                     Condition="Exists('$(_TiaHostOut)Versio.Plc.TiaPortal.Host.exe')" />
    </ItemGroup>
    <Copy SourceFiles="@(_TiaHostFiles)"
          DestinationFolder="$(OutputPath)tia\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_TiaHostFiles)' != ''" />
  </Target>
</Project>
