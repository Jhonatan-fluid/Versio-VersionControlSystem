<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF needs the Windows-flavoured TFM, exactly as Versio.App does. This is the only
         test project that carries it: everything testable without a UI stays in
         Versio.Core.Tests, which runs in milliseconds and on any platform. -->
    <!-- The same Windows SDK version as Versio.App (see its csproj): a project cannot
         reference one that targets a newer Windows platform than itself. -->
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>Versio.App.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!-- One test opens two real repositories, because the only way to prove the shell CALLS
         its reset is to make it open something. It skips when git is absent, so this project
         still needs nothing but Windows to run. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referencing the WinExe is deliberate and supported: the dialogs under test are its
         types, and duplicating them anywhere else would test a copy. -->
    <ProjectReference Include="..\..\src\Versio.App\Versio.App.csproj" />

    <!-- The web viewer and its fake GitHub, for the one test that runs BOTH hosts over every
         fixture object and asserts they chose the same drawing (RenderChoiceParityTests). The
         choice is Core's; this is the test that proves both hosts ask it. -->
    <ProjectReference Include="..\Versio.Web.Tests\Versio.Web.Tests.csproj" />
  </ItemGroup>

</Project>
