<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Versio.Integration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Versio.Core\Versio.Core.csproj" />
    <ProjectReference Include="..\..\src\Versio.Infrastructure\Versio.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared rather than duplicated. Fixture paths must resolve from the assembly's own
         location so the suite runs from any clone path — hardcoded paths broke the moment
         the checkout moved. -->
    <Compile Include="..\Versio.Core.Tests\TestPaths.cs" Link="TestPaths.cs" />

    <!-- The seam scanner, shared for the same reason: two copies of a rule is how the two
         copies start disagreeing. Versio.Core.Tests cannot host the Infrastructure half of the
         check because it deliberately does not reference Versio.Infrastructure. -->
    <Compile Include="..\Versio.Core.Tests\Plc\VendorSeamScanner.cs" Link="VendorSeamScanner.cs" />
  </ItemGroup>

</Project>
