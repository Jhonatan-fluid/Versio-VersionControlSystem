<Project>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Single source of truth for version. Flows to assembly metadata and the installer.
         Pack-Versio.ps1 writes this before publish so Setup.exe and System information agree. -->
    <VersioVersion>0.4.14</VersioVersion>
    <Version>$(VersioVersion)</Version>
    <!-- Without this the SDK appends +githash, and System information would not match
         the number vpk packed. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Where installed copies look for updates, and where Publish_Release.bat uploads them.
         One place for both, so a build cannot check one repository while releases go to
         another. Private: the app reads it with the GitHub sign-in Git Credential Manager
         already holds. Baked into Versio.App as AssemblyMetadata("VersioUpdateRepo"). -->
    <VersioUpdateRepo>https://github.com/fluidstackio/versio-releases</VersioUpdateRepo>
    <Company>Versio</Company>
    <Product>Versio</Product>

    <!-- Plan section 13.2: trimming and NativeAOT are unsupported for WPF. Asserted here so
         nobody turns them on for size and discovers runtime XAML failures later. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

</Project>
