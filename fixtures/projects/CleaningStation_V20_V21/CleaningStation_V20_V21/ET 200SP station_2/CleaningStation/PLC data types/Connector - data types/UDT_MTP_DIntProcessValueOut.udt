TYPE "UDT_MTP_DIntProcessValueOut"
VERSION : 0.1
   STRUCT
      WQC { ExternalWritable := 'False'} : Byte := 16#FF;   // Worst Quality Code CCC
      V { ExternalWritable := 'False'} : DInt := 0;   // External Source Value
      VSclMin { ExternalWritable := 'False'} : DInt := 0;   // Value Scale Low Limit
      VSclMax { ExternalWritable := 'False'} : DInt := 100;   // Value Scale High Limit
      VUnit { ExternalWritable := 'False'} : Int := 1998;   // Value Unit
   END_STRUCT;

END_TYPE

