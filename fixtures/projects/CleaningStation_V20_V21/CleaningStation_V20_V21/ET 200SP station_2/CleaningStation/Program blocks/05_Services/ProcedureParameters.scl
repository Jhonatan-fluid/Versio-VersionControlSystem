FUNCTION_BLOCK "ProcedureParameters"
TITLE = ProcedureParameters
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : 'Siemens AG'
FAMILY : ServiceControl
VERSION : 1.0
//Providing of the MTP-Interface and the number of parameters of each procedure parameter type
   VAR 
      MTPAnalog : Array[0..#NUMBER_PARAMETERS_ANALOG] of "UDT_MTP_AnaServParam";
      MTPDigital : Array[0..#NUMBER_PARAMETERS_DIGITAL] of "UDT_MTP_DIntServParam";
      MTPBinary : Array[0..#NUMBER_PARAMETERS_BINARY] of "UDT_MTP_BinServParam";
      MTPString : Array[0..#NUMBER_PARAMETERS_STRING] of "UDT_MTP_StringServParam";
   END_VAR

   VAR CONSTANT 
      NUMBER_PARAMETERS_ANALOG : Int := 2;
      NUMBER_PARAMETERS_DIGITAL : Int := 0;
      NUMBER_PARAMETERS_BINARY : Int := 0;
      NUMBER_PARAMETERS_STRING : Int := 0;
   END_VAR


BEGIN
	REGION Block Info Header
	  //===============================================================================
	  // Siemens AG / (c)Copyright 2021
	  //-------------------------------------------------------------------------------
	  // Title:            ProcedureParameters
	  // Comment/Function: Providing of the MTP-Interface and the number of parameters of each procedure parameter type
	  // Library/Family:   ServiceControl
	  // Author:           Siemens AG
	  // Tested with:      S7-PLCSIM Advanced 4.0
	  // Engineering:      TIA Portal V17
	  // Restrictions:     MTP
	  // Requirements:     PLC (S7-1200 / S7-1500)
	  //-------------------------------------------------------------------------------
	  // Change log table:
	  // Version  | Date       | Expert in charge        | Changes applied
	  //----------|------------|-------------------------|-----------------------------
	  // 01.00.00 | 02.09.2021 | Michael Schlosser       | First released version
	  // 01.00.01 | 13.09.2021 | Michael Schlosser       | Change: Interface of FB29
	  // 01.00.02 | 15.09.2021 | Michael Schlosser       | Change: Interface of FB13, FB19, FB23
	  // 01.00.03 | 15.09.2021 | Michael Schlosser       | Change: ApplyEn default values = true (e.g. parLevAnalogApplyEn[0])
	  // 01.00.04 | 16.09.2021 | Michael Schlosser       | Change: ApplyEn & ApplyInt as part of UDT_Service_ParameterApply (e.g. #ParLevAnalogApply[0].En)
	  // 01.00.05 | 18.10.2021 | Michael Schlosser       | change: call of FBs for parameters now in ServiceControlBlock-FBs to allow several services per PLC
	  //===============================================================================
	END_REGION Block Info Header
	
	REGION Description
	  // ProcedureParameters provides the MTP-Interface and the number of parameters of each procedure parameter type
	END_REGION Description
	
END_FUNCTION_BLOCK

