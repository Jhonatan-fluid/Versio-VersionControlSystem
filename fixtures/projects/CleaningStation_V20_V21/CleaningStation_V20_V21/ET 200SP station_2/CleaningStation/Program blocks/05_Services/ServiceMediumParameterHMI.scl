FUNCTION_BLOCK "ServiceMediumParameterHMI"
TITLE = ServiceMediumParameterHMI
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : 'Siemens AG'
FAMILY : ServiceControl
VERSION : 4.0
//{ "TagName" : "" , "TagDescription" : "" }
   VAR_INPUT 
      Id { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : USInt;   // Service parameter ID
      Setup { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : DB_ANY;   // Setup DB used for the service
      ProcedureCur { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : DWord;   // Current Procedure Number
      ProcedureReq { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : DWord;   // Required Procedure Numbar
   END_VAR

   VAR_IN_OUT 
      ConfigurationParameterAnalog : Array[*] of "UDT_MTP_AnaServParam";   // Analog configuration parameter
      ConfigurationParameterDigital : Array[*] of "UDT_MTP_DIntServParam";   // Digital configuration parameter
      ConfigurationParameterBinary : Array[*] of "UDT_MTP_BinServParam";   // Binary configuration parameter
      ConfigurationParameterString : Array[*] of "UDT_MTP_StringServParam";   // String configuration parameter
      ProcedureParameterAnalog : Array[*] of "UDT_MTP_AnaServParam";   // Analog procedure parameter
      ProcedureParameterDigital : Array[*] of "UDT_MTP_DIntServParam";   // Digital procedure parameter
      ProcedureParameterBinary : Array[*] of "UDT_MTP_BinServParam";   // Binary procedure parameter
      ProcedureParameterString : Array[*] of "UDT_MTP_StringServParam";   // String procedure parameter
      ProcessValueInAnalog : Array[*] of "UDT_MTP_AnaProcessValueIn";   // Analog process value in
      ProcessValueInDigital : Array[*] of "UDT_MTP_DIntProcessValueIn";   // Digital process value in
      ProcessValueInBinary : Array[*] of "UDT_MTP_BinProcessValueIn";   // Binary  process value in
      ProcessValueInString : Array[*] of "UDT_MTP_StringProcessValueIn";   // String process value in
      ProcessValueOutAnalog : Array[*] of "UDT_MTP_AnaProcessValueOut";   // Analog process value out
      ProcessValueOutDigital : Array[*] of "UDT_MTP_DIntProcessValueOut";   // Digital process value out
      ProcessValueOutBinary : Array[*] of "UDT_MTP_BinProcessValueOut";   // Binary  process value out
      ProcessValueOutString : Array[*] of "UDT_MTP_StringProcessValueOut";   // String process value out
      ReportValueAnalog : Array[*] of "UDT_MTP_AnaReportValue";   // Analog report value
      ReportValueDigital : Array[*] of "UDT_MTP_DIntReportValue";   // Digital report value
      ReportValueBinary : Array[*] of "UDT_MTP_BinReportValue";   // Binary report value
      ReportValueString : Array[*] of "UDT_MTP_StringReportValue";   // String report value
   END_VAR

   VAR 
      statTotalConfigParameters { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;   // Total used configuration parameter
      statTotalProcedureParameters { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;   // Total used procedure parameter
      statTotalProcessInValues { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;   // Total used process in values
      statTotalProcessOutValues { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;   // Total used process Out values
      statTotalReportValues { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;   // Total used Report values
      StatConfigAnalog { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[0..#MAPPED_CONFIG_ANALOG] of "UDT_Service_AnaServParam";   // Writable Config analog parameters
      StatConfigDigital { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[0..#MAPPED_CONFIG_DIGITAL] of "UDT_Service_DintServParam";   // Writable Config digital parameters
      StatConfigBinary { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[0..#MAPPED_CONFIG_BINARY] of "UDT_Service_BinServParam";   // Writable Config binary parameters
      StatConfigString { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[0..#MAPPED_CONFIG_STRING] of "UDT_Service_StringServParam";   // Writable Config string parameters
      StatProcedureAnalog { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCEDURE_ANALOG] of "UDT_Service_AnaServParam";   // Writable Config analog parameters
      StatProcedureDigital { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCEDURE_DIGITAL] of "UDT_Service_DintServParam";   // Writable Config digital parameters
      StatProcedureBinary { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCEDURE_BINARY] of "UDT_Service_BinServParam";   // Writable Config binary parameters
      StatProcedureString { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCEDURE_STRING] of "UDT_Service_StringServParam";   // Writable Config string parameters
      stat16ProceReqIndex { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;   // Requested/Prepared procedure index number
      stat16ProceCurIndex { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;   // current/Running procedure index number
      stat16ProcParaStartIndex { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;   // Procedure parameter start index value
      stat16ProcParaEndIndex { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;   // Procedure parameter end index value
      stat32PrecedureProcessOutMap { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : DWord;   // Procedure assignment information for ProcessOut values
      stat32PrecedureProcessInMap { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : DWord;   // Procedure assignment information for ProcessIn values
      stat32PrecedureReportMap { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : DWord;   // Procedure assignment information for Report values
      ConfigParaType { S7_SetPoint := 'False'} : "UDT_Service_ConfigParaIndexType";   // Index information for the configuration parameter
      ProcedureParaType { S7_SetPoint := 'False'} : "UDT_Service_ProceParaValueIndexType";   // Index information for the procedure parameter
      ProcessInValueType { S7_SetPoint := 'False'} : "UDT_Service_ProceParaValueIndexType";   // Index information for the process in values
      ProcessOutValueType { S7_SetPoint := 'False'} : "UDT_Service_ProceParaValueIndexType";   // Index information for the process out values
      ReportValueType { S7_SetPoint := 'False'} : "UDT_Service_ProceParaValueIndexType";   // Index information for the report values
      ConfigAna { S7_SetPoint := 'False'} : Array[0..#MAPPED_CONFIG_ANALOG] of "UDT_MTP_AnaServParam";   // Configuration analog parameter
      ConfigDint { S7_SetPoint := 'False'} : Array[0..#MAPPED_CONFIG_DIGITAL] of "UDT_MTP_DIntServParam";   // Configuration digital parameter
      ConfigBin { S7_SetPoint := 'False'} : Array[0..#MAPPED_CONFIG_BINARY] of "UDT_MTP_BinServParam";   // Configuration binary parameter
      ConfigString { S7_SetPoint := 'False'} : Array[0..#MAPPED_CONFIG_STRING] of "UDT_MTP_StringServParam";   // Configuration string parameter
      ProcedureAna { S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCEDURE_ANALOG] of "UDT_MTP_AnaServParam";   // Procedure analog parameter
      ProcedureDint { S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCEDURE_DIGITAL] of "UDT_MTP_DIntServParam";   // Procedure digital parameter
      ProcedureBin { S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCEDURE_BINARY] of "UDT_MTP_BinServParam";   // Procedure binary parameter
      ProcedureString { S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCEDURE_STRING] of "UDT_MTP_StringServParam";   // Procedure string parameter
      ProcessInAna { S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCESS_IN_ANALOG] of "UDT_MTP_AnaProcessValueIn";   // Process In analog values
      ProcessInDint { S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCESS_IN_DIGITAL] of "UDT_MTP_DIntProcessValueIn";   // Process In digital values
