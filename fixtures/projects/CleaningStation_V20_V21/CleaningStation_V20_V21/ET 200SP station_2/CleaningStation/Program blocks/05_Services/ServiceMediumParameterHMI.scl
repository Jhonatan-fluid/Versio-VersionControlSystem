	    END_REGION
	    
	    REGION Get start information / time information
	        #temp16ReturnValueOBNum := RD_SINFO(TOP_SI => #tempTopSi, START_UP_SI => #tempStartSi);
	        #temp16ObNo := #tempTopSi.OB_Nr;
	        #xOB_Start := false;
	        IF (#temp16ObNo = 100) THEN
	            #xOB_Start := true;
	        END_IF;
	        #temp16ReturnStatus := INT_TO_WORD(RD_SYS_T(#tempDTLCurrentTime));
	        
	    END_REGION
	    
	    REGION Initialization
	        IF (#temp16ObNo = 100) THEN
	            //Reset Config para index
	            #ConfigParaType.IndexAnalog := 16#0;
	            #ConfigParaType.IndexDigital := 16#0;
	            #ConfigParaType.IndexBinary := 16#0;
	            #ConfigParaType.IndexString := 16#0;
	            //Reset Procedure para index
	            #ProcedureParaType.IndexAnalog := 16#0;
	            #ProcedureParaType.NameIndexAnalog := 16#0;
	            #ProcedureParaType.IndexDigital := 16#0;
	            #ProcedureParaType.NameIndexDigital := 16#0;
	            #ProcedureParaType.IndexBinary := 16#0;
	            #ProcedureParaType.NameIndexBinary := 16#0;
	            #ProcedureParaType.IndexString := 16#0;
	            #ProcedureParaType.NameIndexString := 16#0;
	            //Reset ProcessIn Value index
	            #ProcessInValueType.IndexAnalog := 16#0;
	            #ProcessInValueType.NameIndexAnalog := 16#0;
	            #ProcessInValueType.IndexDigital := 16#0;
	            #ProcessInValueType.NameIndexDigital := 16#0;
	            #ProcessInValueType.IndexBinary := 16#0;
	            #ProcessInValueType.NameIndexBinary := 16#0;
	            #ProcessInValueType.IndexString := 16#0;
	            #ProcessInValueType.NameIndexString := 16#0;
	            //Reset ProcessOut Value index
	            #ProcessOutValueType.IndexAnalog := 16#0;
	            #ProcessOutValueType.NameIndexAnalog := 16#0;
	            #ProcessOutValueType.IndexDigital := 16#0;
	            #ProcessOutValueType.NameIndexDigital := 16#0;
	            #ProcessOutValueType.IndexBinary := 16#0;
	            #ProcessOutValueType.NameIndexBinary := 16#0;
	            #ProcessOutValueType.IndexString := 16#0;
	            #ProcessOutValueType.NameIndexString := 16#0;
	            //Reset Report Value index
	            #ReportValueType.IndexAnalog := 16#0;
	            #ReportValueType.NameIndexAnalog := 16#0;
	            #ReportValueType.IndexDigital := 16#0;
	            #ReportValueType.NameIndexDigital := 16#0;
	            #ReportValueType.IndexBinary := 16#0;
	            #ReportValueType.NameIndexBinary := 16#0;
	            #ReportValueType.IndexString := 16#0;
	            #ReportValueType.NameIndexString := 16#0;
	            
	        END_IF;
	    END_REGION
	
	    
	    REGION Check DB_ANY of Source
	        // Get the Setup DB UDT info from the Setup DB 
	        #tempVariant := DB_ANY_TO_VARIANT(in := #Setup, err => #temp16ReturnValue);
	        // Validate Setup DB for the service control medium block and move to temp variable
	        IF (#temp16ReturnValue = 0) THEN
	            IF TypeOf(#tempVariant) = "UDT_Service_ControlBlockMedium" THEN
	                #temp16ReturnValue := MOVE_BLK_VARIANT(SRC := #tempVariant, COUNT := 1, SRC_INDEX := 0, DEST_INDEX := 0, DEST => #tempSetup);
	            END_IF;
	        END_IF;
	    END_REGION
	    
	    REGION Configuration parameters
	        //Initialize the used variable values
	        #temp32TempDword1 := 16#1;
	        #temp16IndexAnalog := 16#0;
	        //#ConfigParaType.IndexAnalog := 16#0;
	        #temp16IndexDigital := 16#0;
	        //#ConfigParaType.IndexDigital := 16#0;
	        #temp16IndexBinary := 16#0;
	        //#ConfigParaType.IndexBinary := 16#0;
	        #temp16IndexString := 16#0;
	        //#ConfigParaType.IndexString := 16#0;
	        //Used/Mapped parameter count with individual parameter type will written from the Tool
	        #statTotalConfigParameters := #MAPPED_CONFIG_ANALOG + #MAPPED_CONFIG_DIGITAL + #MAPPED_CONFIG_BINARY + #MAPPED_CONFIG_STRING - 1;//Calculate the total used parameter
	        IF ((#statTotalConfigParameters >= 0) AND (#statTotalConfigParameters <= #CONFIG_PARAMETER_MAX))  THEN
	            FOR #temp16IndexOfDefinition := #CONFIG_PARAMETER_MIN TO #statTotalConfigParameters BY 1 DO//32 config parameters for Medium block.
	                #temp16ParameterCMAddress := BYTE_TO_INT(#tempSetup.configurationParameterData.definition[#temp16IndexOfDefinition].controlModule);//Get CM details from the setup DB.
	                #temp16ParameterType := #tempSetup.configurationParameterData.definition[#temp16IndexOfDefinition].type;//Get parameter type from the setup DB.
	                #temp16IndexMTP := #tempSetup.configurationParameterData.definition[#temp16IndexOfDefinition].indexMTP;//Get parameter indexMTP(wrapper DB) from the setup DB.
	                #temp16IndexIO := #tempSetup.configurationParameterData.definition[#temp16IndexOfDefinition].indexIO;//Get parameter indexIO(service block output config parameter) from the setup DB.
	                #tempUsed := #tempSetup.configurationParameterData.used;//Get parameter used info from setup DB
	                //Condition TO check CMs AND parameter types are in the range
	                IF (#temp16ParameterCMAddress <> 255) AND (#temp16ParameterCMAddress >= #NUMBER_OF_CONTROLMODULES_MIN) AND (#temp16ParameterCMAddress <= #NUMBER_OF_CONTROLMODULES)
	                    AND (#temp16ParameterType >= #TYPE_NONE) AND (#temp16ParameterType <= #TYPE_STRING) THEN
	                    #temp16TempInt1 := #temp16ParameterCMAddress / 32;    //DWORD - Adress
	                    #temp16TempInt2 := #temp16ParameterCMAddress MOD 32;  //Bit - Adress
	                    //If parameter is forced (FRC) --> Parameter is used
	                    IF (((#tempUsed[#temp16TempInt1] AND SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16TempInt2))) <> 0) = TRUE) THEN
	                        CASE #temp16ParameterType OF
	                                // If Parameter type = 1(Analog)
	                            #TYPE_ANALOG:
	                                REGION Analog
	                                    //Bit Masking funtionality for calculate the used Analog parameter
	                                    #ConfigParaType.IndexAnalog := #ConfigParaType.IndexAnalog OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                    //Condition to check the config analog parameters are within range 
	                                    IF ((#temp16IndexIO >= #CONFIG_PARAMETER_MIN) AND (#temp16IndexIO <= #MAPPED_CONFIG_ANALOG)) THEN
	                                        //WinCC Parameter View Faceplate logic
	                                        #ConfigAna[#temp16IndexAnalog].WQC := #ConfigurationParameterAnalog[#temp16IndexMTP].WQC;
	                                        #ConfigAna[#temp16IndexAnalog].ApplyEn := #ConfigurationParameterAnalog[#temp16IndexMTP].ApplyEn;
	                                        #ConfigAna[#temp16IndexAnalog].ApplyInt := #ConfigurationParameterAnalog[#temp16IndexMTP].ApplyInt;
	                                        #ConfigAna[#temp16IndexAnalog].StateChannel := #ConfigurationParameterAnalog[#temp16IndexMTP].StateChannel;
	                                        #ConfigAna[#temp16IndexAnalog].StateOffAut := #ConfigurationParameterAnalog[#temp16IndexMTP].StateOffAut;
	                                        #ConfigAna[#temp16IndexAnalog].StateOpAut := #ConfigurationParameterAnalog[#temp16IndexMTP].StateOpAut;
