	                                        #ConfigString[#temp16IndexString].StateAutAut := #ConfigurationParameterString[#temp16IndexMTP].StateAutAut;
	                                        #ConfigString[#temp16IndexString].StateOffAct := #ConfigurationParameterString[#temp16IndexMTP].StateOffAct;
	                                        #ConfigString[#temp16IndexString].StateOpAct := #ConfigurationParameterString[#temp16IndexMTP].StateOpAct;
	                                        #ConfigString[#temp16IndexString].StateAutAct := #ConfigurationParameterString[#temp16IndexMTP].StateAutAct;
	                                        #ConfigString[#temp16IndexString].SrcChannel := #ConfigurationParameterString[#temp16IndexMTP].SrcChannel;
	                                        #ConfigString[#temp16IndexString].SrcExtAut := #ConfigurationParameterString[#temp16IndexMTP].SrcExtAut;
	                                        #ConfigString[#temp16IndexString].SrcIntAut := #ConfigurationParameterString[#temp16IndexMTP].SrcIntAut;
	                                        #ConfigString[#temp16IndexString].SrcIntAct := #ConfigurationParameterString[#temp16IndexMTP].SrcIntAct;
	                                        #ConfigString[#temp16IndexString].SrcExtAct := #ConfigurationParameterString[#temp16IndexMTP].SrcExtAct;
	                                        #ConfigString[#temp16IndexString].VInt := #ConfigurationParameterString[#temp16IndexMTP].VInt;
	                                        #ConfigString[#temp16IndexString].VReq := #ConfigurationParameterString[#temp16IndexMTP].VReq;
	                                        #ConfigString[#temp16IndexString].VOut := #ConfigurationParameterString[#temp16IndexMTP].VOut;
	                                        #ConfigString[#temp16IndexString].VFbk := #ConfigurationParameterString[#temp16IndexMTP].VFbk;
	                                        //Write values from WinCC
	                                        IF #ConfigurationParameterString[#temp16IndexMTP].OSLevel = #StatConfigString[#temp16IndexString].OSLevel THEN
	                                            #ConfigurationParameterString[#temp16IndexMTP].OSLevel := #ConfigString[#temp16IndexString].OSLevel;
	                                        ELSE
	                                            #ConfigString[#temp16IndexString].OSLevel := #ConfigurationParameterString[#temp16IndexMTP].OSLevel;
	                                        END_IF;
	                                        IF #ConfigurationParameterString[#temp16IndexMTP].ApplyExt = #StatConfigString[#temp16IndexString].ApplyExt THEN
	                                            #ConfigurationParameterString[#temp16IndexMTP].ApplyExt := #ConfigString[#temp16IndexString].ApplyExt;
	                                        ELSE
	                                            #ConfigString[#temp16IndexString].ApplyExt := #ConfigurationParameterString[#temp16IndexMTP].ApplyExt;
	                                        END_IF;
	                                        IF #ConfigurationParameterString[#temp16IndexMTP].ApplyOp = #StatConfigString[#temp16IndexString].ApplyOp THEN
	                                            #ConfigurationParameterString[#temp16IndexMTP].ApplyOp := #ConfigString[#temp16IndexString].ApplyOp;
	                                        ELSE
	                                            #ConfigString[#temp16IndexString].ApplyOp := #ConfigurationParameterString[#temp16IndexMTP].ApplyOp;
	                                        END_IF;
	                                        IF #ConfigurationParameterString[#temp16IndexMTP].Sync = #StatConfigString[#temp16IndexString].Sync THEN
	                                            #ConfigurationParameterString[#temp16IndexMTP].Sync := #ConfigString[#temp16IndexString].Sync;
	                                        ELSE
	                                            #ConfigString[#temp16IndexString].Sync := #ConfigurationParameterString[#temp16IndexMTP].Sync;
	                                        END_IF;
	                                        IF #ConfigurationParameterString[#temp16IndexMTP].StateOffOp = #StatConfigString[#temp16IndexString].StateOffOp THEN
	                                            #ConfigurationParameterString[#temp16IndexMTP].StateOffOp := #ConfigString[#temp16IndexString].StateOffOp;
	                                        ELSE
	                                            #ConfigString[#temp16IndexString].StateOffOp := #ConfigurationParameterString[#temp16IndexMTP].StateOffOp;
	                                        END_IF;
	                                        IF #ConfigurationParameterString[#temp16IndexMTP].StateOpOp = #StatConfigString[#temp16IndexString].StateOpOp THEN
	                                            #ConfigurationParameterString[#temp16IndexMTP].StateOpOp := #ConfigString[#temp16IndexString].StateOpOp;
	                                        ELSE
	                                            #ConfigString[#temp16IndexString].StateOpOp := #ConfigurationParameterString[#temp16IndexMTP].StateOpOp;
	                                        END_IF;
	                                        IF #ConfigurationParameterString[#temp16IndexMTP].StateAutOp = #StatConfigString[#temp16IndexString].StateAutOp THEN
	                                            #ConfigurationParameterString[#temp16IndexMTP].StateAutOp := #ConfigString[#temp16IndexString].StateAutOp;
	                                        ELSE
	                                            #ConfigString[#temp16IndexString].StateAutOp := #ConfigurationParameterString[#temp16IndexMTP].StateAutOp;
	                                        END_IF;
	                                        IF #ConfigurationParameterString[#temp16IndexMTP].SrcIntOp = #StatConfigString[#temp16IndexString].SrcIntOp THEN
	                                            #ConfigurationParameterString[#temp16IndexMTP].SrcIntOp := #ConfigString[#temp16IndexString].SrcIntOp;
	                                        ELSE
	                                            #ConfigString[#temp16IndexString].SrcIntOp := #ConfigurationParameterString[#temp16IndexMTP].SrcIntOp;
	                                        END_IF;
	                                        IF #ConfigurationParameterString[#temp16IndexMTP].SrcExtOp = #StatConfigString[#temp16IndexString].SrcExtOp THEN
	                                            #ConfigurationParameterString[#temp16IndexMTP].SrcExtOp := #ConfigString[#temp16IndexString].SrcExtOp;
	                                        ELSE
	                                            #ConfigString[#temp16IndexString].SrcExtOp := #ConfigurationParameterString[#temp16IndexMTP].SrcExtOp;
	                                        END_IF;
	                                        IF #ConfigurationParameterString[#temp16IndexMTP].VExt = #StatConfigString[#temp16IndexString].VExt THEN
	                                            #ConfigurationParameterString[#temp16IndexMTP].VExt := #ConfigString[#temp16IndexString].VExt;
	                                        ELSE
	                                            #ConfigString[#temp16IndexString].VExt := #ConfigurationParameterString[#temp16IndexMTP].VExt;
	                                        END_IF;
	                                        IF #ConfigurationParameterString[#temp16IndexMTP].VOp = #StatConfigString[#temp16IndexString].VOp THEN
	                                            #ConfigurationParameterString[#temp16IndexMTP].VOp := #ConfigString[#temp16IndexString].VOp;
	                                        ELSE
	                                            #ConfigString[#temp16IndexString].VOp := #ConfigurationParameterString[#temp16IndexMTP].VOp;
	                                        END_IF;
	                                        
	                                        #StatConfigString[#temp16IndexString].OSLevel := #ConfigString[#temp16IndexString].OSLevel;
	                                        #StatConfigString[#temp16IndexString].ApplyExt := #ConfigString[#temp16IndexString].ApplyExt;
	                                        #StatConfigString[#temp16IndexString].ApplyOp := #ConfigString[#temp16IndexString].ApplyOp;
	                                        #StatConfigString[#temp16IndexString].Sync := #ConfigString[#temp16IndexString].Sync;
	                                        #StatConfigString[#temp16IndexString].StateOffOp := #ConfigString[#temp16IndexString].StateOffOp;
	                                        #StatConfigString[#temp16IndexString].StateOpOp := #ConfigString[#temp16IndexString].StateOpOp;
	                                        #StatConfigString[#temp16IndexString].StateAutOp := #ConfigString[#temp16IndexString].StateAutOp;
	                                        #StatConfigString[#temp16IndexString].SrcIntOp := #ConfigString[#temp16IndexString].SrcIntOp;
	                                        #StatConfigString[#temp16IndexString].SrcExtOp := #ConfigString[#temp16IndexString].SrcExtOp;
	                                        #StatConfigString[#temp16IndexString].VExt := #ConfigString[#temp16IndexString].VExt;
	                                        #StatConfigString[#temp16IndexString].VOp := #ConfigString[#temp16IndexString].VOp;
	                                    END_IF;
	                                    #temp16IndexString := #temp16IndexString + 1;
	                                END_REGION
	                        END_CASE;
	                    END_IF;
	                END_IF;
	            END_FOR;
	        END_IF;
	    END_REGION
	   REGION Procedure Parameter
	        REGION Get Current/Prepared procedure ID
	            //Get Current procedure index number from setup DB
	            IF (#ProcedureCur > 0) THEN
	                FOR #temp16i := #NUMBER_OF_PROCEDURES_MIN TO #NUMBER_OF_PROCEDURES BY 1 DO
	                    IF #ProcedureCur = #tempSetup."procedure"."procedure"[#temp16i]."Procedure".ProcedureID THEN
	                        #stat16ProceCurIndex := #temp16i;
	                        EXIT;
	                    END_IF;
	                END_FOR;
	            END_IF;
	            //Get Prepared procedure index number from setup DB
	            IF (#ProcedureReq> 0) THEN
	                FOR #temp16i := #NUMBER_OF_PROCEDURES_MIN TO #NUMBER_OF_PROCEDURES BY 1 DO
	                    IF #ProcedureReq = #tempSetup."procedure"."procedure"[#temp16i]."Procedure".ProcedureID THEN
	                        #stat16ProceReqIndex := #temp16i;
	                        EXIT;
	                    END_IF;
	                END_FOR;
	            END_IF;
	        END_REGION
	        REGION Get Start and End index details of the Current /Prepared procedure
	            //Current/Prepared procedure selection for parameter display in the faceplate
	            IF NOT (#ProcedureParaType.ProcedureReqCurInd) THEN
	                //Get current Procedure step order details from Starting State
	                #tempProcStartingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.starting.startIndex;
	                #tempProcStartingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.starting.endIndex;
	                //Get current Procedure step order details from Running State
	                #tempProcRunningStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.running.startIndex;
	                #tempProcRunningEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.running.endIndex;
	                //Get current Procedure step order details from Holding State
	                #tempProcHoldingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.holding.startIndex;
	                #tempProcHoldingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.holding.endIndex;
	                //Get current Procedure step order details from unholding State
	                #tempProcUnHoldingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.unholding.startIndex;
	                #tempProcUnHoldingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.unholding.endIndex;
	                //Get current Procedure step order details from pausing State
	                #tempProcUnPausingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.pausing.startIndex;
	                #tempProcUnPausingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.pausing.endIndex;
	                //Get current Procedure step order details from resuming State
	                #tempProcResumingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.resuming.startIndex;
	                #tempProcResumingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.resuming.endIndex;
	                //Get current Procedure step order details from completing State
	                #tempProcCompletingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.completing.startIndex;
	                #tempProcCompletingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.completing.endIndex;
	                //Get current Procedure step order details from stopping State
	                #tempProcStoppingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.stopping.startIndex;
	                #tempProcStoppingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.stopping.endIndex;
	                //Get current Procedure step order details from aborting State
	                #tempProcAbortingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.aborting.startIndex;
	                #tempProcAbortingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.aborting.endIndex;
	                //Get current Procedure step order details from resetting State
	                #tempProcResettingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.resetting.startIndex;
	                #tempProcResettingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].StateTransient.resetting.endIndex;
	                
	            ELSIF (#ProcedureParaType.ProcedureReqCurInd) THEN
	                //Get current Procedure step order details from Starting State
	                #tempProcStartingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.starting.startIndex;
	                #tempProcStartingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.starting.endIndex;
	                //Get current Procedure step order details from Running State
	                #tempProcRunningStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.running.startIndex;
	                #tempProcRunningEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.running.endIndex;
	                //Get current Procedure step order details from Holding State
	                #tempProcHoldingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.holding.startIndex;
	                #tempProcHoldingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.holding.endIndex;
	                //Get current Procedure step order details from unholding State
	                #tempProcUnHoldingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.unholding.startIndex;
	                #tempProcUnHoldingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.unholding.endIndex;
	                //Get current Procedure step order details from pausing State
	                #tempProcUnPausingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.pausing.startIndex;
	                #tempProcUnPausingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.pausing.endIndex;
	                //Get current Procedure step order details from resuming State
	                #tempProcResumingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.resuming.startIndex;
	                #tempProcResumingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.resuming.endIndex;
	                //Get current Procedure step order details from completing State
	                #tempProcCompletingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.completing.startIndex;
	                #tempProcCompletingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.completing.endIndex;
	                //Get current Procedure step order details from stopping State
	                #tempProcStoppingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.stopping.startIndex;
	                #tempProcStoppingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.stopping.endIndex;
	                //Get current Procedure step order details from aborting State
	                #tempProcAbortingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.aborting.startIndex;
	                #tempProcAbortingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.aborting.endIndex;
	                //Get current Procedure step order details from resetting State
	                #tempProcResettingStartIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.resetting.startIndex;
	                #tempProcResettingEndIndex := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].StateTransient.resetting.endIndex;
	            END_IF;
	            
	            #tempProcStartIndex := -1;
	            #tempProcEndIndex := -1;
	            //Get the Start and End index from the States
	            IF (#tempProcStartingStartIndex > -1) AND (#tempProcStartingEndIndex > -1) THEN
	                #tempProcStartIndex := #tempProcStartingStartIndex;
	                #tempProcEndIndex := #tempProcStartingEndIndex;
	            ELSIF (#tempProcRunningStartIndex > -1) AND (#tempProcRunningEndIndex > -1) THEN
	                #tempProcStartIndex := #tempProcRunningStartIndex;
	                #tempProcEndIndex := #tempProcRunningEndIndex;
	            ELSIF (#tempProcHoldingStartIndex > -1) AND (#tempProcHoldingEndIndex > -1) THEN
	                #tempProcStartIndex := #tempProcHoldingStartIndex;
	                #tempProcEndIndex := #tempProcHoldingEndIndex;
	            ELSIF (#tempProcUnHoldingStartIndex > -1) AND (#tempProcUnHoldingEndIndex > -1) THEN
	                #tempProcStartIndex := #tempProcUnHoldingStartIndex;
	                #tempProcEndIndex := #tempProcUnHoldingEndIndex;
	            ELSIF (#tempProcUnPausingStartIndex > -1) AND (#tempProcUnPausingEndIndex > -1) THEN
	                #tempProcStartIndex := #tempProcUnPausingStartIndex;
	                #tempProcEndIndex := #tempProcUnPausingEndIndex;
	            ELSIF (#tempProcResumingStartIndex > -1) AND (#tempProcResumingEndIndex > -1) THEN
	                #tempProcStartIndex := #tempProcResumingStartIndex;
	                #tempProcEndIndex := #tempProcResumingEndIndex;
	            ELSIF (#tempProcCompletingStartIndex > -1) AND (#tempProcCompletingEndIndex > -1) THEN
	                #tempProcStartIndex := #tempProcCompletingStartIndex;
	                #tempProcEndIndex := #tempProcCompletingEndIndex;
	            ELSIF (#tempProcStoppingStartIndex > -1) AND (#tempProcStoppingEndIndex > -1) THEN
	                #tempProcStartIndex := #tempProcStoppingStartIndex;
	                #tempProcEndIndex := #tempProcStoppingEndIndex;
	            ELSIF (#tempProcAbortingStartIndex > -1) AND (#tempProcAbortingEndIndex > -1) THEN
	                #tempProcStartIndex := #tempProcAbortingStartIndex;
	                #tempProcEndIndex := #tempProcAbortingEndIndex;
	            ELSIF (#tempProcResettingStartIndex > -1) AND (#tempProcResettingEndIndex > -1) THEN
	                #tempProcStartIndex := #tempProcResettingStartIndex;
	                #tempProcEndIndex := #tempProcResettingEndIndex;
	            END_IF;
	            
	            //Get Current Procedure step order parameter index details
	            IF (#tempProcStartIndex > -1) AND (#tempProcEndIndex > -1) THEN
	                #stat16ProcParaStartIndex := #tempSetup.stepOrder.stepOrder[#tempProcStartIndex].parameter.startIndex;
	                #stat16ProcParaEndIndex := #tempSetup.stepOrder.stepOrder[#tempProcEndIndex].parameter.endIndex;
	            END_IF;
	        END_REGION
	
	        
	        REGION Get mapped/used procedure parameters and move to the procedure parameter FP variables
	            // Condition to check the start and end index values is within the range
	            IF ((#stat16ProcParaStartIndex >= #PARAMETERINDEX_MIN) AND (#stat16ProcParaStartIndex <= #PARAMETERINDEX_MAX))
	                AND ((#stat16ProcParaEndIndex >= #PARAMETERINDEX_MIN) AND (#stat16ProcParaEndIndex <= #PARAMETERINDEX_MAX))
	                AND ((#stat16ProcParaEndIndex - #stat16ProcParaStartIndex + #PROCEDURE_PARAMETER_MIN) <= #PROCEDURE_PARAMETER_MAX) THEN
	                
	                //Initialize the used variable values
	                #temp32TempDword1 := 16#1;
	                #temp16IndexAnalog := 16#0;
	                #temp16IndexDigital := 16#0;
	                #temp16IndexBinary := 16#0;
	                #temp16IndexString := 16#0;
	                //Initialize the Procedure Para index and Name index while changing of Procedure and changing of screen selection b/w Prepared and Current procedure
	                IF ((#statLasProcedureCur <> #ProcedureCur) OR (#statLasProcedureReq <> #ProcedureReq) OR (#statLastReqProcedSelected <> #ProcedureParaType.ProcedureReqCurInd)) THEN
	                    #ProcedureParaType.IndexAnalog := 16#0;
	                    #ProcedureParaType.NameIndexAnalog := 16#0;
	                    #ProcedureParaType.IndexDigital := 16#0;
	                    #ProcedureParaType.NameIndexDigital := 16#0;
	                    #ProcedureParaType.IndexBinary := 16#0;
	                    #ProcedureParaType.NameIndexBinary := 16#0;
	                    #ProcedureParaType.IndexString := 16#0;
	                    #ProcedureParaType.NameIndexString := 16#0;
	                END_IF;
	                IF (((#ProcedureCur <> 16#0) AND NOT #ProcedureParaType.ProcedureReqCurInd) OR ((#ProcedureReq <> 16#0) AND #ProcedureParaType.ProcedureReqCurInd)) THEN
	                    //Used/Mapped parameter count with individual parameter type will written from the Tool
	                    #statTotalProcedureParameters := #MAPPED_PROCEDURE_ANALOG + #MAPPED_PROCEDURE_DIGITAL + #MAPPED_PROCEDURE_BINARY + #MAPPED_PROCEDURE_STRING - 1;
	                    IF ((#statTotalProcedureParameters >= 0) AND (#statTotalProcedureParameters <= #PROCEDURE_PARAMETER_MAX)) THEN
	                        FOR #temp16IndexOfDefinition := #PROCEDURE_PARAMETER_MIN TO #statTotalProcedureParameters BY 1 DO
	                            // Condition for allow the loop iteration only within the start and end index
	                            IF (((#stat16ProcParaEndIndex - #stat16ProcParaStartIndex) - #temp16IndexOfDefinition + #PROCEDURE_PARAMETER_MIN) >= 0) THEN
	                                #statInternalCurProcParameter[#temp16IndexOfDefinition].index := #tempSetup.stepOrder.parameterIndex[#stat16ProcParaStartIndex + #temp16IndexOfDefinition];  // MiS: content of first parameterIndex to first internal index, content of second parameterIndex to second internal index etc.
	                                #temp16Index := #statInternalCurProcParameter[#temp16IndexOfDefinition].index;//Move index info to the local var
	                                #temp16ParameterType := #tempSetup.step.parameterDefinition[#temp16Index].type;  // Get type of current parameter
	                                #temp16IndexMTP := #tempSetup.step.parameterDefinition[#temp16Index].indexMTP;//Get parameter indexMTP(wrapper DB) from the setup DB.
	                                #temp16IndexIO := #tempSetup.step.parameterDefinition[#temp16Index].indexIO;
	                                //Condition TO check parameter types are in the range
	                                IF (#temp16ParameterType >= #TYPE_NONE) AND (#temp16ParameterType <= #TYPE_STRING) THEN
	                                    REGION Copy procedure parameters from input
	                                        CASE #temp16ParameterType OF
	                                                // If Parameter type = 1(Analog)
	                                            #TYPE_ANALOG:
	                                                REGION Analog
	                                                    //Bit Masking funtionality for calculate the used Analog parameter and Position of the Parameter name in the HMI Text List                                              
	                                                    #ProcedureParaType.IndexAnalog := #ProcedureParaType.IndexAnalog OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                                    #ProcedureParaType.NameIndexAnalog := #ProcedureParaType.NameIndexAnalog OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16Index));
	                                                    //WinCC Parameter View Faceplate logic
	                                                    //#StatConfigPara.Analog[#temp16IndexIO] := #MTPConfigurationParameterAnalog[#temp16IndexMTP];
	                                                    #ProcedureAna[#temp16IndexAnalog].WQC := #ProcedureParameterAnalog[#temp16IndexMTP].WQC;
	                                                    #ProcedureAna[#temp16IndexAnalog].ApplyEn := #ProcedureParameterAnalog[#temp16IndexMTP].ApplyEn;
	                                                    #ProcedureAna[#temp16IndexAnalog].ApplyInt := #ProcedureParameterAnalog[#temp16IndexMTP].ApplyInt;
	                                                    #ProcedureAna[#temp16IndexAnalog].StateChannel := #ProcedureParameterAnalog[#temp16IndexMTP].StateChannel;
	                                                    #ProcedureAna[#temp16IndexAnalog].StateOffAut := #ProcedureParameterAnalog[#temp16IndexMTP].StateOffAut;
	                                                    #ProcedureAna[#temp16IndexAnalog].StateOpAut := #ProcedureParameterAnalog[#temp16IndexMTP].StateOpAut;
	                                                    #ProcedureAna[#temp16IndexAnalog].StateAutAut := #ProcedureParameterAnalog[#temp16IndexMTP].StateAutAut;
	                                                    #ProcedureAna[#temp16IndexAnalog].StateOffAct := #ProcedureParameterAnalog[#temp16IndexMTP].StateOffAct;
	                                                    #ProcedureAna[#temp16IndexAnalog].StateOpAct := #ProcedureParameterAnalog[#temp16IndexMTP].StateOpAct;
	                                                    #ProcedureAna[#temp16IndexAnalog].StateAutAct := #ProcedureParameterAnalog[#temp16IndexMTP].StateAutAct;
	                                                    #ProcedureAna[#temp16IndexAnalog].SrcChannel := #ProcedureParameterAnalog[#temp16IndexMTP].SrcChannel;
	                                                    #ProcedureAna[#temp16IndexAnalog].SrcExtAut := #ProcedureParameterAnalog[#temp16IndexMTP].SrcExtAut;
	                                                    #ProcedureAna[#temp16IndexAnalog].SrcIntAut := #ProcedureParameterAnalog[#temp16IndexMTP].SrcIntAut;
	                                                    #ProcedureAna[#temp16IndexAnalog].SrcIntAct := #ProcedureParameterAnalog[#temp16IndexMTP].SrcIntAct;
	                                                    #ProcedureAna[#temp16IndexAnalog].SrcExtAct := #ProcedureParameterAnalog[#temp16IndexMTP].SrcExtAct;
	                                                    #ProcedureAna[#temp16IndexAnalog].VInt := #ProcedureParameterAnalog[#temp16IndexMTP].VInt;
	                                                    #ProcedureAna[#temp16IndexAnalog].VReq := #ProcedureParameterAnalog[#temp16IndexMTP].VReq;
	                                                    #ProcedureAna[#temp16IndexAnalog].VOut := #ProcedureParameterAnalog[#temp16IndexMTP].VOut;
	                                                    #ProcedureAna[#temp16IndexAnalog].VFbk := #ProcedureParameterAnalog[#temp16IndexMTP].VFbk;
	                                                    #ProcedureAna[#temp16IndexAnalog].VSclMin := #ProcedureParameterAnalog[#temp16IndexMTP].VSclMin;
	                                                    #ProcedureAna[#temp16IndexAnalog].VSclMax := #ProcedureParameterAnalog[#temp16IndexMTP].VSclMax;
	                                                    #ProcedureAna[#temp16IndexAnalog].VUnit := #ProcedureParameterAnalog[#temp16IndexMTP].VUnit;
	                                                    #ProcedureAna[#temp16IndexAnalog].VMin := #ProcedureParameterAnalog[#temp16IndexMTP].VMin;
	                                                    #ProcedureAna[#temp16IndexAnalog].VMax := #ProcedureParameterAnalog[#temp16IndexMTP].VMax;
	                                                    //Write values from WinCC
	                                                    IF #ProcedureParameterAnalog[#temp16IndexMTP].OSLevel = #StatProcedureAnalog[#temp16IndexAnalog].OSLevel THEN
	                                                        #ProcedureParameterAnalog[#temp16IndexMTP].OSLevel := #ProcedureAna[#temp16IndexAnalog].OSLevel;
	                                                    ELSE
	                                                        #ProcedureAna[#temp16IndexAnalog].OSLevel := #ProcedureParameterAnalog[#temp16IndexMTP].OSLevel;
	                                                    END_IF;
	                                                    IF #ProcedureParameterAnalog[#temp16IndexMTP].ApplyExt = #StatProcedureAnalog[#temp16IndexAnalog].ApplyExt THEN
	                                                        #ProcedureParameterAnalog[#temp16IndexMTP].ApplyExt := #ProcedureAna[#temp16IndexAnalog].ApplyExt;
	                                                    ELSE
	                                                        #ProcedureAna[#temp16IndexAnalog].ApplyExt := #ProcedureParameterAnalog[#temp16IndexMTP].ApplyExt;
	                                                    END_IF;
	                                                    IF #ProcedureParameterAnalog[#temp16IndexMTP].ApplyOp = #StatProcedureAnalog[#temp16IndexAnalog].ApplyOp THEN
	                                                        #ProcedureParameterAnalog[#temp16IndexMTP].ApplyOp := #ProcedureAna[#temp16IndexAnalog].ApplyOp;
	                                                    ELSE
	                                                        #ProcedureAna[#temp16IndexAnalog].ApplyOp := #ProcedureParameterAnalog[#temp16IndexMTP].ApplyOp;
	                                                    END_IF;
	                                                    IF #ProcedureParameterAnalog[#temp16IndexMTP].Sync = #StatProcedureAnalog[#temp16IndexAnalog].Sync THEN
	                                                        #ProcedureParameterAnalog[#temp16IndexMTP].Sync := #ProcedureAna[#temp16IndexAnalog].Sync;
	                                                    ELSE
	                                                        #ProcedureAna[#temp16IndexAnalog].Sync := #ProcedureParameterAnalog[#temp16IndexMTP].Sync;
	                                                    END_IF;
	                                                    IF #ProcedureParameterAnalog[#temp16IndexMTP].StateOffOp = #StatProcedureAnalog[#temp16IndexAnalog].StateOffOp THEN
	                                                        #ProcedureParameterAnalog[#temp16IndexMTP].StateOffOp := #ProcedureAna[#temp16IndexAnalog].StateOffOp;
	                                                    ELSE
	                                                        #ProcedureAna[#temp16IndexAnalog].StateOffOp := #ProcedureParameterAnalog[#temp16IndexMTP].StateOffOp;
