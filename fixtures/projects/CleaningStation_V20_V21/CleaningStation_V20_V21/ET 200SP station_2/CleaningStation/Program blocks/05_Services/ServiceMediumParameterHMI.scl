      ProcessInString { S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCESS_IN_STRING] of "UDT_MTP_StringProcessValueIn";   // Process In string values
      ProcessOutAna { S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCESS_OUT_ANALOG] of "UDT_MTP_AnaProcessValueOut";   // Process Out analog values
      ProcessOutDint { S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCESS_OUT_DIGITAL] of "UDT_MTP_DIntProcessValueOut";   // Process Out digital values
      ProcessOutBin { S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCESS_OUT_BINARY] of "UDT_MTP_BinProcessValueOut";   // Process Out binary values
      ProcessOutString { S7_SetPoint := 'False'} : Array[0..#MAPPED_PROCESS_OUT_STRING] of "UDT_MTP_StringProcessValueOut";   // Process Out string values
      ReportAna { S7_SetPoint := 'False'} : Array[0..#MAPPED_REPORT_ANALOG] of "UDT_MTP_AnaReportValue";   // Report analog values
      ReportDint { S7_SetPoint := 'False'} : Array[0..#MAPPED_REPORT_DIGITAL] of "UDT_MTP_DIntReportValue";   // Report digital values
      ReportBin { S7_SetPoint := 'False'} : Array[0..#MAPPED_REPORT_BINARY] of "UDT_MTP_BinReportValue";   // Report binary values
      ReportString { S7_SetPoint := 'False'} : Array[0..#MAPPED_REPORT_STRING] of "UDT_MTP_StringReportValue";   // Report string values
      statInternalCurProcParameter { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[#PROCEDURE_PARAMETER_MIN..#PROCEDURE_PARAMETER_MAX] of "UDT_Service_Parameter";   // Internal Procedure Parameter
      statLasProcedureCur { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : DWord;   // Last current procedure
      statLasProcedureReq { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : DWord;   // Last Prepared procedure
      statLastReqProcedSelected { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;   // Last Prepared procedure
      StatLastProceselReport { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;   // Last  procedure page selection in Report values FP
      StatLastProceselProcessOut { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;   // Last  procedure page selection in ProcessOut values FP
      StatLastProceselProcessIn { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;   // Last  procedure page selection in ProcessIn values FP
   END_VAR

