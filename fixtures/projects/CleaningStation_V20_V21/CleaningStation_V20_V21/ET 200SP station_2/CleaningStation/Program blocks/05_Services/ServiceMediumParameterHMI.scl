	                                                        #ProcedureString[#temp16IndexString].ApplyExt := #ProcedureParameterString[#temp16IndexMTP].ApplyExt;
	                                                    END_IF;
	                                                    IF #ProcedureParameterString[#temp16IndexMTP].ApplyOp = #StatProcedureString[#temp16IndexString].ApplyOp THEN
	                                                        #ProcedureParameterString[#temp16IndexMTP].ApplyOp := #ProcedureString[#temp16IndexString].ApplyOp;
	                                                    ELSE
	                                                        #ProcedureString[#temp16IndexString].ApplyOp := #ProcedureParameterString[#temp16IndexMTP].ApplyOp;
	                                                    END_IF;
	                                                    IF #ProcedureParameterString[#temp16IndexMTP].Sync = #StatProcedureString[#temp16IndexString].Sync THEN
	                                                        #ProcedureParameterString[#temp16IndexMTP].Sync := #ProcedureString[#temp16IndexString].Sync;
	                                                    ELSE
	                                                        #ProcedureString[#temp16IndexString].Sync := #ProcedureParameterString[#temp16IndexMTP].Sync;
	                                                    END_IF;
	                                                    IF #ProcedureParameterString[#temp16IndexMTP].StateOffOp = #StatProcedureString[#temp16IndexString].StateOffOp THEN
	                                                        #ProcedureParameterString[#temp16IndexMTP].StateOffOp := #ProcedureString[#temp16IndexString].StateOffOp;
	                                                    ELSE
	                                                        #ProcedureString[#temp16IndexString].StateOffOp := #ProcedureParameterString[#temp16IndexMTP].StateOffOp;
	                                                    END_IF;
	                                                    IF #ProcedureParameterString[#temp16IndexMTP].StateOpOp = #StatProcedureString[#temp16IndexString].StateOpOp THEN
	                                                        #ProcedureParameterString[#temp16IndexMTP].StateOpOp := #ProcedureString[#temp16IndexString].StateOpOp;
	                                                    ELSE
	                                                        #ProcedureString[#temp16IndexString].StateOpOp := #ProcedureParameterString[#temp16IndexMTP].StateOpOp;
	                                                    END_IF;
	                                                    IF #ProcedureParameterString[#temp16IndexMTP].StateAutOp = #StatProcedureString[#temp16IndexString].StateAutOp THEN
	                                                        #ProcedureParameterString[#temp16IndexMTP].StateAutOp := #ProcedureString[#temp16IndexString].StateAutOp;
	                                                    ELSE
	                                                        #ProcedureString[#temp16IndexString].StateAutOp := #ProcedureParameterString[#temp16IndexMTP].StateAutOp;
	                                                    END_IF;
	                                                    IF #ProcedureParameterString[#temp16IndexMTP].SrcIntOp = #StatProcedureString[#temp16IndexString].SrcIntOp THEN
	                                                        #ProcedureParameterString[#temp16IndexMTP].SrcIntOp := #ProcedureString[#temp16IndexString].SrcIntOp;
	                                                    ELSE
	                                                        #ProcedureString[#temp16IndexString].SrcIntOp := #ProcedureParameterString[#temp16IndexMTP].SrcIntOp;
	                                                    END_IF;
	                                                    IF #ProcedureParameterString[#temp16IndexMTP].SrcExtOp = #StatProcedureString[#temp16IndexString].SrcExtOp THEN
	                                                        #ProcedureParameterString[#temp16IndexMTP].SrcExtOp := #ProcedureString[#temp16IndexString].SrcExtOp;
	                                                    ELSE
	                                                        #ProcedureString[#temp16IndexString].SrcExtOp := #ProcedureParameterString[#temp16IndexMTP].SrcExtOp;
	                                                    END_IF;
	                                                    IF #ProcedureParameterString[#temp16IndexMTP].VExt = #StatProcedureString[#temp16IndexString].VExt THEN
	                                                        #ProcedureParameterString[#temp16IndexMTP].VExt := #ProcedureString[#temp16IndexString].VExt;
	                                                    ELSE
	                                                        #ProcedureString[#temp16IndexString].VExt := #ProcedureParameterString[#temp16IndexMTP].VExt;
	                                                    END_IF;
	                                                    IF #ProcedureParameterString[#temp16IndexMTP].VOp = #StatProcedureString[#temp16IndexString].VOp THEN
	                                                        #ProcedureParameterString[#temp16IndexMTP].VOp := #ProcedureString[#temp16IndexString].VOp;
	                                                    ELSE
	                                                        #ProcedureString[#temp16IndexString].VOp := #ProcedureParameterString[#temp16IndexMTP].VOp;
	                                                    END_IF;
	                                                    
	                                                    #StatProcedureString[#temp16IndexString].OSLevel := #ProcedureString[#temp16IndexString].OSLevel;
	                                                    #StatProcedureString[#temp16IndexString].ApplyExt := #ProcedureString[#temp16IndexString].ApplyExt;
	                                                    #StatProcedureString[#temp16IndexString].ApplyOp := #ProcedureString[#temp16IndexString].ApplyOp;
	                                                    #StatProcedureString[#temp16IndexString].Sync := #ProcedureString[#temp16IndexString].Sync;
	                                                    #StatProcedureString[#temp16IndexString].StateOffOp := #ProcedureString[#temp16IndexString].StateOffOp;
	                                                    #StatProcedureString[#temp16IndexString].StateOpOp := #ProcedureString[#temp16IndexString].StateOpOp;
	                                                    #StatProcedureString[#temp16IndexString].StateAutOp := #ProcedureString[#temp16IndexString].StateAutOp;
	                                                    #StatProcedureString[#temp16IndexString].SrcIntOp := #ProcedureString[#temp16IndexString].SrcIntOp;
	                                                    #StatProcedureString[#temp16IndexString].SrcExtOp := #ProcedureString[#temp16IndexString].SrcExtOp;
	                                                    #StatProcedureString[#temp16IndexString].VExt := #ProcedureString[#temp16IndexString].VExt;
	                                                    #StatProcedureString[#temp16IndexString].VOp := #ProcedureString[#temp16IndexString].VOp;
	                                                    
	                                                    #temp16IndexString := #temp16IndexString + 1;
	                                                END_REGION
	                                        END_CASE;
	                                    END_REGION
	                                END_IF;
	                            END_IF;
	                        END_FOR;
	                    END_IF;
	                END_IF;
	            END_IF;
	        END_REGION
	    END_REGION
	    
	    REGION Process In Values
	        
	        REGION Get Start and End index details of the Current /Prepared procedure
	            //Current/Prepared procedure selection for parameter display in the faceplate
	            //#stat32PrecedureProcessInMap := -1;
	            IF NOT (#ProcessInValueType.ProcedureReqCurInd) THEN
	                #stat32PrecedureProcessInMap := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].ProcedureProcessInMap[0];
	            ELSIF (#ProcessInValueType.ProcedureReqCurInd) THEN
	                #stat32PrecedureProcessInMap := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].ProcedureProcessInMap[0];
	            END_IF;
	        END_REGION
	        //Initialize the used variable values        
	        #temp32TempDword1 := 16#1;
	        #temp16IndexAnalog := 16#0;
	        #temp16IndexDigital := 16#0;
	        #temp16IndexBinary := 16#0;
	        #temp16IndexString := 16#0;
	        //Initialize the Process In Value index and Name index while changing of Procedure and changing of screen selection b/w Prepared and Current procedure
	        IF ((#statLasProcedureCur <> #ProcedureCur) OR (#statLasProcedureReq <> #ProcedureReq) OR (#StatLastProceselProcessIn <> #ProcessInValueType.ProcedureReqCurInd)
	            OR (((#ProcedureCur = 16#0) AND NOT #ProcessInValueType.ProcedureReqCurInd) OR ((#ProcedureReq = 16#0) AND #ProcessInValueType.ProcedureReqCurInd))) THEN
	            #ProcessInValueType.IndexAnalog := 16#0;
	            #ProcessInValueType.NameIndexAnalog := 16#0;
	            #ProcessInValueType.IndexDigital := 16#0;
	            #ProcessInValueType.NameIndexDigital := 16#0;
	            #ProcessInValueType.IndexBinary := 16#0;
	            #ProcessInValueType.NameIndexBinary := 16#0;
	            #ProcessInValueType.IndexString := 16#0;
	            #ProcessInValueType.NameIndexString := 16#0;
	        END_IF;
	        //Used/Mapped parameter count with individual parameter type will written from the Tool
	        #statTotalProcessInValues := #MAPPED_PROCESS_IN_ANALOG + #MAPPED_PROCESS_IN_DIGITAL + #MAPPED_PROCESS_IN_BINARY + #MAPPED_PROCESS_IN_STRING - 1;
	        IF (((#ProcedureCur <> 16#0) AND NOT #ProcessInValueType.ProcedureReqCurInd) OR ((#ProcedureReq <> 16#0) AND #ProcessInValueType.ProcedureReqCurInd)) THEN
	            IF ((#statTotalProcessInValues >= 0) AND (#statTotalProcessInValues <= #PROCESS_VALUES_IN_MAX)) THEN
	                #temp16IndexOfDefinitionProcessIn := 16#0;
	                FOR #temp16IndexOfDefinition := #PROCESS_VALUES_IN_MIN TO #statTotalProcessInValues BY 1 DO
	                    #temp16ParameterCMAddress := BYTE_TO_INT(#tempSetup.processValueInData.definition[#temp16IndexOfDefinition].controlModule);
	                    #temp16ParameterType := #tempSetup.processValueInData.definition[#temp16IndexOfDefinition].type;
	                    #temp16IndexMTP := #tempSetup.processValueInData.definition[#temp16IndexOfDefinition].indexMTP;
	                    #tempUsed := #tempSetup.processValueInData.used;
	                    // Find the procedure information assigned with the processIn values
	                    IF (((#stat32PrecedureProcessInMap AND SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition))) <> 0) = TRUE) THEN
	                        #temp16IndexIO := #tempSetup.processValueInData.definition[#temp16IndexOfDefinition].indexIO;
	                        
	                        IF (#temp16ParameterCMAddress <> 255) AND (#temp16ParameterCMAddress >= #NUMBER_OF_CONTROLMODULES_MIN) AND (#temp16ParameterCMAddress <= #NUMBER_OF_CONTROLMODULES)
	                            AND (#temp16ParameterType >= #TYPE_NONE) AND (#temp16ParameterType <= #TYPE_STRING) THEN
	                            #temp16TempInt1 := #temp16ParameterCMAddress / 32;    //DWORD - Adress
	                            #temp16TempInt2 := #temp16ParameterCMAddress MOD 32;  //Bit - Adress
	                            //If parameter is forced (FRC) --> Parameter is used
	                            IF (((#tempUsed[#temp16TempInt1] AND SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16TempInt2))) <> 0) = TRUE) THEN
	                                CASE #temp16ParameterType OF
	                                        // Check of mode is done in satellite blocks
	                                    #TYPE_ANALOG:
	                                        REGION Analog
	                                            //Bit Masking funtionality for calculate the used Analog parameter and Position of the Parameter name in the HMI Text List 
	                                            #ProcessInValueType.IndexAnalog := #ProcessInValueType.IndexAnalog OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionProcessIn));
	                                            #ProcessInValueType.NameIndexAnalog := #ProcessInValueType.NameIndexAnalog OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #PROCESS_VALUES_IN_MIN) AND (#temp16IndexIO <= #PROCESS_VALUES_IN_ANALOG_MAX)) THEN
	                                                //WinCC Parameter View Faceplate logic
	                                                #ProcessInAna[#temp16IndexAnalog].WQC := #ProcessValueInAnalog[#temp16IndexMTP].WQC;
	                                                #ProcessInAna[#temp16IndexAnalog].OSLevel := #ProcessValueInAnalog[#temp16IndexMTP].OSLevel;
	                                                #ProcessInAna[#temp16IndexAnalog].V := #ProcessValueInAnalog[#temp16IndexMTP].V;
	                                                #ProcessInAna[#temp16IndexAnalog].VQC := #ProcessValueInAnalog[#temp16IndexMTP].VQC;
	                                                #ProcessInAna[#temp16IndexAnalog].SclMinCur := #ProcessValueInAnalog[#temp16IndexMTP].SclMinCur;
	                                                #ProcessInAna[#temp16IndexAnalog].SclMaxCur := #ProcessValueInAnalog[#temp16IndexMTP].SclMaxCur;
	                                                #ProcessInAna[#temp16IndexAnalog].UnitCur := #ProcessValueInAnalog[#temp16IndexMTP].UnitCur;
	                                                #ProcessInAna[#temp16IndexAnalog].SclMinExt := #ProcessValueInAnalog[#temp16IndexMTP].SclMinExt;
	                                                #ProcessInAna[#temp16IndexAnalog].SclMaxExt := #ProcessValueInAnalog[#temp16IndexMTP].SclMaxExt;
	                                                #ProcessInAna[#temp16IndexAnalog].UnitExt := #ProcessValueInAnalog[#temp16IndexMTP].UnitExt;
	                                                #ProcessInAna[#temp16IndexAnalog].Apply := #ProcessValueInAnalog[#temp16IndexMTP].Apply;
	                                                #ProcessInAna[#temp16IndexAnalog].ApplyEn := #ProcessValueInAnalog[#temp16IndexMTP].ApplyEn;
	                                            END_IF;
	                                            #temp16IndexAnalog := #temp16IndexAnalog + 1;
	                                        END_REGION
	                                    #TYPE_DIGITAL:
	                                        REGION Digital
	                                            //Bit Masking funtionality for calculate the used Digital parameter and Position of the Parameter name in the HMI Text List 
	                                            #ProcessInValueType.IndexDigital := #ProcessInValueType.IndexDigital OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionProcessIn));
	                                            #ProcessInValueType.NameIndexDigital := #ProcessInValueType.NameIndexDigital OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #PROCESS_VALUES_IN_MIN) AND (#temp16IndexIO <= #PROCESS_VALUES_IN_DIGITAL_MAX)) THEN
	                                                //WinCC Parameter View Faceplate logic
	                                                #ProcessInDint[#temp16IndexDigital].WQC := #ProcessValueInDigital[#temp16IndexMTP].WQC;
	                                                #ProcessInDint[#temp16IndexDigital].OSLevel := #ProcessValueInDigital[#temp16IndexMTP].OSLevel;
	                                                #ProcessInDint[#temp16IndexDigital].V := #ProcessValueInDigital[#temp16IndexMTP].V;
	                                                #ProcessInDint[#temp16IndexDigital].VQC := #ProcessValueInDigital[#temp16IndexMTP].VQC;
	                                                #ProcessInDint[#temp16IndexDigital].SclMinCur := #ProcessValueInDigital[#temp16IndexMTP].SclMinCur;
	                                                #ProcessInDint[#temp16IndexDigital].SclMaxCur := #ProcessValueInDigital[#temp16IndexMTP].SclMaxCur;
	                                                #ProcessInDint[#temp16IndexDigital].UnitCur := #ProcessValueInDigital[#temp16IndexMTP].UnitCur;
	                                                #ProcessInDint[#temp16IndexDigital].SclMinExt := #ProcessValueInDigital[#temp16IndexMTP].SclMinExt;
	                                                #ProcessInDint[#temp16IndexDigital].SclMaxExt := #ProcessValueInDigital[#temp16IndexMTP].SclMaxExt;
	                                                #ProcessInDint[#temp16IndexDigital].UnitExt := #ProcessValueInDigital[#temp16IndexMTP].UnitExt;
	                                                #ProcessInDint[#temp16IndexDigital].Apply := #ProcessValueInDigital[#temp16IndexMTP].Apply;
	                                                #ProcessInDint[#temp16IndexDigital].ApplyEn := #ProcessValueInDigital[#temp16IndexMTP].ApplyEn;
	                                            END_IF;
	                                            #temp16IndexDigital := #temp16IndexDigital + 1;
	                                        END_REGION
	                                    #TYPE_BINARY:
	                                        REGION Binary
	                                            //Bit Masking funtionality for calculate the used Binary parameter and Position of the Parameter name in the HMI Text List 
	                                            #ProcessInValueType.IndexBinary := #ProcessInValueType.IndexBinary OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionProcessIn));
	                                            #ProcessInValueType.NameIndexBinary := #ProcessInValueType.NameIndexBinary OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #PROCESS_VALUES_IN_MIN) AND (#temp16IndexIO <= #PROCESS_VALUES_IN_BINARY_MAX)) THEN
	                                                //WinCC Parameter View Faceplate logic
	                                                #ProcessInBin[#temp16IndexBinary].WQC := #ProcessValueInBinary[#temp16IndexMTP].WQC;
	                                                #ProcessInBin[#temp16IndexBinary].V := #ProcessValueInBinary[#temp16IndexMTP].V;
	                                                #ProcessInBin[#temp16IndexBinary].VQC := #ProcessValueInBinary[#temp16IndexMTP].VQC;
	                                                #ProcessInBin[#temp16IndexBinary].VState0 := #ProcessValueInBinary[#temp16IndexMTP].VState0;
	                                                #ProcessInBin[#temp16IndexBinary].VState1 := #ProcessValueInBinary[#temp16IndexMTP].VState1;
	                                            END_IF;
	                                            #temp16IndexBinary := #temp16IndexBinary + 1;
	                                        END_REGION
	                                    #TYPE_STRING:
	                                        REGION String
	                                            //Bit Masking funtionality for calculate the used String parameter and Position of the Parameter name in the HMI Text List 
	                                            #ProcessInValueType.IndexString := #ProcessInValueType.IndexString OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionProcessIn));
	                                            #ProcessInValueType.NameIndexString := #ProcessInValueType.NameIndexString OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #PROCESS_VALUES_IN_MIN) AND (#temp16IndexIO <= #PROCESS_VALUES_IN_STRING_MAX)) THEN
	                                                //WinCC Parameter View Faceplate logic
	                                                #ProcessInString[#temp16IndexString].WQC := #ProcessValueInString[#temp16IndexMTP].WQC;
	                                                #ProcessInString[#temp16IndexString].V := #ProcessValueInString[#temp16IndexMTP].V;
	                                                #ProcessInString[#temp16IndexString].VQC := #ProcessValueInString[#temp16IndexMTP].VQC;
	                                            END_IF;
	                                            #temp16IndexString := #temp16IndexString + 1;
	                                        END_REGION
	                                END_CASE;
	                            END_IF;
	                        END_IF;
	                        #temp16IndexOfDefinitionProcessIn := #temp16IndexOfDefinitionProcessIn + 1;
	                    END_IF;
	                END_FOR;
	            END_IF;
	        END_IF;
	    END_REGION
	    
	    REGION Process Out Values
	        
	        REGION Get Start and End index details of the Current /Prepared procedure
	            //Current/Prepared procedure selection for parameter display in the faceplate
	            //#stat32PrecedureProcessOutMap := -1;
	            IF NOT (#ProcessOutValueType.ProcedureReqCurInd) THEN
	                #stat32PrecedureProcessOutMap := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].ProcedureProcessOutMap[0];
	            ELSIF (#ProcessOutValueType.ProcedureReqCurInd) THEN
	                #stat32PrecedureProcessOutMap := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].ProcedureProcessOutMap[0];
	            END_IF;
	        END_REGION
	        //Initialize the used variable values          
	        #temp32TempDword1 := 16#1;
	        #temp16IndexAnalog := 16#0;
	        #temp16IndexDigital := 16#0;
	        #temp16IndexBinary := 16#0;
	        #temp16IndexString := 16#0;
	        //Initialize the Process Out Value index and Name index while changing of Procedure and changing of screen selection b/w Prepared and Current procedure
	        IF ((#statLasProcedureCur <> #ProcedureCur) OR (#statLasProcedureReq <> #ProcedureReq) OR (#StatLastProceselProcessOut <> #ProcessOutValueType.ProcedureReqCurInd)
	            OR (((#ProcedureCur = 16#0) AND NOT #ProcessOutValueType.ProcedureReqCurInd) OR ((#ProcedureReq = 16#0) AND #ProcessOutValueType.ProcedureReqCurInd))) THEN
	            #ProcessOutValueType.IndexAnalog := 16#0;
	            #ProcessOutValueType.NameIndexAnalog := 16#0;
	            #ProcessOutValueType.IndexDigital := 16#0;
	            #ProcessOutValueType.NameIndexDigital := 16#0;
	            #ProcessOutValueType.IndexBinary := 16#0;
	            #ProcessOutValueType.NameIndexBinary := 16#0;
	            #ProcessOutValueType.IndexString := 16#0;
	            #ProcessOutValueType.NameIndexString := 16#0;
	        END_IF;
	        //Used/Mapped parameter count with individual parameter type will written from the Tool
	        #statTotalProcessOutValues := #MAPPED_PROCESS_OUT_ANALOG + #MAPPED_PROCESS_OUT_DIGITAL + #MAPPED_PROCESS_OUT_BINARY + #MAPPED_PROCESS_OUT_STRING - 1;
	        IF (((#ProcedureCur <> 16#0) AND NOT #ProcessOutValueType.ProcedureReqCurInd) OR ((#ProcedureReq <> 16#0) AND #ProcessOutValueType.ProcedureReqCurInd)) THEN
	            IF ((#statTotalProcessOutValues >= 0) AND (#statTotalProcessOutValues <= #PROCESS_VALUES_OUT_MAX)) THEN
	                #temp16IndexOfDefinitionProcessOut := 16#0;
	                FOR #temp16IndexOfDefinition := #PROCESS_VALUES_OUT_MIN TO #statTotalProcessOutValues BY 1 DO
	                    #temp16ParameterCMAddress := BYTE_TO_INT(#tempSetup.processValueOutData.definition[#temp16IndexOfDefinition].controlModule);
	                    #temp16ParameterType := #tempSetup.processValueOutData.definition[#temp16IndexOfDefinition].type;
	                    #temp16IndexMTP := #tempSetup.processValueOutData.definition[#temp16IndexOfDefinition].indexMTP;
	                    #tempUsed := #tempSetup.processValueOutData.used;
	                    // Find the procedure information assigned with the processOut values
	                    IF (((#stat32PrecedureProcessOutMap AND SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition))) <> 0) = TRUE) THEN
	                        #temp16IndexIO := #tempSetup.processValueOutData.definition[#temp16IndexOfDefinition].indexIO;
	                        
	                        IF (#temp16ParameterCMAddress <> 255) AND (#temp16ParameterCMAddress >= #NUMBER_OF_CONTROLMODULES_MIN) AND (#temp16ParameterCMAddress <= #NUMBER_OF_CONTROLMODULES)
	                            AND (#temp16ParameterType >= #TYPE_NONE) AND (#temp16ParameterType <= #TYPE_STRING) THEN
	                            #temp16TempInt1 := #temp16ParameterCMAddress / 32;    //DWORD - Adress
	                            #temp16TempInt2 := #temp16ParameterCMAddress MOD 32;  //Bit - Adress
	                            //If parameter is forced (FRC) --> Parameter is used
	                            IF (((#tempUsed[#temp16TempInt1] AND SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16TempInt2))) <> 0) = TRUE) THEN
	                                CASE #temp16ParameterType OF
	                                    #TYPE_ANALOG:
	                                        REGION Analog
	                                            //Bit Masking funtionality for calculate the used Analog parameter and Position of the Parameter name in the HMI Text List                                         
	                                            #ProcessOutValueType.IndexAnalog := #ProcessOutValueType.IndexAnalog OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionProcessOut));
	                                            #ProcessOutValueType.NameIndexAnalog := #ProcessOutValueType.NameIndexAnalog OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #PROCESS_VALUES_OUT_MIN) AND (#temp16IndexIO <= #PROCESS_VALUES_OUT_ANALOG_MAX)) THEN
	                                                //WinCC Parameter View Faceplate logic
	                                                #ProcessOutAna[#temp16IndexAnalog].WQC := #ProcessValueOutAnalog[#temp16IndexMTP].WQC;
	                                                #ProcessOutAna[#temp16IndexAnalog].V := #ProcessValueOutAnalog[#temp16IndexMTP].V;
	                                                #ProcessOutAna[#temp16IndexAnalog].VSclMin := #ProcessValueOutAnalog[#temp16IndexMTP].VSclMin;
	                                                #ProcessOutAna[#temp16IndexAnalog].VSclMax := #ProcessValueOutAnalog[#temp16IndexMTP].VSclMax;
	                                                #ProcessOutAna[#temp16IndexAnalog].VUnit := #ProcessValueOutAnalog[#temp16IndexMTP].VUnit;
	                                            END_IF;
	                                            #temp16IndexAnalog := #temp16IndexAnalog + 1;
	                                        END_REGION
	                                    #TYPE_DIGITAL:
	                                        REGION Digital
	                                            //Bit Masking funtionality for calculate the used Digital parameter and Position of the Parameter name in the HMI Text List                                         
	                                            #ProcessOutValueType.IndexDigital := #ProcessOutValueType.IndexDigital OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionProcessOut));
	                                            #ProcessOutValueType.NameIndexDigital := #ProcessOutValueType.NameIndexDigital OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #PROCESS_VALUES_OUT_MIN) AND (#temp16IndexIO <= #PROCESS_VALUES_OUT_DIGITAL_MAX)) THEN
	                                                //WinCC Parameter View Faceplate logic
	                                                #ProcessOutDint[#temp16IndexDigital].WQC := #ProcessValueOutDigital[#temp16IndexMTP].WQC;
	                                                #ProcessOutDint[#temp16IndexDigital].V := #ProcessValueOutDigital[#temp16IndexMTP].V;
	                                                #ProcessOutDint[#temp16IndexDigital].VSclMin := #ProcessValueOutDigital[#temp16IndexMTP].VSclMin;
	                                                #ProcessOutDint[#temp16IndexDigital].VSclMax := #ProcessValueOutDigital[#temp16IndexMTP].VSclMax;
	                                                #ProcessOutDint[#temp16IndexDigital].VUnit := #ProcessValueOutDigital[#temp16IndexMTP].VUnit;
	                                            END_IF;
	                                            #temp16IndexDigital := #temp16IndexDigital + 1;
	                                        END_REGION
	                                    #TYPE_BINARY:
	                                        REGION Binary
	                                            //Bit Masking funtionality for calculate the used Binary parameter and Position of the Parameter name in the HMI Text List 
	                                            #ProcessOutValueType.IndexBinary := #ProcessOutValueType.IndexBinary OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionProcessOut));
	                                            #ProcessOutValueType.NameIndexBinary := #ProcessOutValueType.NameIndexBinary OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #PROCESS_VALUES_OUT_MIN) AND (#temp16IndexIO <= #PROCESS_VALUES_OUT_BINARY_MAX)) THEN
	                                                //WinCC Parameter View Faceplate logic
	                                                #ProcessOutBin[#temp16IndexBinary].WQC := #ProcessValueOutBinary[#temp16IndexMTP].WQC;
	                                                #ProcessOutBin[#temp16IndexBinary].V := #ProcessValueOutBinary[#temp16IndexMTP].V;
	                                                #ProcessOutBin[#temp16IndexBinary].VState0 := #ProcessValueOutBinary[#temp16IndexMTP].VState0;
	                                                #ProcessOutBin[#temp16IndexBinary].VState1 := #ProcessValueOutBinary[#temp16IndexMTP].VState1;
	                                            END_IF;
	                                            #temp16IndexBinary := #temp16IndexBinary + 1;
	                                        END_REGION
	                                    #TYPE_STRING:
	                                        REGION String
	                                            //Bit Masking funtionality for calculate the used String parameter and Position of the Parameter name in the HMI Text List 
	                                            #ProcessOutValueType.IndexString := #ProcessOutValueType.IndexString OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionProcessOut));
	                                            #ProcessOutValueType.NameIndexString := #ProcessOutValueType.NameIndexString OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #PROCESS_VALUES_OUT_MIN) AND (#temp16IndexIO <= #PROCESS_VALUES_OUT_STRING_MAX)) THEN
	                                                //WinCC Parameter View Faceplate logic
	                                                #ProcessOutString[#temp16IndexString].WQC := #ProcessValueOutString[#temp16IndexMTP].WQC;
	                                                #ProcessOutString[#temp16IndexString].Text := #ProcessValueOutString[#temp16IndexMTP].Text;
	                                            END_IF;
	                                            #temp16IndexString := #temp16IndexString + 1;
	                                        END_REGION
	                                END_CASE;
	                            END_IF;
	                        END_IF;
	                        #temp16IndexOfDefinitionProcessOut := #temp16IndexOfDefinitionProcessOut + 1;
	                    END_IF;
	                END_FOR;
	            END_IF;
	        END_IF;
	    END_REGION
	    
	    REGION Report Values
	        
	        REGION Get Start and End index details of the Current /Prepared procedure
	            //Current/Prepared procedure selection for parameter display in the faceplate
	           // #stat32PrecedureReportMap := -1;
	            IF NOT (#ReportValueType.ProcedureReqCurInd) THEN
	                #stat32PrecedureReportMap := #tempSetup."procedure"."procedure"[#stat16ProceCurIndex].ProcedureReportMap[0];
	            ELSIF (#ReportValueType.ProcedureReqCurInd) THEN
	                #stat32PrecedureReportMap := #tempSetup."procedure"."procedure"[#stat16ProceReqIndex].ProcedureReportMap[0];
	            END_IF;
	        END_REGION
	        //Initialize the used variable values        
	        #temp32TempDword1 := 16#1;
	        #temp16IndexAnalog := 16#0;
	        #temp16IndexDigital := 16#0;
	        #temp16IndexBinary := 16#0;
	        #temp16IndexString := 16#0;
	        //Initialize the Process Out Value index and Name index while changing of Procedure and changing of screen selection b/w Prepared and Current procedure
	        IF ((#statLasProcedureCur <> #ProcedureCur) OR (#statLasProcedureReq <> #ProcedureReq) OR (#StatLastProceselReport <> #ReportValueType.ProcedureReqCurInd)
	            OR (((#ProcedureCur = 16#0) AND NOT #ReportValueType.ProcedureReqCurInd) OR ((#ProcedureReq = 16#0) AND #ReportValueType.ProcedureReqCurInd))) THEN
	            #ReportValueType.IndexAnalog := 16#0;
	            #ReportValueType.NameIndexAnalog := 16#0;
	            #ReportValueType.IndexDigital := 16#0;
	            #ReportValueType.NameIndexDigital := 16#0;
	            #ReportValueType.IndexBinary := 16#0;
	            #ReportValueType.NameIndexBinary := 16#0;
	            #ReportValueType.IndexString := 16#0;
	            #ReportValueType.NameIndexString := 16#0;
	        END_IF;
	        //Used/Mapped parameter count with individual parameter type will written from the Tool
	        #statTotalReportValues := #MAPPED_REPORT_ANALOG + #MAPPED_REPORT_DIGITAL + #MAPPED_REPORT_BINARY + #MAPPED_REPORT_STRING - 1;
	        IF (((#ProcedureCur <> 16#0) AND NOT #ReportValueType.ProcedureReqCurInd) OR ((#ProcedureReq <> 16#0) AND #ReportValueType.ProcedureReqCurInd)) THEN
	            IF ((#statTotalReportValues >= 0) AND (#statTotalReportValues <= #REPORT_VALUES_MAX)) THEN
	                #temp16IndexOfDefinitionReport := 16#0;
	                FOR #temp16IndexOfDefinition := #REPORT_VALUES_MIN TO #statTotalReportValues BY 1 DO
	                    #temp16ParameterCMAddress := BYTE_TO_INT(#tempSetup.reportValueData.definition[#temp16IndexOfDefinition].controlModule);
	                    #temp16ParameterType := #tempSetup.reportValueData.definition[#temp16IndexOfDefinition].type;
	                    #temp16IndexMTP := #tempSetup.reportValueData.definition[#temp16IndexOfDefinition].indexMTP;
	                    #tempUsed := #tempSetup.reportValueData.used;
	                    // Find the procedure information assigned with the report values
	                    IF (((#stat32PrecedureReportMap AND SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition))) <> 0) = TRUE) THEN
	                        #temp16IndexIO := #tempSetup.reportValueData.definition[#temp16IndexOfDefinition].indexIO;
	                        
	                        IF (#temp16ParameterCMAddress <> 255) AND (#temp16ParameterCMAddress >= #NUMBER_OF_CONTROLMODULES_MIN) AND (#temp16ParameterCMAddress <= #NUMBER_OF_CONTROLMODULES)
	                            AND (#temp16ParameterType >= #TYPE_NONE) AND (#temp16ParameterType <= #TYPE_STRING) THEN
	                            #temp16TempInt1 := #temp16ParameterCMAddress / 32;    //DWORD - Adress
	                            #temp16TempInt2 := #temp16ParameterCMAddress MOD 32;  //Bit - Adress
	                            //If parameter is forced (FRC) --> Parameter is used
	                            IF (((#tempUsed[#temp16TempInt1] AND SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16TempInt2))) <> 0) = TRUE) THEN
	                                CASE #temp16ParameterType OF
	                                    #TYPE_ANALOG:
	                                        REGION Analog
	                                            //Bit Masking funtionality for calculate the used Analog parameter and Position of the Parameter name in the HMI Text List 
	                                            #ReportValueType.IndexAnalog := #ReportValueType.IndexAnalog OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionReport));
	                                            #ReportValueType.NameIndexAnalog := #ReportValueType.NameIndexAnalog OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #REPORT_VALUES_MIN) AND (#temp16IndexIO <= #REPORT_VALUES_ANALOG_MAX)) THEN
	                                                //WinCC Parameter View Faceplate logic
	                                                #ReportAna[#temp16IndexAnalog].WQC := #ReportValueAnalog[#temp16IndexMTP].WQC;
	                                                #ReportAna[#temp16IndexAnalog].V := #ReportValueAnalog[#temp16IndexMTP].V;
	                                                #ReportAna[#temp16IndexAnalog].VSclMin := #ReportValueAnalog[#temp16IndexMTP].VSclMin;
	                                                #ReportAna[#temp16IndexAnalog].VSclMax := #ReportValueAnalog[#temp16IndexMTP].VSclMax;
	                                                #ReportAna[#temp16IndexAnalog].VUnit := #ReportValueAnalog[#temp16IndexMTP].VUnit;
	                                                #ReportAna[#temp16IndexAnalog].MissedValue := #ReportValueAnalog[#temp16IndexMTP].MissedValue;
	                                            END_IF;
	                                            #temp16IndexAnalog := #temp16IndexAnalog + 1;
	                                        END_REGION
	                                    #TYPE_DIGITAL:
	                                        REGION Digital
	                                            //Bit Masking funtionality for calculate the used Digital parameter and Position of the Parameter name in the HMI Text List 
	                                            #ReportValueType.IndexDigital := #ReportValueType.IndexDigital OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionReport));
	                                            #ReportValueType.NameIndexDigital := #ReportValueType.NameIndexDigital OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #REPORT_VALUES_MIN) AND (#temp16IndexIO <= #REPORT_VALUES_DIGITAL_MAX)) THEN
	                                                //WinCC Parameter View Faceplate logic
	                                                #ReportDint[#temp16IndexDigital].WQC := #ReportValueDigital[#temp16IndexMTP].WQC;
	                                                #ReportDint[#temp16IndexDigital].V := #ReportValueDigital[#temp16IndexMTP].V;
	                                                #ReportDint[#temp16IndexDigital].VSclMin := #ReportValueDigital[#temp16IndexMTP].VSclMin;
	                                                #ReportDint[#temp16IndexDigital].VSclMax := #ReportValueDigital[#temp16IndexMTP].VSclMax;
	                                                #ReportDint[#temp16IndexDigital].VUnit := #ReportValueDigital[#temp16IndexMTP].VUnit;
	                                                #ReportDint[#temp16IndexDigital].MissedValue := #ReportValueDigital[#temp16IndexMTP].MissedValue;
	                                            END_IF;
	                                            #temp16IndexDigital := #temp16IndexDigital + 1;
	                                        END_REGION
	                                    #TYPE_BINARY:
	                                        REGION Binary
	                                            //Bit Masking funtionality for calculate the used Binary parameter and Position of the Parameter name in the HMI Text List 
	                                            #ReportValueType.IndexBinary := #ReportValueType.IndexBinary OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionReport));
	                                            #ReportValueType.NameIndexBinary := #ReportValueType.NameIndexBinary OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #REPORT_VALUES_MIN) AND (#temp16IndexIO <= #REPORT_VALUES_BINARY_MAX)) THEN
	                                                //WinCC Parameter View Faceplate logic
	                                                #ReportBin[#temp16IndexBinary].WQC := #ReportValueBinary[#temp16IndexMTP].WQC;
	                                                #ReportBin[#temp16IndexBinary].V := #ReportValueBinary[#temp16IndexMTP].V;
	                                                #ReportBin[#temp16IndexBinary].VState0 := #ReportValueBinary[#temp16IndexMTP].VState0;
	                                                #ReportBin[#temp16IndexBinary].VState1 := #ReportValueBinary[#temp16IndexMTP].VState1;
	                                                #ReportBin[#temp16IndexBinary].MissedValue := #ReportValueBinary[#temp16IndexMTP].MissedValue;
	                                            END_IF;
	                                            #temp16IndexBinary := #temp16IndexBinary + 1;
	                                        END_REGION
	                                    #TYPE_STRING:
	                                        REGION String
	                                            //Bit Masking funtionality for calculate the used String parameter and Position of the Parameter name in the HMI Text List 
	                                            #ReportValueType.IndexString := #ReportValueType.IndexString OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinitionReport));
	                                            #ReportValueType.NameIndexString := #ReportValueType.NameIndexString OR SHL(IN := #temp32TempDword1, N := INT_TO_UINT(#temp16IndexOfDefinition));
	                                            IF ((#temp16IndexIO >= #REPORT_VALUES_MIN) AND (#temp16IndexIO <= #REPORT_VALUES_STRING_MAX)) THEN
	                                                
	                                                //WinCC Parameter View Faceplate logic
	                                                #ReportString[#temp16IndexString].WQC := #ReportValueString[#temp16IndexMTP].WQC;
	                                                #ReportString[#temp16IndexString].Text := #ReportValueString[#temp16IndexMTP].Text;
	                                                #ReportString[#temp16IndexString].MissedValue := #ReportValueString[#temp16IndexMTP].MissedValue;
	                                            END_IF;
	                                            #temp16IndexString := #temp16IndexString + 1;
	                                        END_REGION
	                                END_CASE;
	                            END_IF;
	                        END_IF;
	                        #temp16IndexOfDefinitionReport := #temp16IndexOfDefinitionReport + 1;
	                    END_IF;
	                END_FOR;
	            END_IF;
	        END_IF;
	    END_REGION  
	    
	    //Move last valid value 
	    #statLasProcedureCur := #ProcedureCur;
	    #statLasProcedureReq := #ProcedureReq;
	    #statLastReqProcedSelected := #ProcedureParaType.ProcedureReqCurInd;
	    #StatLastProceselProcessIn := #ProcessInValueType.ProcedureReqCurInd;
	    #StatLastProceselProcessOut := #ProcessOutValueType.ProcedureReqCurInd;
	    #StatLastProceselReport := #ReportValueType.ProcedureReqCurInd;
	    
	    
	    
END_FUNCTION_BLOCK

