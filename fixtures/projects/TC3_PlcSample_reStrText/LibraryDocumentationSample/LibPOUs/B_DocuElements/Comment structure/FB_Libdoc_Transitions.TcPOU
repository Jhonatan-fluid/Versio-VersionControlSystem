  <POU Name="FB_Libdoc_Transitions" Id="{5e99f688-32f3-4396-8135-c8945663cc9e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
A transition marker is a horizontal line 
of 4 or more repeated punctuation characters. 

------------ 

A transition should not begin or end a section or document,
nor should two transitions be immediately adjacent.
*)

FUNCTION_BLOCK FB_Libdoc_Transitions
VAR_INPUT
    nVarA : INT;
    nVarB : INT;
END_VAR
VAR_OUTPUT
    nSum : INT;
END_VAR
VAR
END_VAR
]]></Declaration>
