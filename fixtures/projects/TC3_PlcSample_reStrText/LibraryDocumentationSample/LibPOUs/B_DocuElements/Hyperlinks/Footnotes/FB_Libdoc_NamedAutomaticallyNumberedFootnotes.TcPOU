    <Declaration><![CDATA[(*

**Autonumbered labeled footnotes**

They may be assigned 'autonumber labels' - for instance, [#first]_ and [#second]_. 

--------

.. [#first] a.k.a. first_ 

.. [#second] a.k.a. second_
*)

FUNCTION_BLOCK FB_Libdoc_NamedAutomaticallyNumberedFootnotes
VAR_INPUT
    nVarA : INT;
    nVarB : INT;
END_VAR
VAR_OUTPUT
    nSum : INT;
END_VAR
VAR
END_VAR
]]></Declaration>
